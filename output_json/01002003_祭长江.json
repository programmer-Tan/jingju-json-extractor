  "scenes": [
    {
      "scene_id": 1,
      "title": "江边祭奠",
      "characters_on_stage": [
        "孙尚香",
        "四太监",
        "四御林军",
        "二宫女",
        "四水旗"
      ],
      "segments": [
        {
          "type": "dialogue",
          "speaker": "孙尚香",
          "mode": "内白",
          "content": "摆驾。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四太监、四御林军、二宫女、孙尚香同上。"
        },
        {
          "type": "lyric",
          "speaker": "孙尚香",
          "mode": "二黄慢板",
          "content": "曾记得当年来辞君，棒打鸳鸯两离分。叹皇叔遭不幸龙归海境，不由奴日夜里珠泪淋淋。内侍臣摆驾江边来进，清风一去未亡人。"
        },
        {
          "type": "dialogue",
          "speaker": "孙尚香",
          "mode": "白",
          "content": "祭礼摆下，着衣更换，两厢退下。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四太监、四御林军同下。"
        },
        {
          "type": "dialogue",
          "speaker": "孙尚香",
          "mode": "念",
          "content": "设祭长江岸，举目望西川。梦魂何日见，"
        },
        {
          "type": "dialogue",
          "speaker": "孙尚香",
          "mode": "叫头",
          "content": "夫君，先主！"
        },
        {
          "type": "dialogue",
          "speaker": "孙尚香",
          "mode": "念",
          "content": "空自珠泪涟。"
        },
        {
          "type": "lyric",
          "speaker": "孙尚香",
          "mode": "二黄导板",
          "content": "孙尚香在江边心中酸疼，"
        },
        {
          "type": "dialogue",
          "speaker": "孙尚香",
          "mode": "三叫头",
          "content": "夫君，先主！啊呀！"
        },
        {
          "type": "lyric",
          "speaker": "孙尚香",
          "mode": "回龙",
          "content": "尊一声汉皇叔细听分明："
        },
        {
          "type": "lyric",
          "speaker": "孙尚香",
          "mode": "反二黄慢板",
          "content": "好夫妻恶姻缘悲哀告禀，凭空中便见听一点心诚。可叹你大英雄出身被困，可叹你结桃园义共死生；可叹你破黄巾声名未重，可叹你虎牢关方显成名；可叹你舍徐庶卧龙三请，可叹你水镜庄得一贤伦；可叹你当阳道夏口夜奔，可叹你全仗着诸葛先生；可叹你跳檀溪险些丧命，我的夫吓！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "下锣。"
        },
        {
          "type": "lyric",
          "speaker": "孙尚香",
          "mode": "反二黄慢板",
          "content": "可叹你入虎穴东吴招亲。为报仇在猇亭遇见陆逊，又谁知那小贼果有才能。你不该七百里连营扎定，烧死了众儿郎百万雄兵。人报道你在白帝城丧命，那时节得凶信魂魄离身。实指望破奸曹狼烟扫尽，又谁知天不助命归天庭。我本当得此信寻个自尽，又恐怕我母亲不放离分。叹人生在世间如同照镜，夫已死我岂肯独自贪生。因此上备祭礼江边来进，但愿你魂灵儿早归天庭。"
        },
        {
          "type": "dialogue",
          "speaker": "孙尚香",
          "mode": "白",
          "content": "且住。想皇叔一死，我在东吴苦守无益。不免拜谢母后养育之恩，投江自尽了吧。"
        },
        {
          "type": "lyric",
          "speaker": "孙尚香",
          "mode": "反二黄摇板",
          "content": "江水滔滔波浪滚，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四水旗同上。"
        },
        {
          "type": "lyric",
          "speaker": "孙尚香",
          "mode": "反二黄摇板",
          "content": "尚香拜别养育恩。辞别了老母后寻自尽，不如一死见夫君。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "孙尚香、四水旗同下。"
        }
      ],
      "stats": {
        "line_count": 42,
        "lyric_ratio": 0.76,
        "stage_direction_count": 5
      }
    },
    {
      "scene_id": 2,
      "title": "受封枭姬",
      "characters_on_stage": [
        "孙尚香",
        "龙王",
        "四水旗"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "孙尚香上，四水旗引龙王同上。"
        },
        {
          "type": "dialogue",
          "speaker": "龙王",
          "mode": "白",
          "content": "玉旨下，跪。"
        },
        {
          "type": "dialogue",
          "speaker": "孙尚香",
          "mode": "白",
          "content": "在。"
        },
        {
          "type": "dialogue",
          "speaker": "龙王",
          "mode": "白",
          "content": "听宣读。诏曰：孙尚香为夫投江，尽节一死，玉帝垂怜，封为枭姬娘娘。旨意读罢，望诏谢恩。"
        },
        {
          "type": "dialogue",
          "speaker": "孙尚香",
          "mode": "白",
          "content": "圣寿无疆。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "龙王下。孙尚香换衣。"
        },
        {
          "type": "dialogue",
          "speaker": "孙尚香",
          "mode": "白",
          "content": "众神将，保我朝见玉帝去者。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "孙尚香、四水旗同下。"
        }
      ],
      "stats": {
        "line_count": 5,
        "lyric_ratio": 0,
        "stage_direction_count": 3
      }
    }
  ]
