    {
      "scene_id": 7,
      "title": "姜维归汉",
      "characters_on_stage": [
        "四红龙套",
        "车夫",
        "诸葛亮",
        "魏延",
        "马岱",
        "关兴",
        "张苞",
        "姜维"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四红龙套同上，车夫推诸葛亮同上。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "四下安排天罗网，姜维小儿无躲藏。四轮辇暂停在山岗上，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "车夫下。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "准备弩弓射虎狼。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "魏延、马岱、关兴、张苞同上。姜维上。"
        },
        {
          "type": "lyric",
          "speaker": "姜维",
          "mode": "西皮摇板",
          "content": "四面俱是蜀兵将，好似铁壁与铜墙。勒住丝缰用目望，"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "啊，"
        },
        {
          "type": "lyric",
          "speaker": "姜维",
          "mode": "西皮摇板",
          "content": "四轮车辇在山岗。认得他是诸葛亮，不由豪杰怒满膛。手使金枪朝上闯，"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "大胆！"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "姜维小儿休逞强！要保保个真明主，为什么扶保篡位王？"
        },
        {
          "type": "lyric",
          "speaker": "魏延",
          "mode": "西皮摇板",
          "content": "姜维休要逞刚强，"
        },
        {
          "type": "lyric",
          "speaker": "马岱",
          "mode": "西皮摇板",
          "content": "刚强怎比楚霸王。"
        },
        {
          "type": "lyric",
          "speaker": "关兴",
          "mode": "西皮摇板",
          "content": "猛虎自有猎户挡，"
        },
        {
          "type": "lyric",
          "speaker": "张苞",
          "mode": "西皮摇板",
          "content": "看你归降不归降？"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "哎吓！"
        },
        {
          "type": "lyric",
          "speaker": "姜维",
          "mode": "西皮摇板",
          "content": "豪杰入了天罗网，杀前退后无躲藏。本当战死沙场上，冀城县还有我的老萱堂。"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "也罢，"
        },
        {
          "type": "lyric",
          "speaker": "姜维",
          "mode": "西皮摇板",
          "content": "没奈何下马来归降，含羞带愧跪道旁。"
        },
        {
          "type": "dialogue",
          "speaker": "魏延、马岱、关兴、张苞",
          "mode": "白",
          "content": "姜维归降！"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮导板",
          "content": "八卦阴阳如反掌，"
        },
        {
          "type": "dialogue",
          "speaker": "魏延、马岱、关兴、张苞",
          "mode": "白",
          "content": "姜维归降！"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "笑",
          "content": "哈哈哈！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "魏延、马岱、关兴、张苞同下。诸葛亮下山。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮慢板",
          "content": "他含羞带愧跪立在道旁。我不爱将军你的韬略广，爱将军是一个行孝的儿郎。"
        },
        {
          "type": "lyric",
          "speaker": "姜维",
          "mode": "西皮慢板",
          "content": "久闻丞相韬略广，某早有此心归顺汉王。望丞相开大恩将某放，"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "却是为何？"
        },
        {
          "type": "lyric",
          "speaker": "姜维",
          "mode": "西皮慢板",
          "content": "冀城县还有我的老萱堂。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮原板",
          "content": "我早已安排令堂母，"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "谢丞相。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮原板",
          "content": "劝将军何必挂心旁。一出祁山收此将，心中得意喜洋洋。怕只怕五丈原难得闯，兵权大印托付他承当。请将军同把车辇上，"
        },
        {
          "type": "lyric",
          "speaker": "姜维",
          "mode": "西皮摇板",
          "content": "姜维撩袍跪道旁。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "酒宴摆在中军帐，我与将军谈论兵机，叙叙衷肠。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮、姜维同下。"
        }
      ],
