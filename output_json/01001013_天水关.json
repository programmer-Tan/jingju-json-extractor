          "mode": "西皮摇板",
          "content": "战场杀败一员将，"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "都督！"
        },
        {
          "type": "lyric",
          "speaker": "姜维",
          "mode": "西皮摇板",
          "content": "快快开城作商量。"
