        {
          "type": "dialogue",
          "speaker": "赵云",
          "mode": "白",
          "content": "参见丞相。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "老将军回来了。"
        },
        {
          "type": "dialogue",
          "speaker": "赵云",
          "mode": "白",
          "content": "回来了。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "胜败如何？"
        },
        {
          "type": "dialogue",
          "speaker": "赵云",
          "mode": "白",
          "content": "头一阵刀劈韩德父子五人落马。第二阵遇见红脸大汉，被他杀得大败。不是关兴搭救，险遭不测。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "可曾问敌将名姓？"
        },
        {
          "type": "dialogue",
          "speaker": "赵云",
          "mode": "白",
          "content": "姓姜名维，字伯约。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "姜维……老将军后帐歇息。"
        },
        {
          "type": "dialogue",
          "speaker": "赵云",
          "mode": "白",
          "content": "遵命。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵云下。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "来，传众将进帐。"
        },
        {
          "type": "dialogue",
          "speaker": "四红龙套",
          "mode": "白",
          "content": "众将进帐。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "魏延、马岱、关兴、张苞同上。"
        },
        {
          "type": "dialogue",
          "speaker": "魏延、马岱、关兴、张苞",
          "mode": "白",
          "content": "来也！"
        },
        {
          "type": "dialogue",
          "speaker": "魏延、马岱、关兴、张苞",
          "mode": "念",
          "content": "豪杰表名姓，三国就有名。"
        },
        {
          "type": "dialogue",
          "speaker": "魏延、马岱、关兴、张苞",
          "mode": "白",
          "content": "参见丞相。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "站立两厢，听山人令下。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮导板",
          "content": "令出貔貅神鬼寒，"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮流水板",
          "content": "征北将军名魏延：自从长沙得降汉，跟随山人二十年。南征北战功劳显，才得我营先行官。今日战比不得往日战，比不得当年大战在渭南。等到黄昏用战饭，要出兵来去骂关。假扮姜维关口站，口口声声出反言。"
        },
        {
          "type": "dialogue",
          "speaker": "魏延",
          "mode": "白",
          "content": "得令。"
        },
        {
          "type": "lyric",
          "speaker": "魏延",
          "mode": "西皮摇板",
          "content": "丞相将令往下传，假扮姜维去骂关。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "魏延下。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮快板",
          "content": "回头便把马岱唤，虚情假意战魏延。勒马再把姜维战，引他兵败凤凰山。"
        },
        {
          "type": "dialogue",
          "speaker": "马岱",
          "mode": "白",
          "content": "得令。"
        },
        {
          "type": "lyric",
          "speaker": "马岱",
          "mode": "西皮摇板",
          "content": "丞相将令往下传，假意兵败凤凰山。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "马岱下。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮快板",
          "content": "关兴、张苞接令箭，大下江东好威严。你父是英雄儿好汉，自古道英雄出少年。二马连环把姜维战，杀得他四路无门跪马前。"
        },
        {
          "type": "dialogue",
          "speaker": "关兴",
          "mode": "白",
          "content": "得令。"
        },
        {
          "type": "lyric",
          "speaker": "关兴",
          "mode": "西皮摇板",
          "content": "丞相将令往下传，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "关兴下。"
        },
        {
          "type": "lyric",
          "speaker": "张苞",
          "mode": "西皮摇板",
          "content": "好似猛虎下高山。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "张苞下。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "人来看过四轮辇，"
