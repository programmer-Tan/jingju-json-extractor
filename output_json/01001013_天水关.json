  "scenes": [
    {
      "scene_id": 1,
      "title": "金殿陈情",
      "characters_on_stage": [
        "刘禅",
        "内侍",
        "诸葛亮",
        "四太监"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四太监同上，刘禅上"
        },
        {
          "type": "dialogue",
          "speaker": "刘禅",
          "mode": "引子",
          "content": "凤阁龙楼，万古千秋"
        },
        {
          "type": "dialogue",
          "speaker": "刘禅",
          "mode": "念",
          "content": "先皇晏驾白帝城，满朝文武不安宁。多亏相父来扶助，孤皇才得坐龙庭。"
        },
        {
          "type": "dialogue",
          "speaker": "刘禅",
          "mode": "白",
          "content": "孤，刘禅。登基以来，风调雨顺，国泰民安。今当早朝。内侍，"
        },
        {
          "type": "dialogue",
          "speaker": "内侍",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "刘禅",
          "mode": "白",
          "content": "闪开龙门。"
        },
        {
          "type": "dialogue",
          "speaker": "内侍",
          "mode": "白",
          "content": "领旨。闪开龙门。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮内白：唔咳。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮上。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "引子",
          "content": "代理山河，掌丝纶，运筹帷幄。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "臣诸葛亮见驾，陛下千岁。"
        },
        {
          "type": "dialogue",
          "speaker": "刘禅",
          "mode": "白",
          "content": "相父平身。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "千千岁。"
        },
        {
          "type": "dialogue",
          "speaker": "刘禅",
          "mode": "白",
          "content": "赐坐。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "谢坐。"
        },
        {
          "type": "dialogue",
          "speaker": "刘禅",
          "mode": "白",
          "content": "相父手捧何物？"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "臣有出师表章，我主龙目一览。"
        },
        {
          "type": "dialogue",
          "speaker": "刘禅",
          "mode": "白",
          "content": "呈上来。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "内侍接上。"
        },
        {
          "type": "dialogue",
          "speaker": "刘禅",
          "mode": "白",
          "content": "哦，呵呀！才得干戈宁静，又要出兵。叫孤心中难舍。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "陛下！"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄慢板",
          "content": "先帝爷白帝城龙归海境，传口诏命老臣常挂在心。命老臣保陛下江山重整，命老臣把孙曹定要扫平。臣上本并非是别的议论，望我主准臣本臣要发兵。"
        },
        {
          "type": "lyric",
          "speaker": "刘禅",
          "mode": "二黄原板",
          "content": "老相父奏的是治国经纶，一桩桩一件件孤皇在心。你前番剿孟获狼烟扫尽，年迈人理应该乐享太平。待孤皇在金殿传下御旨，文武臣摆酒宴长亭饯行。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄原板",
          "content": "食君禄报皇恩当把忠尽，臣敢劳我主爷长亭饯行。"
        },
        {
          "type": "lyric",
          "speaker": "刘禅",
          "mode": "二黄原板",
          "content": "内侍臣摆御驾后宫来进，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四太监同下。"
        },
        {
          "type": "lyric",
          "speaker": "刘禅",
          "mode": "二黄原板",
          "content": "明日里待孤皇长亭饯行。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "刘禅下，诸葛亮下。"
        }
      ],
      "stats": {
        "line_count": 38,
        "lyric_ratio": 0.42,
        "stage_direction_count": 6
      }
    },
    {
      "scene_id": 2,
      "title": "长亭饯行",
      "characters_on_stage": [
        "魏延",
        "马岱",
        "关兴",
        "张苞",
        "四白龙套",
        "赵云",
        "四太监",
        "四大铠",
        "诸葛亮",
        "刘禅",
        "车夫"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "魏延、马岱、关兴、张苞同上。"
        },
        {
          "type": "dialogue",
          "speaker": "魏延",
          "mode": "念",
          "content": "大将生来盖世雄，"
        },
        {
          "type": "dialogue",
          "speaker": "马岱",
          "mode": "念",
          "content": "万马营中逞威风。"
        },
        {
          "type": "dialogue",
          "speaker": "关兴",
          "mode": "念",
          "content": "耀武扬威英雄将，"
        },
        {
          "type": "dialogue",
          "speaker": "张苞",
          "mode": "念",
          "content": "斩将擒王立大功。"
        },
        {
          "type": "dialogue",
          "speaker": "魏延",
          "mode": "白",
          "content": "俺魏延。"
        },
        {
          "type": "dialogue",
          "speaker": "马岱",
          "mode": "白",
          "content": "俺马岱。"
        },
        {
          "type": "dialogue",
          "speaker": "关兴",
          "mode": "白",
          "content": "俺关兴。"
        },
        {
          "type": "dialogue",
          "speaker": "张苞",
          "mode": "白",
          "content": "俺张苞。"
        },
        {
          "type": "dialogue",
          "speaker": "魏延",
          "mode": "白",
          "content": "众位将军请了。"
        },
        {
          "type": "dialogue",
          "speaker": "马岱、关兴、张苞",
          "mode": "白",
          "content": "请了。"
        },
        {
          "type": "dialogue",
          "speaker": "魏延",
          "mode": "白",
          "content": "老元戎发兵，你我在此同候。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四白龙套同上，赵云上。"
        },
        {
          "type": "dialogue",
          "speaker": "赵云",
          "mode": "念",
          "content": "白发苍苍似雪飘，东灭孙权北剿曹。"
        },
        {
          "type": "dialogue",
          "speaker": "魏延、马岱、关兴、张苞",
          "mode": "白",
          "content": "参见老元戎。"
        },
        {
          "type": "dialogue",
          "speaker": "赵云",
          "mode": "白",
          "content": "众位将军少礼。"
        },
        {
          "type": "dialogue",
          "speaker": "魏延、马岱、关兴、张苞",
          "mode": "白",
          "content": "多谢老元戎。"
        },
        {
          "type": "dialogue",
          "speaker": "赵云",
          "mode": "白",
          "content": "人马可齐？"
        },
        {
          "type": "dialogue",
          "speaker": "魏延、马岱、关兴、张苞",
          "mode": "白",
          "content": "俱已齐备。"
        },
        {
          "type": "dialogue",
          "speaker": "赵云",
          "mode": "白",
          "content": "圣驾到此，一同接驾。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "太监内白：圣驾到。"
        },
        {
          "type": "dialogue",
          "speaker": "赵云",
          "mode": "白",
          "content": "一同接驾。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四大铠、四太监同上，诸葛亮、刘禅同上。"
        },
        {
          "type": "lyric",
          "speaker": "刘禅",
          "mode": "二黄原板",
          "content": "手挽手与相父长亭来进，众将官一个个杀气腾腾。看过了大纛旗香案设定，尊一声众神灵细听分明：但愿得此一去旗开得胜，但愿得此一去马到功成。内侍臣看过了皇封御饮，我与你老相父特来饯行。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄原板",
          "content": "我主爷赐皇封臣不敢饮，背转身谢过了天地尊神。"
        },
        {
          "type": "lyric",
          "speaker": "刘禅",
          "mode": "二黄原板",
          "content": "四皇叔孤赐你皇封御酒，但愿你此一去奏凯回程。"
        },
        {
          "type": "lyric",
          "speaker": "赵云",
          "mode": "二黄原板",
          "content": "臣年迈仗我主洪福天定，食君禄必须要答报皇恩。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄原板",
          "content": "我朝中有二臣忠心秉正，蒋公琰、费文炜二大贤臣。臣去后诸国事与他们议论，宫中事朝中事臣不欺君，君不瞒臣，以礼而行。"
        },
        {
          "type": "lyric",
          "speaker": "刘禅",
          "mode": "二黄原板",
          "content": "君臣们在长亭话叙不尽，"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "谢我主龙驾归臣要发兵。"
        },
        {
          "type": "lyric",
          "speaker": "刘禅",
          "mode": "二黄摇板",
          "content": "内侍臣摆御驾皇城来进，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四太监、四大铠同下。"
        },
        {
          "type": "lyric",
          "speaker": "刘禅",
          "mode": "二黄摇板",
          "content": "得胜回孤接到十里长亭。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "刘禅下。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "众将官齐上马擂鼓三通，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "擂鼓。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "文武官且免送响炮起营。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "众将官，兵出祁山。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四白龙套同带马，车夫上，众人同下。"
        }
      ],
      "stats": {
        "line_count": 52,
        "lyric_ratio": 0.48,
        "stage_direction_count": 8
      }
    },
    {
      "scene_id": 3,
      "title": "魏营遣将",
      "characters_on_stage": [
        "马遵",
        "报子",
        "姜维",
        "四绿龙套"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "马遵上。"
        },
        {
          "type": "dialogue",
          "speaker": "马遵",
          "mode": "念",
          "content": "威镇天水关，儿郎心胆寒。"
        },
        {
          "type": "dialogue",
          "speaker": "马遵",
          "mode": "白",
          "content": "本帅马遵，只因孔明带领人马，要夺天水关，命人前去打探，未见回报。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "报子上。"
        },
        {
          "type": "dialogue",
          "speaker": "报子",
          "mode": "白",
          "content": "报，韩德父子五人落马。"
        },
        {
          "type": "dialogue",
          "speaker": "马遵",
          "mode": "白",
          "content": "再探！来，免战高悬。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "龙套允。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "姜维内白：哽唬。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "姜维上。"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "念",
          "content": "一颗明珠土内藏，几载未曾放毫光。"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "俺，姓姜名维，字伯约。正在后帐观看兵书，忽听都督免战高悬。待我进帐，问个明白。"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "姜维告进。"
        },
        {
          "type": "dialogue",
          "speaker": "马遵",
          "mode": "白",
          "content": "将军少礼，一旁坐下。"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "谢坐。"
        },
        {
          "type": "dialogue",
          "speaker": "马遵",
          "mode": "白",
          "content": "将军无令，进帐有何军情议论？"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "末将正在后帐歇息，忽听都督免战高悬，也不知所谓何事？"
        },
        {
          "type": "dialogue",
          "speaker": "马遵",
          "mode": "白",
          "content": "只因韩德父子五人落马，故而免战高悬。"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "叫头",
          "content": "都督！"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "赐某将令一支，到两军阵前，生擒赵云进帐。"
        },
        {
          "type": "dialogue",
          "speaker": "马遵",
          "mode": "白",
          "content": "你有此胆量？"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "有此胆量。"
        },
        {
          "type": "dialogue",
          "speaker": "马遵",
          "mode": "白",
          "content": "姜维听令。"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "在。"
        },
        {
          "type": "dialogue",
          "speaker": "马遵",
          "mode": "白",
          "content": "命你带领本部三千人马，大战赵云，不得迟误。"
        },
        {
          "type": "dialogue",
          "speaker": "马遵",
          "mode": "念",
          "content": "传令山摇动，"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "念",
          "content": "接令鬼神惊。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "马遵下。四绿龙套自两边分上。"
        },
        {
          "type": "dialogue",
          "speaker": "四绿龙套",
          "mode": "白",
          "content": "参见将军。"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "站立两厢。"
        },
        {
          "type": "dialogue",
          "speaker": "四绿龙套",
          "mode": "白",
          "content": "哦。"
        },
        {
          "type": "lyric",
          "speaker": "姜维",
          "mode": "西皮导板",
          "content": "众将官站两厢听我令下，"
        },
        {
          "type": "dialogue",
          "speaker": "四绿龙套",
          "mode": "白",
          "content": "哦。"
        },
        {
          "type": "lyric",
          "speaker": "姜维",
          "mode": "西皮原板",
          "content": "叫一声众三军马步英豪：刘玄德坐西川其心诡诈，全凭着五虎将立下功劳。关美髯过五关谁人不晓，他三弟张翼德喝断霸桥。西凉将小马超世间稀少，还有那老黄忠惯使大刀。"
        },
        {
          "type": "lyric",
          "speaker": "姜维",
          "mode": "西皮快板",
          "content": "此一班五虎将大半丧了，只剩下赵子龙老迈年高。小阿斗坐西川年纪幼小，有关兴和张苞不算英豪。三军随爷战场道，"
        },
        {
          "type": "dialogue",
          "speaker": "四绿龙套",
          "mode": "白",
          "content": "哦。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四绿龙套同带枪下。"
        },
        {
          "type": "lyric",
          "speaker": "姜维",
          "mode": "西皮快板",
          "content": "捉孔明擒赵云只在今朝。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "姜维下。"
        }
      ],
