  "scenes": [
    {
      "scene_id": 1,
      "title": "讨账得盆",
      "characters_on_stage": [
        "张别古",
        "赵大"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "张别古上"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "哽唬。"
        },
        {
          "type": "lyric",
          "speaker": "张别古",
          "mode": "数板",
          "content": "年迈时衰，老来无子实难挨。妻丧早，命应该。只落得，奔忙劳碌打草鞋，打草鞋。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "念",
          "content": "人老曲腰把头低，树老焦梢叶儿稀。茄子老了一斗子，倭瓜越老越好吃。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "老汉张别古，打草鞋为生。这两天，生了一场毛病，没有出去做买卖。今日病好了，一个钱没有。我想起城南赵大，欠我两双草鞋钱，不免前去要了来，也好度日。就此走走。待我出了门，关上门，我再锁上门。门呢，门呢，你好好看住我的门，不要叫羊吃了我的被窝。走了走了，再也不能小了，若是小了，可是费了事了。说话之间到呢，哎吓，这个房子，怎么翻盖呢？还是搬了家了？待我再来看看：“损德堂赵”，是他的堂名，待我来叫叫看。赵大，赵大……"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵大上"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "念",
          "content": "忽听叫赵大，胆战又如麻。纵然将事发，我有钱也不怕。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "是谁？"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "赵大，赵大……"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "原来是老小子。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "吓，他哪里抢得来的钱，穿得这么好。是我。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "你做什么来的？"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "我找你有两句话讲。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "有话在这里讲么？"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "不在这里讲，在哪里讲？"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "这里风大，吹了我的舌头。在我会客厅里讲去。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "有了钱，就有了会客厅了。我不认识，你头里走。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "跟我走进大门，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "张别古允。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "进二门，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "张别古允。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "走穿廊，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "张别古允。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "哦，过游廊，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "张别古允。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "抬起脚来。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "做什么？"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "小心黄鼠狼。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "你们这里狼都不少。你还到的了到不了呢？"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "就算到了罢。跟我进来。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "哦，这个地方都不错，好像一只戏台。吓，待我来坐一会。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "哎，走开，这个地方，你也好坐的么？"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "坐坐也不要紧。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "木能生火，你可晓得烧了你的屁股。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "你坐怎么不烧的？"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "我是福大量大。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "我坐在哪里？"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "你坐在地下。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "哦，我就坐在地下。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "有什么话说？"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "你前几天，拿了我两双草鞋，没给钱，今天你该给我了。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "什么？我头上戴的什么？我身上穿的什么？脚底下蹬的什么？我会欠你的草鞋钱？你胡说乱道！"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "哎吓，发了财，他全忘呢。有了。赵大爷你听错呢，不是你欠我的草鞋钱，是你的伙计，拿我两双草鞋，没给钱，写在你帐上呢。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "这句话对了。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "有钱给了我。我好去。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "钱呢，我告诉你，都用铁丝穿起来了，为你还开串，不成。没有钱。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "有银子没有？"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "银子都浇了银山了。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "有票子没有？"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "票子有两张当票子。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "当票子我也无钱赎。我就是讨饭，你也给我一个讨饭的家伙。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "你跟我到盆库里去。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "吓，盆亦有了库了。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "我大爷有钱。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "你里头走。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "跟我来。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "你这两天都好，没生毛病。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "你不要胡说。到了，你瞧，上中下三层。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "你把上层的与我一个。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "上层是进卖的，你不能用。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "中层的与我一个罢。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "中层是公伯王侯使的，你不能用。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "下层的与我一个罢。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "下层的是来路客商使的，你不能用。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "那么着，我在大堆里挑一个罢。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "这倒可以使得，我替你捡一个。我告诉你这个盆，一窑烧的，这一个，它还有个名字。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "它叫什么名字？"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "它叫个乌盆。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "刘世昌上。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "这个名字倒不错。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "你去吧。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "你们这里廊太多，我弄不清楚。你把我带出去。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "好，你跟我出来。好呢，算到呢。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "吓，我去了。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "你回来，你回来。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "回来干什么？"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "你到了外头，有那小姑娘、小小厮，买两个来。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "要小姑娘、小小厮，做什么？"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "小姑娘服侍你大奶奶。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "小小厮呢？"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "服侍我大爷。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "哦。有了两个钱，真会出花头。有呢，待我来拿他开开心。大爷小姑娘都没有，有一个小小子。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "小小子在哪里？"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "你远看。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "没有。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "近看。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "就是你吓？"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "咳，不错。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "呸，我没有钱与你买棺材。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "我作你们家里活祖宗吓。"
        },
        {
          "type": "dialogue",
          "speaker": "赵大",
          "mode": "白",
          "content": "你滚出去吓。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵大关门，下。"
        }
      ],
      "stats": {
        "line_count": 120,
        "lyric_ratio": 0.08,
        "stage_direction_count": 15
      }
    },
    {
      "scene_id": 2,
      "title": "回家诉冤",
      "characters_on_stage": [
        "张别古",
        "刘世昌"
      ],
      "segments": [
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "吓，老天哪，老天！我想赵大与我一样之人，为何他就会发起财了？嗳：莫道东风常向北，北风也有向南时。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "张别古！"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "吓，哪里有人叫我？"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "哎，老丈！"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "哎呀，不好，盆说的话呢！"
        },
        {
          "type": "lyric",
          "speaker": "刘世昌",
          "mode": "二黄原板",
          "content": "老丈不必胆怕惊，我有言来你是听。休把我当作妖魔论，我本是屈死一亡魂。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "嗳。"
        },
        {
          "type": "lyric",
          "speaker": "张别古",
          "mode": "二黄原板",
          "content": "他那里叫一声张别古，倒叫我年迈人糊里糊涂。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "哎呀，且住。常言说得好：少年见鬼，还有三年；老来见鬼，就在眼前。不好，拿起盆来走。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "刘世昌挡张别古。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "我打这边走，我打那边走。不好，鬼打墙。"
        },
        {
          "type": "lyric",
          "speaker": "刘世昌",
          "mode": "二黄原板",
          "content": "忙将树枝摇摆定，"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "哎吓，好大的风吓！"
        },
        {
          "type": "lyric",
          "speaker": "刘世昌",
          "mode": "二黄原板",
          "content": "对准了老丈撮灰尘。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "哎吓，好大的砂土！"
        },
        {
          "type": "lyric",
          "speaker": "刘世昌",
          "mode": "二黄原板",
          "content": "我和你素无冤旧又无恨，望求老丈把冤伸。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "不好，弄的我鼻子里，嘴里，耳朵里，眼睛里，都是些黄土泥。拿起来走吓。"
        },
        {
          "type": "lyric",
          "speaker": "张别古",
          "mode": "二黄摇板",
          "content": "急急忙忙往前进，不觉来到城隍庙门。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "吓，说话之间，到了城隍庙呢。我听人说，城隍老爷顶灵的，待我进去许个愿，叫这鬼不跟我才好。就是这个主意，就此走走。"
        },
        {
          "type": "lyric",
          "speaker": "张别古",
          "mode": "数板",
          "content": "我一进庙来，恭身下拜。尊一声城隍老爷细听明白：只因赵大该我的钱财，我去要债。他没有钱，给了我一个盆，折了债。这个盆，它是个妖怪。半路途中，说起话来。望神圣与我遮盖，明日里猪头三牲、豆腐白菜，我一齐买来，我一齐买来。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "好好，愿也许呢，待我来叫叫看。乌盆。城隍老爷真灵了。鬼也不跟我，待我回去放好。我连吃饭都没钱，哪里有钱还愿？不好，城隍老爷闹起来，比鬼还凶。待我退掉他吧。"
        },
        {
          "type": "lyric",
          "speaker": "张别古",
          "mode": "数板",
          "content": "二次进庙，恭身下拜。尊一声城隍老爷细听明白：只因赵大不该我钱财，我也没去要债。这个盆，它不是妖怪。半路途中，没有说出话来。望神圣不要与我遮盖，明日里猪头三牲、豆腐白菜，不能买来，不能买来。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "城隍老爷，我方才说的话吓，算拉倒呢。好好，愿也退掉呢，待我来叫叫看。乌盆。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "不好，又来呢。拿起来走吓。"
        },
        {
          "type": "lyric",
          "speaker": "张别古",
          "mode": "二黄摇板",
          "content": "急急走来急急行，不觉来到自己门。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "到了自家家呢。"
        },
        {
          "type": "lyric",
          "speaker": "张别古",
          "mode": "数板",
          "content": "我搁下了盆，放下了罐，拿起钥匙，捅开了锁的屁股门。推开了门，拿起了盆，拿起了罐，进了门。搁下了盆，放下了罐，关上了门。拿起闩来，顶上了门。我看你怎么进，我的门？"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "张别古。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "不好，拿鬼关的屋里来哉。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "老丈。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "你有什么话都说罢。"
        },
        {
          "type": "lyric",
          "speaker": "刘世昌",
          "mode": "反二黄慢板",
          "content": "未曾开言泪满腮，尊一声老丈细听开怀："
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "家住哪里？"
        },
        {
          "type": "lyric",
          "speaker": "刘世昌",
          "mode": "反二黄慢板",
          "content": "家住在南阳城关外，"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "离城多少？"
        },
        {
          "type": "lyric",
          "speaker": "刘世昌",
          "mode": "反二黄慢板",
          "content": "离城十里太平街。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "姓甚名谁？"
        },
        {
          "type": "lyric",
          "speaker": "刘世昌",
          "mode": "反二黄慢板",
          "content": "刘世昌祖居有数代，"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "什么行业？"
        },
        {
          "type": "lyric",
          "speaker": "刘世昌",
          "mode": "反二黄慢板",
          "content": "务农为本颇有家财。奉母命上京去做买卖，贩卖绸缎倒也生财。主仆离家有一载，归清账目转回家来。行至在定远县关外，忽然间大雨就洒下来。路过了赵大窑门外，借宿谁知惹祸灾。蒙赵大夫妻好款待，顷刻间备出酒饭来。酒内下毒我不解，害死主仆命丧阳台。烧成了乌盆窑中摆，幸喜得老丈讨帐来。可怜我含冤有三载，有三载，老丈吓，"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "哎吓，一个人倒了霉，什么事情都遇的着。会碰见鬼了，这是哪里说起。"
        },
        {
          "type": "lyric",
          "speaker": "刘世昌",
          "mode": "反二黄原板",
          "content": "多蒙你将我带出庄来。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "我听人说，鬼怕脏东西。我昨天晚上拉了一盆屎，待我来浇他一浇。哎吓，好臭吓。哦呵，来呢！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "刘世昌挡。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "不好，全弄到自己身上来了。"
        },
        {
          "type": "lyric",
          "speaker": "刘世昌",
          "mode": "反二黄原板",
          "content": "劈头盖脸洒下来，奇臭难闻我的口难开。恨赵大夫妻将我害，害得我一家人两离分开。老母望儿儿不在，妻子盼夫夫不能够归来。好一似失针归大海，要相逢除非是梦里阳台。望求老丈将我带，你带我去见那包县台。在那公堂之上把我冤仇解，我保你福寿康宁永无灾。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "说了半天，你叫我替你打官司。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "正是。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "我就有一样，见官说不出话来。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "你告诉我。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "我不去。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "告告罢。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "不去。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "我拿你头疼。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "哦，呵呵，我去，我去。我告诉你，你跟我走。我叫你你可答应，盆儿。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "是。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "怪哉怪哉，真怪哉。乌盆。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "唉，我今带你赴莲台。乌盆。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "你有什么冤枉事？乌盆。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "跟阿爹到戏房里来。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "刘世昌、张别古同下。"
        }
      ],
      "stats": {
        "line_count": 180,
        "lyric_ratio": 0.6,
        "stage_direction_count": 10
      }
    },
    {
      "scene_id": 3,
      "title": "公堂鸣冤",
      "characters_on_stage": [
        "包拯",
        "四青袍",
        "二衙役",
        "张别古",
        "刘世昌"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "包拯引四青袍、二衙役同上。"
        },
        {
          "type": "lyric",
          "speaker": "包拯",
          "mode": "引子",
          "content": "官居县令，与黎民，判断冤情。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "念",
          "content": "十载寒窗读圣贤，常将铁砚也磨穿。深受皇恩为知县，朝廷王法大如天。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "下官包拯，身居定远县知县，今当三六九日，放告之期。左右，将放告牌抬出。"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "白",
          "content": "将放告牌抬出。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "张别古、刘世昌同上。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "走吓。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "念",
          "content": "虽然古怪年年有，果然不似今年多。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "盆儿。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "到了，咱们如今要告状了。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "老丈喊冤，我暗中保护与你。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "你不要走，待我来喊冤。冤枉！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二衙役同允。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "带上来。"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "白",
          "content": "老头儿，老爷传你上堂。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "晓得了，来呢。乌盆。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "咱们要去伸冤去。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "是。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "跟我进来。叩见老爷。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "那一老头儿，家住哪里，姓甚名谁，有何冤枉，朝上诉来。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "回禀太爷的话，小老儿姓张，我也不是弓长张，也不是立早章，我是骡子撒料一张一张那个张；别我也不是特别的别，也不是辞别的别，是往后头别的别；这个古，也不是古来的古，也不是铜鼓的鼓，我乃是屁股的股。"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "白",
          "content": "喝！"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "我打草鞋为生，城南赵大，该我两双草鞋钱，我跟他去要债，他没有钱，给了我一个盆。走在半路，这个盆说了话，乌盆它有冤枉。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "怎么乌盆会讲话？"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "不错，它会讲话。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "好，左右听了。乌盆，乌盆。"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "白",
          "content": "未曾说话。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "乌盆。"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "白",
          "content": "未曾说话。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "哽。赶了下去。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二衙役同赶张别古出。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "乌盆。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "咳，你怎么不进去？"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "我正要进去，又被门神爷爷将我挡住，望求太爷赏下纸钱烧化，怨鬼方可进去。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "你等着我。冤枉！"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "白",
          "content": "启禀太爷：老头又来喊冤。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "好，叫他进来。"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "白",
          "content": "老头进来。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "乌盆说的话来。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "他讲些什么？"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "他本要进来，又被门神挡住，求老爷赏下纸钱烧化。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "赏他纸钱一份。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二衙役同烧化纸钱。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "乌盆，纸烧呢，跟我进来。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "是。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "乌盆来呢。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "左右听真。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二衙役同允。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "乌盆。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "乌盆。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "乌盆。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "白",
          "content": "未曾说话。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "左右打他五板。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二衙役同打张别古。"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "白",
          "content": "一、二、三、四、五。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "金木水火土。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "赶了下去。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二衙役同赶张别古出。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "乌盆。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "哎吓，你怎么拿我开心呢。我为你捱了屁股呢！"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "不是我不肯进去，那赵大夫妻害我之时，剥得赤身露体。想太爷日后有三公之位，恐怕冲撞，望求爷爷赏下青衣一件，遮盖怨鬼，方可进去。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "你说的话，我不相信，我不去了。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "告了罢。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "我不去。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "我拿你头疼。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "嗳，吓吓，我不去打官司要头疼，我去打官司屁股疼，两头受罪。我还是让他屁股疼。冤枉！"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "白",
          "content": "老头又来喊冤。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "带进来。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "参见老爷。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "哽。那一老头三番两次，敢是搅闹公堂么？"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "乌盆又说的话了。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "他讲些什么？"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "他说赵大夫妻害他之时，剥得赤条精光。"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "白",
          "content": "咳，赤身露体！"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "不错，赤身露体。想太爷日后有八公之位。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "哽，三公之位。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "不错，三公之位，尤恐冲撞，望太爷赏下青衣一件遮盖，方好进来。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "好，赏他青衣一件。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二衙役同取衣。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "吓，这个老爷好说话，要什么他给什么，有了。回禀老爷的话，乌盆又说话了。他还要五百块洋钱。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "哽，不像话。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "乌盆。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "好了，跟我进来。乌盆。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "刘世昌允。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "乌盆。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "刘世昌允。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "乌盆来了，来了。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "左右，听好了。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二衙役同允。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "乌盆。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "乌盆。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "乌盆。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "笑",
          "content": "哈哈哈！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "张别古坐桌子上。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "不成功，冤枉打我了！"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "左右错打他五板，赏他五钱银子。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "这个生意不错，禀老爷再打五记，凑成一两。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "赶了下去。"
        },
        {
          "type": "dialogue",
          "speaker": "张别古",
          "mode": "白",
          "content": "走走走。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "张别古下。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "那一乌盆，家住哪里，姓甚名谁，有何冤枉，朝上诉来。"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "爷爷容禀："
        },
        {
          "type": "lyric",
          "speaker": "刘世昌",
          "mode": "西皮流水板",
          "content": "怨鬼家住在南阳，姓刘名安字世昌。贩卖绸缎京中往，偶遇赵大起不良。害死主仆双双丧，烧成乌盆在库内藏。不是别古讨帐往，焉能今日到公堂？爷爷断明这冤枉，子子孙孙立朝堂。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "何人的见证？"
        },
        {
          "type": "dialogue",
          "speaker": "刘世昌",
          "mode": "白",
          "content": "钟馗爷爷。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "来。将盆入库。"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "白",
          "content": "是。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "左右拿我火签，走到东大庄，将赵大夫妻，带到听审。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二衙役同允。"
        },
        {
          "type": "dialogue",
          "speaker": "包拯",
          "mode": "白",
          "content": "拴门。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "众人同下。"
        }
      ],
