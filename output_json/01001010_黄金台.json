  "scenes": [
    {
      "scene_id": 1,
      "title": "巡街擒太子",
      "characters_on_stage": [
        "田单",
        "衙役甲",
        "衙役乙",
        "田法章"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "田单内白：掌灯。"
        },
        {
          "type": "lyric",
          "speaker": "田单",
          "mode": "二黄导板",
          "content": "听樵楼打四更玉兔东上，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二衙役同上，田单上。"
        },
        {
          "type": "lyric",
          "speaker": "田单",
          "mode": "回龙",
          "content": "为国家哪顾得昼夜奔忙。"
        },
        {
          "type": "lyric",
          "speaker": "田单",
          "mode": "二黄原板",
          "content": "西凉国欠我朝三载贡上，将邹妃和伊立来见大王。我主爷见邹妃龙心飘荡，每日里贪酒色不理朝纲。昭阳院害国母一命身丧，眼见得这江山付于汪洋。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "念白",
          "content": "身在胧朦睡，怀揣社稷忧。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "下官田单，齐王驾前为臣，官拜巡城御史。适才家院报道，东宫小千岁，连夜逃出皇城，不知为了何事。因此下官亲自巡查。来！"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "掌灯。"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "",
          "content": "哦。"
        },
        {
          "type": "lyric",
          "speaker": "田单",
          "mode": "二黄摇板",
          "content": "叫人来掌红灯大街来上，若有那面生人细问端详。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "田法章上，二衙役同拿田法章。"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "",
          "content": "拿住了犯夜的了！"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "",
          "content": "伙计你看住他，我去讨赏。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役乙",
          "mode": "",
          "content": "好，我来看住他，你去。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "",
          "content": "回禀老爷的话，小人拿住犯夜的了。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "哦，你拿着犯夜的了！"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "",
          "content": "正是。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "好，回衙有赏。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "",
          "content": "多谢老爷！"
        },
        {
          "type": "dialogue",
          "speaker": "衙役乙",
          "mode": "",
          "content": "怎么样了？"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "",
          "content": "我有了赏了！"
        },
        {
          "type": "dialogue",
          "speaker": "衙役乙",
          "mode": "",
          "content": "你看住他，我也去弄一份。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "",
          "content": "好。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役乙",
          "mode": "",
          "content": "回禀老爷的话，我也拿着犯夜的了。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "哦，你也拿着犯夜的了？也有赏。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役乙",
          "mode": "",
          "content": "多谢老爷。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "",
          "content": "怎么样了？"
        },
        {
          "type": "dialogue",
          "speaker": "衙役乙",
          "mode": "",
          "content": "我也有了赏了！"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "",
          "content": "你看住他，我再去弄一份！"
        },
        {
          "type": "dialogue",
          "speaker": "衙役乙",
          "mode": "",
          "content": "好。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "",
          "content": "回禀老爷的话，小人又拿着犯夜的了。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "哽，夜静更深，哪有许多犯夜之人？掌灯，老爷亲自观看！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "衙役甲允，田单看。"
        },
        {
          "type": "dialogue",
          "speaker": "田法章",
          "mode": "",
          "content": "哎呀，卿……"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "静声！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "田单踢灯，扯田法章同下。二衙役同摸灯。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役乙",
          "mode": "",
          "content": "卿……"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "",
          "content": "静声！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "衙役甲扯衙役乙同下。"
        }
      ],
      "stats": {
        "line_count": 38,
        "lyric_ratio": 0.26,
        "stage_direction_count": 6
      }
    },
    {
      "scene_id": 2,
      "title": "府中问情",
      "characters_on_stage": [
        "田单",
        "田法章",
        "乳娘",
        "家院"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "田单、田法章同上。乳娘上，开门。田单、田法章同进门。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "千岁醒来。"
        },
        {
          "type": "lyric",
          "speaker": "田法章",
          "mode": "二黄导板",
          "content": "时才间搀得我昏迷不醒，"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "千岁。"
        },
        {
          "type": "dialogue",
          "speaker": "田法章",
          "mode": "哭",
          "content": "哎呀！"
        },
        {
          "type": "lyric",
          "speaker": "田法章",
          "mode": "二黄摇板",
          "content": "只见卿家面前存。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "千岁，"
        },
        {
          "type": "lyric",
          "speaker": "田单",
          "mode": "二黄摇板",
          "content": "问千岁因甚事逃出宫院，一一的对为臣细说根源。"
        },
        {
          "type": "lyric",
          "speaker": "田法章",
          "mode": "二黄摇板",
          "content": "伊立与我结仇恨，要害小王命残生。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "好奸贼！"
        },
        {
          "type": "lyric",
          "speaker": "田单",
          "mode": "二黄摇板",
          "content": "背地里只把那伊立埋怨，平白地害幼主所为哪般？"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "家院上。"
        },
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "",
          "content": "今有伊公公带领许多校尉，前来搜府。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "再去打听！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "家院允，下。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "哎呀，千岁，今有伊立带领许多校尉，前来搜寻殿下。这便如何是好？"
        },
        {
          "type": "dialogue",
          "speaker": "田法章",
          "mode": "",
          "content": "哎呀，卿家，你要救我一救！"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "哎呀，千岁，事到如今，并无别计：千岁扮做小妹模样，等那奸贼到来，混过一时，再作道理。"
        },
        {
          "type": "dialogue",
          "speaker": "田法章",
          "mode": "",
          "content": "小王乃金枝玉叶，岂扮那妇人模样！"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "哎呀，千岁，事到如今，讲什么“金枝玉叶”？龙驾要紧！乳娘，"
        },
        {
          "type": "dialogue",
          "speaker": "乳娘",
          "mode": "",
          "content": "允。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "与千岁改扮起来！"
        },
        {
          "type": "dialogue",
          "speaker": "乳娘",
          "mode": "",
          "content": "是。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "田法章、乳娘同下。"
        },
        {
          "type": "lyric",
          "speaker": "田单",
          "mode": "二黄导板",
          "content": "水不清皆因是鱼儿搅混，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四校尉同上，过场。伊立上。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "呔，马来！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "伊立过场，下。四校尉同下。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "好奸贼！"
        },
        {
          "type": "lyric",
          "speaker": "田单",
          "mode": "二黄摇板",
          "content": "我朝中又出了卖国的奸臣！施一礼我把千岁爷的驾请，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "田法章、乳娘同上。"
        },
        {
          "type": "lyric",
          "speaker": "田法章",
          "mode": "二黄摇板",
          "content": "金枝玉叶扮妇人。"
        },
        {
          "type": "dialogue",
          "speaker": "田法章",
          "mode": "",
          "content": "卿家，看小王扮得可像？"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "千岁扮得倒像，可晓得妇人家行走？"
        },
        {
          "type": "dialogue",
          "speaker": "田法章",
          "mode": "",
          "content": "这倒不晓得妇人家行走。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "乳娘教导千岁。"
        },
        {
          "type": "dialogue",
          "speaker": "乳娘",
          "mode": "",
          "content": "是。啊，千岁，妇人行走，必须要这样走。"
        },
        {
          "type": "dialogue",
          "speaker": "田法章",
          "mode": "",
          "content": "哦，妇人行走，必须要这样走。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "哦，啊，照照照！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "家院上。"
        },
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "",
          "content": "伊公公驾到！"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "有请！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "田法章、乳娘同下。四校尉、伊立同上。"
        }
      ],
      "stats": {
        "line_count": 42,
        "lyric_ratio": 0.21,
        "stage_direction_count": 9
      }
    },
    {
      "scene_id": 3,
      "title": "伊立搜府",
      "characters_on_stage": [
        "田单",
        "伊立",
        "校尉",
        "乳娘",
        "田法章"
      ],
      "segments": [
        {
          "type": "lyric",
          "speaker": "伊立",
          "mode": "二黄摇板",
          "content": "御史衙前下了马，"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "公公请进！"
        },
        {
          "type": "lyric",
          "speaker": "伊立",
          "mode": "二黄摇板",
          "content": "有劳大人相迎咱。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "公公请坐。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "请。田大人这作什么？"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "与公公挡坐。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "这就不敢！"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "当得的！"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "这就不敢，吓！"
        },
        {
          "type": "dialogue",
          "speaker": "田单、伊立",
          "mode": "同笑",
          "content": "哈哈哈……"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "公公这作什么？"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "与田大人挡坐。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "这就不敢！"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "当得的！"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "这就不敢，吓！"
        },
        {
          "type": "dialogue",
          "speaker": "田单、伊立",
          "mode": "同笑",
          "content": "哈哈哈……"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "不知公公驾到，未曾远迎，当面恕罪！"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "岂敢，岂敢。咱家来的鲁莽，望田大人恕过罪罢！"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "岂敢那岂敢！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四校尉同喊。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "啊，公公，这夜静更深，带领许多校尉，来到敝衙，有何公干？"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "怎么着，这桩事情，你还不知道么？"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "倒也不知。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "既然不知，待咱家慢慢的告诉于你。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "公公请讲。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "今有东宫世子田法章，人伦大变，子淫父妃。大王大怒，赐咱家宝剑一口，三更时分，斩杀回奏。也不知何人走漏了消息，将世子放走。咱家二次启奏大王，大王赐咱家校尉四十名，各府搜寻。各府俱已搜到没有。我想那世子他定藏在你府！"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "啊，公公，既是千岁犯罪，你我为大臣者，就该上殿保奏才是。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "咱家连保数本，大王不准，那也是枉然。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "哦，公公保过本了。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "保过许多的呢！"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "也罢，待下官明日亲自私访。有了千岁的下落献于公公，这桩事也就完了！"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "田大人，你这话不是这么说。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "要怎么的讲？"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "我想那世子定在你府，你将他献将出来，保你无事，那也就完了！"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "哈哈哈，多蒙公公美意。我想世子他……"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "怎么着？"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "不在敝府。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "当真不在你府？"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "当真不在。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "果然不在？"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "果然不在。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "田大人你这儿来。你说世子不在你府，咱家就要……"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "你要怎么？"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "我就要搜！"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "公公你当真要搜？"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "当真要搜。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "果然要搜？"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "果然要搜。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "请搜！"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "校尉的与我搜！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四校尉同允。四校尉两边搜。田法章、乳娘同上。"
        },
        {
          "type": "dialogue",
          "speaker": "四校尉",
          "mode": "",
          "content": "有两个妇人。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "起过了。田大人，你说世子不在你府，任我亲自一观。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "伊立亮架子。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "那两个妇人她是谁？"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "哈哈哈，我道是谁，原来是小妹同乳娘，乳娘同小妹。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "怎么着，田姑娘么？"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "不敢，小妹。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "请过来，咱家见过礼吧！"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "小妹礼貌不周，冲撞公公，那还了得，不见也罢。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "见见何妨？"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "不见也罢。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "我一定要见！"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "当真要见？"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "当真要见！"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "就见！"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "这不结了么！"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "乳娘搀扶小妹，见过伊公公。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "待我看她行走如何。"
        },
        {
          "type": "dialogue",
          "speaker": "乳娘",
          "mode": "",
          "content": "是，姑娘有礼。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "咱家还礼。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "田法章、乳娘同下。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "且住，我想那世子上了天？"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "天高只怕上不去。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "他入了地？"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "地原无门，只怕下不去。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "他往哪里去了呢？"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "照吓，他往哪里去了？"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "哦呵，有了。不免回去多讨校尉，再来搜寻。田大人，咱家清晨起来，吃了几杯早酒，言语得罪大人。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "岂敢。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "冒犯大人。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "越发的不敢。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "",
          "content": "告辞了。"
        },
        {
          "type": "lyric",
          "speaker": "伊立",
          "mode": "二黄摇板",
          "content": "辞别大人把马跨，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四校尉同带马，同下。"
        },
        {
          "type": "lyric",
          "speaker": "伊立",
          "mode": "二黄摇板",
          "content": "多讨校尉再搜查。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "送公公。"
        },
        {
          "type": "dialogue",
          "speaker": "伊立",
          "mode": "三笑",
          "content": "哈哈，哈哈，哈哈。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "伊立下。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "好奸贼！"
        },
        {
          "type": "lyric",
          "speaker": "田单",
          "mode": "二黄摇板",
          "content": "狗奸贼发了怒令人害怕，倘若是漏机关就把头杀。二次里走上前急忙接驾，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "田法章、乳娘同上。"
        },
        {
          "type": "lyric",
          "speaker": "田法章",
          "mode": "二黄摇板",
          "content": "再与卿家把话答。"
        }
      ],
      "stats": {
        "line_count": 86,
