      }
    },
    {
      "scene_id": 4,
      "title": "君臣出逃",
      "characters_on_stage": [
        "田单",
        "田法章",
        "乳娘"
      ],
      "segments": [
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "哎呀千岁，那贼临行言道：还要多讨校尉，前来搜寻殿下。这便如何是好？"
        },
        {
          "type": "dialogue",
          "speaker": "田法章",
          "mode": "",
          "content": "卿家你还要救我一救！"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "哎呀，千岁，你我君臣扮作烧香还愿之人，诈出皇城，再作道理。"
        },
        {
          "type": "dialogue",
          "speaker": "田法章",
          "mode": "",
          "content": "此计甚好！"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "改扮起来。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "田单、田法章同换行头。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "乳娘，这有官宝一锭，逃回原郡去吧！"
        },
        {
          "type": "dialogue",
          "speaker": "乳娘",
          "mode": "",
          "content": "遵命。"
        },
        {
          "type": "dialogue",
          "speaker": "田法章",
          "mode": "",
          "content": "卿家带马。"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "领旨。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "田单带马。"
        },
        {
          "type": "dialogue",
          "speaker": "田法章",
          "mode": "",
          "content": "卿……"
        },
        {
          "type": "dialogue",
          "speaker": "田单",
          "mode": "",
          "content": "静声。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "田单、田法章同下。"
        }
      ],
