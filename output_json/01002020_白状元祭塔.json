  "scenes": [
    {
      "scene_id": 1,
      "title": "",
      "characters_on_stage": [
        "许仕林",
        "四青袍"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四青袍同上，许仕林上。"
        },
        {
          "type": "dialogue",
          "speaker": "许仕林",
          "mode": "引子",
          "content": "一色杏花红十里，状元归去马如飞。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "许仕林坐。"
        },
        {
          "type": "dialogue",
          "speaker": "许仕林",
          "mode": "念",
          "content": "中状元名扬天下，琼林宴帽插宫花。喜则喜三宫摘宴，稳坐在三元上下。"
        },
        {
          "type": "dialogue",
          "speaker": "许仕林",
          "mode": "白",
          "content": "下官许仕林，蒙圣恩得中头名状矣。想我母亲雷峰塔受苦，是我上殿启奏一本，今日奉旨回家祭祖。左右，吩咐外厢开道。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四青袍、许仕林同下。"
        }
      ],
      "stats": {
        "line_count": 9,
        "lyric_ratio": 0.0,
        "stage_direction_count": 3
      }
    },
    {
      "scene_id": 2,
      "title": "",
      "characters_on_stage": [
        "塔神",
        "许仕林",
        "四青袍",
        "白素贞"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "塔神上。"
        },
        {
          "type": "dialogue",
          "speaker": "塔神",
          "mode": "念",
          "content": "力大无穷顶砚台，玉帝符旨把某差。"
        },
        {
          "type": "dialogue",
          "speaker": "塔神",
          "mode": "白",
          "content": "我乃塔神是也，奉了玉帝符旨，在此看守雷峰塔。不免在此伺候。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四青袍同上，同挖门，许仕林上，拈香。"
        },
        {
          "type": "dialogue",
          "speaker": "许仕林",
          "mode": "三叫头",
          "content": "母亲！老娘！娘亲！"
        },
        {
          "type": "lyric",
          "speaker": "许仕林",
          "mode": "二黄导板",
          "content": "见此塔不由人双泪落定,"
        },
        {
          "type": "lyric",
          "speaker": "许仕林",
          "mode": "二黄摇板",
          "content": "怎不叫儿痛在心。"
        },
        {
          "type": "lyric",
          "speaker": "许仕林",
          "mode": "哭板",
          "content": "哭一声老娘亲不能相见，儿的娘吓……"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "许仕林躺下，四青袍同下。"
        },
        {
          "type": "dialogue",
          "speaker": "塔神",
          "mode": "白",
          "content": "白氏仙姑，你儿前来祭奠于你，快些走动。"
        },
        {
          "type": "lyric",
          "speaker": "白素贞",
          "mode": "内二黄导板",
          "content": "在塔中思娇儿珠泪滚滚,"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "白素贞上。"
        },
        {
          "type": "dialogue",
          "speaker": "白素贞",
          "mode": "白",
          "content": "苦哇……"
        },
        {
          "type": "lyric",
          "speaker": "白素贞",
          "mode": "二黄摇板",
          "content": "又听得揭谛神呼唤一声。我这里向前去开言便问，问尊神呼唤我所为何情？"
        },
        {
          "type": "dialogue",
          "speaker": "塔神",
          "mode": "白",
          "content": "你儿许仕林，前来祭奠于你。"
        },
        {
          "type": "dialogue",
          "speaker": "白素贞",
          "mode": "白",
          "content": "可容我母子相见？"
        },
        {
          "type": "dialogue",
          "speaker": "塔神",
          "mode": "白",
          "content": "容你母子相见。"
        },
        {
          "type": "dialogue",
          "speaker": "白素贞",
          "mode": "白",
          "content": "有劳了！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "塔神下。"
        },
        {
          "type": "lyric",
          "speaker": "白素贞",
          "mode": "二黄摇板",
          "content": "听说是小孩儿前来祭奠，不由我一阵阵泪洒胸前。我这里向前来用目观看，又只见小娇儿倒在塔前。"
        },
        {
          "type": "dialogue",
          "speaker": "白素贞",
          "mode": "白",
          "content": "我儿醒来……"
        },
        {
          "type": "lyric",
          "speaker": "许仕林",
          "mode": "二黄导板",
          "content": "耳边厢又听得有人唤声,"
        },
        {
          "type": "lyric",
          "speaker": "许仕林",
          "mode": "二黄摇板",
          "content": "急忙上前开言问：今日下官来到此，你是何人叫仕林？"
        },
        {
          "type": "lyric",
          "speaker": "白素贞",
          "mode": "二黄摇板",
          "content": "我的儿你不必将娘来问，我就是在塔中受苦的娘亲。"
        },
        {
          "type": "lyric",
          "speaker": "许仕林",
          "mode": "二黄摇板",
          "content": "听说母亲到来临，怎不叫儿痛在心！走上前来忙跪定，一一从头说儿听。"
        },
        {
          "type": "dialogue",
          "speaker": "白素贞",
          "mode": "白",
          "content": "我儿免礼平身。"
        },
        {
          "type": "dialogue",
          "speaker": "许仕林",
          "mode": "白",
          "content": "谢母亲。"
        },
        {
          "type": "dialogue",
          "speaker": "白素贞",
          "mode": "白",
          "content": "那旁有块顽石，我儿坐下。儿吓！哪里来的一身荣耀？"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "许仕林坐。"
        },
        {
          "type": "dialogue",
          "speaker": "许仕林",
          "mode": "白",
          "content": "孩儿得中头名状元，故而这身荣耀。"
        },
        {
          "type": "dialogue",
          "speaker": "白素贞",
          "mode": "白",
          "content": "儿就该奏明圣上，搭救为娘，才是道理。"
        },
        {
          "type": "dialogue",
          "speaker": "许仕林",
          "mode": "白",
          "content": "孩儿上殿连奏数本，圣上不准也是枉然。"
        },
        {
          "type": "dialogue",
          "speaker": "白素贞",
          "mode": "白",
          "content": "这也是为娘命该如此。"
        },
        {
          "type": "dialogue",
          "speaker": "许仕林",
          "mode": "白",
          "content": "嗳，母亲，将当年受苦之事，说与孩儿知道。"
        },
        {
          "type": "dialogue",
          "speaker": "白素贞",
          "mode": "白",
          "content": "我儿坐在一旁，听为娘将受苦之事，说与我儿知道。"
        },
        {
          "type": "lyric",
          "speaker": "白素贞",
          "mode": "反二黄慢板",
          "content": "未开言不由人珠泪双流，叫一声仕林儿细听从头：黑风仙他本是为娘道友，劝为娘勤修炼自有出头。峨眉山同修道千年已久，悔不该贪红尘始下山头。在西湖遇儿父初瞻山斗，借雨伞结丝罗我把他赘。都只为端午日同饮药酒，是为娘显法身惹下忧愁。在床前将儿父灵魂嚇走，为娘的盗灵芝用尽心谋。儿的父上金山烧香行走，又谁知那秃驴洩漏计谋。那法海他那里早已算就，现神通用法术欲把娘收。实指望遇儿父天长地久，实指望遇儿父到老白头。又谁知儿的父谗言听就，听信了那法海一片奸谋。为娘的我也曾水内职斗，为娘的悔不该水漫山头。到后来与儿父断桥又会，为娘的与儿父再转杭州。为娘的产我儿只得满月，狠心父将为娘就塔内押收！但愿得儿夫妻天长地久，天长地久，我的儿吓……但愿得儿夫妻到老百头。切莫学儿的父心如禽兽，切莫学儿的父无义无情！"
        },
        {
          "type": "dialogue",
          "speaker": "塔神",
          "mode": "内白",
          "content": "白氏仙姑回避了！"
        },
        {
          "type": "lyric",
          "speaker": "白素贞",
          "mode": "反二黄慢板",
          "content": "母子们才相逢就要分手，揭谛神呼唤我哪得容留。"
        },
        {
          "type": "dialogue",
          "speaker": "白素贞",
          "mode": "叫头",
          "content": "我儿！"
        },
        {
          "type": "dialogue",
          "speaker": "许仕林",
          "mode": "叫头",
          "content": "母亲！"
        },
        {
          "type": "dialogue",
          "speaker": "白素贞",
          "mode": "叫头",
          "content": "仕林！"
        },
        {
          "type": "dialogue",
          "speaker": "许仕林",
          "mode": "叫头",
          "content": "亲娘！"
        },
        {
          "type": "dialogue",
          "speaker": "白素贞",
          "mode": "叫头",
          "content": "我的儿吓……"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "白素贞下。"
        },
        {
          "type": "dialogue",
          "speaker": "许仕林",
          "mode": "叫头",
          "content": "老娘亲吓！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "许仕林带马，下。"
        }
      ],
      "stats": {
        "line_count": 78,
        "lyric_ratio": 0.62,
        "stage_direction_count": 8
      }
    }
  ]
