  "scenes": [
    {
      "scene_id": 1,
      "title": "鲁肃坐帐",
      "characters_on_stage": [
        "鲁肃",
        "四龙套",
        "四吴将",
        "诸葛亮",
        "赵云"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四龙套同上，鲁肃上。"
        },
        {
          "type": "lyric",
          "speaker": "鲁肃",
          "mode": "引子",
          "content": "身挂帅印，统雄兵，扫荡烟尘。"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "本帅姓鲁名肃，字子敬。前者三江夏口周都督一死，吴侯挂我为帅。今乃周都督开吊之期，尤恐众将前来吊祭。来，伺候了。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四吴将同上。"
        },
        {
          "type": "dialogue",
          "speaker": "四吴将",
          "mode": "白",
          "content": "启禀都督：孔明过江吊祭。"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "哦，孔明过江吊祭。"
        },
        {
          "type": "dialogue",
          "speaker": "四吴将",
          "mode": "白",
          "content": "何不将他拿下，与都督报仇。"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "且慢。想那孔明过江，必有能将跟随，你等看我眼色行事。两厢伺候。退下。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四吴将同下。"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "有请诸葛先生。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮、赵云同上。"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "先生。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "大夫。"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "请坐。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "谢坐。"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "不知先生驾到，未曾远迎，当面恕罪。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "久违教益，如有所忘。"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "此事何劳先生亲自驾临。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "故旧之谊，聊表鄙意。"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "肃真乃钦佩。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "先灵供奉何处？"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "现在后堂。前面带路。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "有劳大夫。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮、鲁肃同下。"
        }
      ],
      "stats": {
        "line_count": 24,
        "lyric_ratio": 0.04,
        "stage_direction_count": 5
      }
    },
    {
      "scene_id": 2,
      "title": "灵堂哭祭",
      "characters_on_stage": [
        "诸葛亮",
        "鲁肃",
        "赵云",
        "四龙套",
        "四吴将",
        "周循"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四龙套同上，诸葛亮、鲁肃、赵云同上。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "见陵寝不由人泪如雨降，想遗容倒叫我寸断肝肠。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "叫哭",
          "content": "哎，都督吓！"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "可怜你钟山秀青年在望，可怜你美英雄一旦夭亡。可怜你兢业业一生空禳，可怜你忙碌碌半世奔忙。实指望灭曹瞒安乐共享，又谁知大数到已作魍魉！"
        },
        {
          "type": "dialogue",
          "speaker": "赵云",
          "mode": "念",
          "content": "呜呼公瑾，不幸夭亡；修短由天，人岂不伤。我心实痛，酹酒一觞；君其有灵，享我蒸尝。从此天下，与谁相商。呜呼痛哉，伏维尚享。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "哎，都督吓！想你英雄盖世，一代传人，贯精忠于日月，秉赤胆于东方，不幸一旦身亡。哎，好不遗恨人也。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "反二黄慢板",
          "content": "你是个创业的忠贞良将，你是个振东方豪杰贤良。谁似你天生成高致雅量，谁似你文武略气宇轩昂？谁似你年弱冠兵权独掌，谁似你兴霸业扶弱抑强？奸曹操统雄兵如风似浪，只唬得众儿郎束手要降。若非你怀大志陈兵相抗，用机谋杀得他弃甲丢枪！到如今少得遂太平景象，转瞬间天不佑大厦断梁。抛得吾孤人儿将谁依傍，将谁依傍？都督吓！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四吴将同上，同打把。鲁肃拦下。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "反二黄原板",
          "content": "抛得吾独一人谁作商量？吾和你好一比伯仲情况，吾和你好一比鸡黍范张。望阴魂鉴吾这虔诚祭享，泪汪汪捧玉樽享受蒸尝。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "念",
          "content": "呜呼公谨，不幸夭亡。呜呼痛哉，伏维尚享！"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "到如今奸曹在你先自丧，抛得吾无前后好不悲伤！"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "哭",
          "content": "吓！"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "思至此只哭的咽喉气丧，"
        },
        {
          "type": "lyric",
          "speaker": "鲁肃",
          "mode": "二黄摇板",
          "content": "见先生只哭得我好悲伤。"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "先生不必啼哭，保重身体要紧。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "咳，看此光景，泪出肺腑，纵有千言万语，一时难禁！"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "破曹之事，仰仗先生。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "列公既以奸曹为念，亮当谨记于心，同力破曹为上。告辞。"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "后帐备得水酒，与先生同饮。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "原当领受，奈公务在身。公谨哪，你若有灵，须鉴吾心哪！"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "心问口口问心牢骚千丈，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四吴将自两边分上。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "有万篇诉不尽腹内悲伤。"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "送先生。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "送千里终须别何劳过让，试看吾一帆风雨洒康庄。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵云、诸葛亮同下。四龙套、周循同上。周循祭灵。"
        },
        {
          "type": "dialogue",
          "speaker": "周循",
          "mode": "白",
          "content": "何人前来吊祭？"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "诸葛先生前来吊祭。"
        },
        {
          "type": "dialogue",
          "speaker": "周循",
          "mode": "白",
          "content": "为何不将他拿下，与我父报仇？"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "他祭了又哭，哭了又祭。"
        },
        {
          "type": "dialogue",
          "speaker": "周循",
          "mode": "白",
          "content": "几时去的？"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "方才去的。"
        },
        {
          "type": "dialogue",
          "speaker": "周循",
          "mode": "白",
          "content": "待我将他赶上！"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "且慢，那孔明用兵如神，又有赵云跟随，若是动手，又恐他变。"
        },
        {
          "type": "dialogue",
          "speaker": "周循",
          "mode": "白",
          "content": "不必拦阻，众将官，追！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四龙套、周循同下。"
        }
      ],
      "stats": {
        "line_count": 62,
        "lyric_ratio": 0.58,
        "stage_direction_count": 6
      }
    },
    {
      "scene_id": 3,
      "title": "路遇庞统",
      "characters_on_stage": [
        "赵云",
        "诸葛亮",
        "庞统"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵云、诸葛亮同上。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "笑",
          "content": "哈哈哈……"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "非是我笑他人无有志量，怎知我袖儿里暗有形藏。遇不着智谋人心中惆怅，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "庞统上。"
        },
        {
          "type": "lyric",
          "speaker": "庞统",
          "mode": "西皮摇板",
          "content": "纵有那托天手难逃我掌。"
        },
        {
          "type": "dialogue",
          "speaker": "庞统",
          "mode": "白",
          "content": "好吓，你将我周都督气死，来到灵前，假意吊孝，明欺我东吴无人。来来来，我与你分个上下。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "吓，原来是凤雏先生！"
        },
        {
          "type": "dialogue",
          "speaker": "庞统、诸葛亮",
          "mode": "同笑",
          "content": "哈哈哈……"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "吓，凤雏，我量你计谋不能尽用，足下何不投一明君，不负生平所愿。"
        },
        {
          "type": "dialogue",
          "speaker": "庞统",
          "mode": "白",
          "content": "我意欲投一明君，没有引见之人。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "先生吓，吾今此来，实为老兄。吾观孙仲谋，不能重用足下。吾主宽仁厚义，不负生平所学。我已修下荐书，趁便既往荆州，共扶汉业，名垂千古，岂不美哉？"
        },
        {
          "type": "dialogue",
          "speaker": "庞统",
          "mode": "白",
          "content": "多蒙先生举荐，我当照行。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "内呐喊声。"
        },
        {
          "type": "dialogue",
          "speaker": "庞统",
          "mode": "白",
          "content": "哎呀，后面尘土冲天，东吴追兵来也。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "不妨，我自有敌他之兵。"
        },
        {
          "type": "dialogue",
          "speaker": "庞统",
          "mode": "白",
          "content": "后日再叙，告辞了。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "请。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "庞统下。"
        }
      ],
      "stats": {
        "line_count": 28,
        "lyric_ratio": 0.25,
        "stage_direction_count": 4
      }
    },
    {
      "scene_id": 4,
      "title": "江边拒追",
      "characters_on_stage": [
        "诸葛亮",
        "赵云",
        "张飞",
        "周循",
        "鲁肃",
        "四龙套"
      ],
      "segments": [
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "想人生荣与枯得失难量，际风云显奇谋姓字名扬。远望着白泛泛滔天波浪，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "张飞上。"
        },
        {
          "type": "lyric",
          "speaker": "张飞",
          "mode": "西皮摇板",
          "content": "张翼德驾小舟迎接先生。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "搭了扶手。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮、赵云同上船。周循、鲁肃、四龙套同上。"
        },
        {
          "type": "dialogue",
          "speaker": "周循",
          "mode": "白",
          "content": "舟中敢是诸葛先生？"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "然也。你乃何人？"
        },
        {
          "type": "dialogue",
          "speaker": "周循",
          "mode": "白",
          "content": "俺乃周都督之子，名唤周循。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "到此何干？"
        },
        {
          "type": "dialogue",
          "speaker": "周循",
          "mode": "白",
          "content": "闻得先生前来吊祭，特地前来谢孝。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "既为谢孝而来，为何持戈相向？"
        },
        {
          "type": "dialogue",
          "speaker": "周循",
          "mode": "白",
          "content": "这个……请先生过船，有话相商。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "吾要过船，这恐怕小性命，也要随你父去也。"
        },
        {
          "type": "dialogue",
          "speaker": "周循",
          "mode": "白",
          "content": "众将官，杀！"
        },
        {
          "type": "dialogue",
          "speaker": "张飞",
          "mode": "白",
          "content": "呔！我把你这小奴才，来在长江追杀奠客，本当一箭将你杀死，念你乃是犯孽身重之人，便宜你这王八肏的！三军的催舟。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "大夫！"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "哦，先生。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "笑",
          "content": "哈哈哈……"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "张飞、赵云、诸葛亮同下。"
        },
        {
          "type": "dialogue",
          "speaker": "周循",
          "mode": "白",
          "content": "且住。今日到被他们羞辱一场，待我投江一死罢！"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "且慢。你我回至柴桑，整顿人马，再与都督报仇！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "众人同下。"
        }
      ],
