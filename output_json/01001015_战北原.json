  "scenes": [
    {
      "scene_id": 1,
      "title": "诸葛升帐纳降",
      "characters_on_stage": [
        "四红龙套",
        "诸葛亮",
        "报子",
        "赵云",
        "马岱",
        "关兴",
        "张苞",
        "郑文"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四红龙套同上，诸葛亮上。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮慢板",
          "content": "想当初在隆中排分八卦，闲无事听鸟音观看山花。驾孤舟游廊院许多潇洒，甚比那红尘中富贵荣华。先帝爷三请我才把山下，论阴阳如反掌扶保汉家。这几日未出兵未把仗打，司马懿他笑我必然怕他。选一个黄道日发动人马，定中原扫北魏归复汉家。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "报子上。"
        },
        {
          "type": "dialogue",
          "speaker": "报子",
          "mode": "白",
          "content": "启禀丞相：司马营中来了一将，名唤郑文，前来投降。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "再探！"
        },
        {
          "type": "dialogue",
          "speaker": "报子",
          "mode": "白",
          "content": "遵命。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "报子下。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "来！"
        },
        {
          "type": "dialogue",
          "speaker": "四红龙套",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "传众将进帐。"
        },
        {
          "type": "dialogue",
          "speaker": "四红龙套",
          "mode": "白",
          "content": "众位将军进帐。"
        },
        {
          "type": "dialogue",
          "speaker": "赵云、马岱、关兴、张苞",
          "mode": "白",
          "content": "来也！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵云、马岱、关兴、张苞同上。"
        },
        {
          "type": "dialogue",
          "speaker": "赵云、马岱、关兴、张苞",
          "mode": "白",
          "content": "参见丞相。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "众位将军少礼。"
        },
        {
          "type": "dialogue",
          "speaker": "赵云、马岱、关兴、张苞",
          "mode": "白",
          "content": "丞相唤末将等进帐，有何军情议论？"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "适才探子报到，司马懿营中来了一将，名唤郑文，前来投降。他是何人？"
        },
        {
          "type": "dialogue",
          "speaker": "赵云、马岱、关兴、张苞",
          "mode": "白",
          "content": "闻得那司马懿营中，新收一将，名唤郑文。此人武艺高强，丞相须要小心一二。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "原来如此。来！"
        },
        {
          "type": "dialogue",
          "speaker": "四红龙套",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "击鼓升帐。传郑文进帐。"
        },
        {
          "type": "dialogue",
          "speaker": "四红龙套",
          "mode": "白",
          "content": "传郑文进帐。"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "来也！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "郑文上。"
        },
        {
          "type": "lyric",
          "speaker": "郑文",
          "mode": "西皮快板",
          "content": "昔日里伍子胥临潼会下，都只为杀父难奔走天涯。到后来将平王鞭尸亡下，可算得奇男子做事不差。来至在汉营地离鞍下马，营门外摆刀枪剑戟如麻。我这里将腰中宝剑摘下。"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "郑文告进！"
        },
        {
          "type": "lyric",
          "speaker": "郑文",
          "mode": "西皮快板",
          "content": "他那里问一言再把话答。"
        },
        {
          "type": "dialogue",
          "speaker": "赵云、马岱、关兴、张苞",
          "mode": "白",
          "content": "生将跪帐。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "见一将跪帐前身体高大。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "郑文哭。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "两眼中止不住珠泪如麻。问来将因甚事反背司马，表你的名和姓哪里有家？"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "丞相吓！"
        },
        {
          "type": "lyric",
          "speaker": "郑文",
          "mode": "西皮快板",
          "content": "家住在山西地太山脚下，我的名叫郑文幼习枪法。都只为劝司马反被责打，功劳簿勾了名不用某家。望丞相开大恩收留帐下，俺郑文秉忠心答报汉家。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "人道那司马懿才学高大，看起来英雄辈把事做差。见过我蜀营将请坐叙话，待山人奏幼主定把功加。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "报子上。"
        },
        {
          "type": "dialogue",
          "speaker": "报子",
          "mode": "白",
          "content": "启禀丞相：司马懿营中又来一将，名叫秦朗，前来讨战。单要郑将军出马，特来报知。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "再探！"
        },
        {
          "type": "dialogue",
          "speaker": "报子",
          "mode": "白",
          "content": "得令。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "报子下。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "郑将军。"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "丞相。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "司马懿营中又来一将，名叫秦朗，他是何人？"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "启禀丞相，此人乃司马懿营中前部先锋，武艺高强，丞相不可轻敌于他。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "原来如此。待山人差一能将前去对敌。"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "丞相且慢。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "郑将军为何阻令？"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "末将蒙丞相收留，未有尺寸之功。丞相发下一令，待末将生擒秦朗进帐，以为进身之功。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "好，就让郑将军立一头功。"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "多谢丞相！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵云、马岱、关兴、张苞同喝，郑文下。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "笑",
          "content": "哈哈哈……"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "看起来我主爷洪福天大，收此将好一比猛虎长牙。待山人观阵图众将退下。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵云、马岱、关兴、张苞同下。车夫上，车夫推诸葛亮上山。车夫下。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "看郑文与秦朗怎样杀法。"
        }
      ],
      "stats": {
        "line_count": 82,
        "lyric_ratio": 0.48,
        "stage_direction_count": 9
      }
    },
    {
      "scene_id": 2,
      "title": "郑文斩秦朗",
      "characters_on_stage": [
        "诸葛亮",
        "郑文",
        "秦朗"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "郑文、秦朗自两边分上。"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "胆大秦朗，赶来则甚？"
        },
        {
          "type": "dialogue",
          "speaker": "秦朗",
          "mode": "白",
          "content": "奉了都督将令，前来取尔的首级！"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "看枪！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "秦朗死。"
        },
        {
          "type": "lyric",
          "speaker": "郑文",
          "mode": "西皮摇板",
          "content": "哗啦啦金枪如戏耍，无知匹夫染黄沙。下马来将尔的人头割下。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "郑文下马，杀头。秦朗下。"
        },
        {
          "type": "lyric",
          "speaker": "郑文",
          "mode": "西皮摇板",
          "content": "见了那诸葛亮定把功加。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "郑文下。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "啊！"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "他二人见了面双枪并架，未战那三两合就把他杀。莫不是司马懿叫他行诈？"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "不错，是的。回营。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "车夫上。车夫推诸葛亮下山。车夫下。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "等郑文回营来仔细盘查。"
        }
      ],
      "stats": {
        "line_count": 21,
        "lyric_ratio": 0.43,
        "stage_direction_count": 5
      }
    },
    {
      "scene_id": 3,
      "title": "盘查郑文定计",
      "characters_on_stage": [
        "诸葛亮",
        "郑文",
        "赵云",
        "马岱",
        "关兴",
        "张苞",
        "旗牌",
        "四红龙套"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "郑文上。"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "斩来秦朗首级献上。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "郑将军头功，号令辕门。请坐。"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "谢坐。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "郑将军。"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "丞相。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "司马懿营中，有几个秦朗？"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "司马懿营中一个秦朗，被末将斩首，并无第二。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "吓，并无第二。哈哈哈……郑将军，你这何苦吓！"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮原板",
          "content": "我本是卧龙岗一道家，凭阴阳和八卦扶保汉家。适才间斩秦朗多有劳驾，我在那祁山下活活地笑煞。"
        },
        {
          "type": "lyric",
          "speaker": "郑文",
          "mode": "西皮原板",
          "content": "有郑文在帐中躬身叙话，尊一声老丞相细听根芽：小秦朗他虽然武艺高大，将在谋，哪在勇，我将他来杀。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮原板",
          "content": "你道那小秦朗武艺高大，未战那三两合就把他杀。莫不是司马懿叫你来行诈。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "如何？"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮原板",
          "content": "瞒得过我诸葛亮瞒不过他。"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "丞相。"
        },
        {
          "type": "lyric",
          "speaker": "郑文",
          "mode": "西皮摇板",
          "content": "斩了那小秦朗功劳甚大，进帐来你为何苦苦的盘查？"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "大胆！哼哼哼……"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵云、马岱、关兴、张苞自两边分上。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮二六板",
          "content": "在帐中说与你一派好话，谁叫你满口中胡言乱答。这几天在营中未把仗打，我把那司马懿当作小娃。诸葛亮兴人马谁人不怕，许多的有名将俱被我杀。我劝你在此间说了实话，待山人奏幼主定把你功加；你若是满口中胡言乱答，一霎时传将令定把你的头杀。谁不知诸葛亮会算八卦，我服尔的好大胆，敢在那虎口拔牙！"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "真真的大胆！"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "呀！"
        },
        {
          "type": "lyric",
          "speaker": "郑文",
          "mode": "西皮快板",
          "content": "听他言唬得我心中害怕，猜破了苦肉计胆战如麻。早知道诸葛亮会算八卦，些小的诈降计怎能瞒他？到如今顾不得老将司马。"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "司马懿，我顾不得你了！"
        },
        {
          "type": "lyric",
          "speaker": "郑文",
          "mode": "西皮快板",
          "content": "尊一声老丞相细听根芽：适才间斩秦朗俱都是假，望丞相开大恩免去斩杀。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "郑将军你既然讲了实话，待山人奏幼主定把功加。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "郑将军，你与司马懿定下何计，前来诈降？"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "我与司马懿定下苦肉之计。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "何为苦肉之计？"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "恐丞相见疑，将某责打，赶出不用，前来诈降。丞相若是重用，修书一封，下在司马懿营中，叫他三更时分前来偷营劫寨。某将作一内应，杀丞相一个里应外合。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "我们何不与他个计上加计？"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "何为计上加计？"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "就烦郑将军修书一封，叫他三更时分前来偷营劫寨。我营早作一准备，纵然擒不住司马懿，也要杀他个片甲不归。"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "这个……末将愿写。“郑文顿首拜”……"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "〖牌子〗。郑文写信。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "传旗牌。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "旗牌上。"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "参见丞相。有何差遣？"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "郑将军有差。"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "郑将军有何差遣？"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "这有书信一封，命你到司马懿营中，叫他照书行事。"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "遵命。"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "我今吩咐你。"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "怎敢步迟埃！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "旗牌下。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "来！"
        },
        {
          "type": "dialogue",
          "speaker": "赵云、马岱、关兴、张苞",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "将他绑了！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵云、马岱、关兴、张苞同绑郑文。"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "丞相为何将末将绑了？"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "郑将军暂受一时捆绑，等山人擒住那司马懿，再来发放于你。"
        },
        {
          "type": "dialogue",
          "speaker": "郑文",
          "mode": "白",
          "content": "诸葛亮吓，诸葛孔明！你好狠毒也！"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "押下去。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵云、马岱、关兴、张苞押郑文同下。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "笑",
          "content": "哈哈哈……"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "人道司马有才学，做事全然不揣摩。诈降之计错又错，须小计怎瞒得我南阳诸葛？"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四红龙套、诸葛亮同下。"
        }
      ],
      "stats": {
        "line_count": 95,
        "lyric_ratio": 0.42,
        "stage_direction_count": 7
      }
    }
  ]
