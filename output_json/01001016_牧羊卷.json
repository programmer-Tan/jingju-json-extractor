  "scenes": [
    {
      "scene_id": 1,
      "title": "坟台哭祭",
      "characters_on_stage": [
        "衙役甲",
        "衙役乙",
        "中军",
        "宋氏",
        "朱春登",
        "朱春科"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "二衙役同上"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "同白",
          "content": "哽唬！"
        },
        {
          "type": "lyric",
          "speaker": "衙役甲",
          "mode": "念",
          "content": "为人莫当差"
        },
        {
          "type": "lyric",
          "speaker": "衙役乙",
          "mode": "念",
          "content": "当差不自在"
        },
        {
          "type": "lyric",
          "speaker": "衙役甲",
          "mode": "念",
          "content": "风里他要去"
        },
        {
          "type": "lyric",
          "speaker": "衙役乙",
          "mode": "念",
          "content": "雨里也要来"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "白",
          "content": "伙计请了。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役乙",
          "mode": "白",
          "content": "请了。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "白",
          "content": "奉了侯爷之命，打扫坟台，就此前往。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役乙",
          "mode": "白",
          "content": "请。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "二衙役同打扫，奏小吹打"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "同白",
          "content": "有请侯爷！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "中军上"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "可曾打扫干净？"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "白",
          "content": "打扫干净。"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "下面伺候。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "二衙役同下"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "有请侯爷！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "宋氏上"
        },
        {
          "type": "dialogue",
          "speaker": "宋氏",
          "mode": "白",
          "content": "哎呀，我的嫂子吓！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "朱春登、朱春科同上"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "娘吓！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "朱春登叩头，起"
        },
        {
          "type": "lyric",
          "speaker": "朱春登",
          "mode": "二黄导板",
          "content": "见坟台不由儿肝肠痛断，"
        },
        {
          "type": "lyric",
          "speaker": "朱春登",
          "mode": "三叫头",
          "content": "母亲，锦堂，哎，妻吓！"
        },
        {
          "type": "lyric",
          "speaker": "朱春登",
          "mode": "回龙",
          "content": "尊一声去世娘细听儿言："
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "中军、朱春科、宋氏自两边分下"
        },
        {
          "type": "lyric",
          "speaker": "朱春登",
          "mode": "反二黄慢板",
          "content": "都只为西施国黄龙造反，你孩儿替叔父去到军前。多蒙神赐孩儿三枝神箭，因此去灭西施扫尽狼烟。奉圣命回家来母子相见，又谁知儿的娘命丧黄泉。哭老娘只哭得肝肠痛断，肝肠痛断，儿的娘吓！儿还吃什么爵禄做的什么官？哭罢了老娘亲把妻来叹，叫一声贤德妻你在哪边？我和你恩爱妻不能相见，不能相见，夫妻们要相逢梦里团圆。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "中军、朱春科、宋氏同上"
        },
        {
          "type": "dialogue",
          "speaker": "宋氏",
          "mode": "白",
          "content": "大相公算了吧，不用哭了！"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "中军，"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "看冠诘伺候。"
        },
        {
          "type": "dialogue",
          "speaker": "宋氏",
          "mode": "白",
          "content": "吓，冠诘在。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "母亲，孩儿平西有功，挣来冠诘，怎的不来穿，怎的不来戴？婶娘，"
        },
        {
          "type": "dialogue",
          "speaker": "宋氏",
          "mode": "白",
          "content": "大相公。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "侄儿挣来冠诘，请来穿戴。"
        },
        {
          "type": "dialogue",
          "speaker": "宋氏",
          "mode": "白",
          "content": "这是你母亲、媳妇穿戴的，我怎么好穿？"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "她婆媳么，无有福分的了。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春科",
          "mode": "白",
          "content": "你就穿戴起来吧。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "二衙役同上，奏大吹打，宋氏穿行头下"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "贤弟，"
        },
        {
          "type": "dialogue",
          "speaker": "朱春科",
          "mode": "白",
          "content": "兄长。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "你伯母、婶娘一死，愚兄不愿在朝为官，情愿入山修炼。贤弟意下如何？"
        },
        {
          "type": "dialogue",
          "speaker": "朱春科",
          "mode": "白",
          "content": "但凭兄长。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "中军，"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "侯爷不愿为官，入山修道，在此高搭席棚，拾饭七天，七天为满。如有贫苦之人前来讨饭，不许为难他们；如若难为他们，打断你们狗腿，记下了！"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "是。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "下去。可叹义母亡故早，"
        },
        {
          "type": "dialogue",
          "speaker": "朱春科",
          "mode": "白",
          "content": "怎不叫人泪双抛？"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "娘吓！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "朱春登、朱春科同下"
        }
      ],
      "stats": {
        "line_count": 82,
        "lyric_ratio": 0.28,
        "stage_direction_count": 12
      }
    },
    {
      "scene_id": 2,
      "title": "席棚乞食",
      "characters_on_stage": [
        "中军",
        "衙役甲",
        "衙役乙",
        "朱母",
        "赵锦堂",
        "龙套",
        "朱春登"
      ],
      "segments": [
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "来！"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "同白",
          "content": "是。"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "侯爷传话出来：在此高搭席棚，拾饭七天，七天为满。如有贫苦之人前来讨饭，不许为难他们；如若难为他们，打折你们狗腿，记下了！"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "同白",
          "content": "是。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "白",
          "content": "送二爷。"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "免。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "中军下"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "白",
          "content": "伙计，咱们吆喝起来！咳，有要饭的，到这里来吓！"
        },
        {
          "type": "dialogue",
          "speaker": "朱母",
          "mode": "内白",
          "content": "苦吓！"
        },
        {
          "type": "lyric",
          "speaker": "朱母",
          "mode": "二黄导板",
          "content": "月儿弯弯照九州，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "朱母、赵锦堂同上"
        },
        {
          "type": "lyric",
          "speaker": "赵锦堂",
          "mode": "二黄摇板",
          "content": "婆媳讨饭在外游。"
        },
        {
          "type": "lyric",
          "speaker": "朱母",
          "mode": "二黄摇板",
          "content": "害得我婆媳们无路可走，"
        },
        {
          "type": "lyric",
          "speaker": "赵锦堂",
          "mode": "二黄摇板",
          "content": "但不知何日里才得出头。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "朱母哭"
        },
        {
          "type": "dialogue",
          "speaker": "朱母",
          "mode": "白",
          "content": "媳妇，为娘肚中饥饿，如何是好？"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "吓，婆婆，那旁有高搭席棚，不知哪位大老爷，在此拾饭。待媳妇前去讨饭，好与婆婆充饥。那旁有一土台，婆婆请坐了。"
        },
        {
          "type": "dialogue",
          "speaker": "朱母",
          "mode": "白",
          "content": "媳妇，你前去要来，为婆的好充饥。"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "二位将爷，贫妇有礼。"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "同白",
          "content": "干什么的？"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "我有八旬婆母，三餐未曾用饭，望二位爷可怜，有残茶冷饭赏与我一碗半碗，好与婆婆充饥。"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "同白",
          "content": "你要饭的不看时候。早饭已过，午饭未到。明天来，一齐都把你！"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "人不在时中，讨饭都误了时候了。"
        },
        {
          "type": "dialogue",
          "speaker": "朱母",
          "mode": "哭",
          "content": "饿坏了……"
        },
        {
          "type": "lyric",
          "speaker": "赵锦堂",
          "mode": "二黄摇板",
          "content": "我哭，哭一声二军爷，叫，叫一声二军官。我有八旬婆婆，三餐未曾用饭，望二位爷赏一碗半碗，周济贫寒。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "赵锦堂跪下"
        },
        {
          "type": "lyric",
          "speaker": "赵锦堂",
          "mode": "哭板",
          "content": "吓吓吓，二军官吓……"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "衙役甲哭"
        },
        {
          "type": "dialogue",
          "speaker": "衙役乙",
          "mode": "白",
          "content": "你替人家哭什么？"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "白",
          "content": "你听见没有？人家有八十三岁一个老羊，"
        },
        {
          "type": "dialogue",
          "speaker": "衙役乙",
          "mode": "白",
          "content": "吓，老娘吓！"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "白",
          "content": "三年没有用饭。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役乙",
          "mode": "白",
          "content": "吓，三餐没有用饭。你看要饭的苦得可怜，我们请二爷出来商议商议。有请二爷！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "中军上"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "何事？"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "白",
          "content": "外面来了二个贫妇，前来要饭。"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "你说“早饭已过，午饭未到”。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "白",
          "content": "小人们也是这样说，她苦苦哀求。请二爷出来，行个方便。她说有八十多岁的老母，"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "咳。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "白",
          "content": "三年未曾用饭。"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "哽，三餐。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "白",
          "content": "吓，是三餐。你老到厨房下去瞧瞧，与她们一碗半碗，你不是修行积德，修得你代代当二爷。"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "哽，王八养的！看她们造化。厨房下可有残茶剩饭？"
        },
        {
          "type": "dialogue",
          "speaker": "厨房",
          "mode": "内白",
          "content": "侯爷思想老太太，吃不下去，剩了半碗冷饭，拿去充饥。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "中军接碗"
        },
        {
          "type": "dialogue",
          "speaker": "厨房",
          "mode": "内白",
          "content": "转来，小心侯爷的碗！"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "侯爷思想老太太，吞吃不下，剩下半碗冷饭，拿去充饥。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "衙役甲接碗"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "转来，小心侯爷的碗！"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "白",
          "content": "是。伙计，你看碗里还有肉团子，待我吃了吧！"
        },
        {
          "type": "dialogue",
          "speaker": "衙役乙",
          "mode": "白",
          "content": "你没有开过眼，待我来喝点汤。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "白",
          "content": "我也不吃团子，你也来喝汤。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役乙",
          "mode": "白",
          "content": "我尝尝。要饭的，侯爷思想老太太，剩下半碗冷饭，拿去充饥。"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "放在地下。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役乙",
          "mode": "白",
          "content": "伙计，你看要饭的还有许多规矩。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "赵锦堂取碗"
        },
        {
          "type": "dialogue",
          "speaker": "衙役乙",
          "mode": "白",
          "content": "吓，小心侯爷的碗！"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "知道了。吓，婆婆，媳妇要来半碗残饭，婆婆请用吧！"
        },
        {
          "type": "dialogue",
          "speaker": "朱母",
          "mode": "白",
          "content": "媳妇你呢？"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "媳妇还不饿。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "赵锦堂看"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "且住，看此处好像我家坟茔，哪个大胆在此拾饭？待我禀告婆婆知道。吓，看此处好像我家坟茔，不知何人在此拾饭？"
        },
        {
          "type": "dialogue",
          "speaker": "朱母",
          "mode": "白",
          "content": "媳妇怎样晓得？"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "媳妇过门，上坟祭祖，见有双槐树为证。"
        },
        {
          "type": "dialogue",
          "speaker": "朱母",
          "mode": "白",
          "content": "你记得清？"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "记得清。"
        },
        {
          "type": "dialogue",
          "speaker": "朱母",
          "mode": "白",
          "content": "见得明？"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "见得明。"
        },
        {
          "type": "dialogue",
          "speaker": "朱母",
          "mode": "白",
          "content": "待我看来。"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "同白",
          "content": "别在那边偷看，踢了水盆子。出去出去！"
        },
        {
          "type": "dialogue",
          "speaker": "朱母",
          "mode": "白",
          "content": "我们看看就走。"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "同白",
          "content": "放着饭不吃，跑到这里看坟！"
        },
        {
          "type": "lyric",
          "speaker": "朱母",
          "mode": "叫板",
          "content": "见灵堂不由人两泪汪汪，我婆媳只落得这样下场！哭一声祖先爷你在哪厢？"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "朱母出门，失手打碗"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "唬！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "龙套自两边分上"
        },
        {
          "type": "dialogue",
          "speaker": "龙套",
          "mode": "同白",
          "content": "哦！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "朱春登上"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "中军！"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "外面何事喧哗？"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "启禀侯爷，外面来了一老一少两个贫妇前来讨饭。早饭已过，午饭未到，侯爷思想老太太，吃不下的半碗剩饭，与她们充饥。谁想她们自不小心，将侯爷的碗摔碎了！"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "唗！适才怎样吩咐与你？叫你不要难为她们，想是尔等难为于她。来，扯下去打！"
        },
        {
          "type": "dialogue",
          "speaker": "龙套",
          "mode": "同白",
          "content": "哦！"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "啊呀，侯爷，唤进一名问过明白，再责小人也还不迟。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "哽哽哽，罚规一旁！"
        },
        {
          "type": "dialogue",
          "speaker": "衙役乙",
          "mode": "白",
          "content": "二爷这里干净。"
        }
      ],
      "stats": {
        "line_count": 96,
        "lyric_ratio": 0.22,
        "stage_direction_count": 15
      }
    },
    {
      "scene_id": 3,
      "title": "席棚认亲阖家团圆",
      "characters_on_stage": [
        "朱春登",
        "赵锦堂",
        "朱母",
        "中军",
        "朱春科",
        "宋氏",
        "龙套",
        "衙役甲",
        "衙役乙"
      ],
      "segments": [
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "来！"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "传话出去，或老或少，唤进一名，席棚答话。打碗之事一概不究。问话已毕还要周济她们。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "白",
          "content": "是。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "回来。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "不要惊吓于她。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "白",
          "content": "是呀，吃饱了食，困饿了发呆。待我吓她一吓。呀呔！"
        },
        {
          "type": "dialogue",
          "speaker": "朱母",
          "mode": "白",
          "content": "不要惊吓我们。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "白",
          "content": "我告诉你，你把碗也打了，侯爷怒了，二爷跪了，差一点把我们都剐了。里面传话出来，叫你们或老或少，叫进一名。回话已毕还要周济你们。你们老的进去，小的不要进去；小的进去，老的不要进去。不要都进去，不要都进去，我们这里头还跪着一个呢！"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "哎吓，婆婆，里面传话出来，或老或少，进去一名，席棚答话。问话已毕还要周济我们。还是你进去吧。"
        },
        {
          "type": "dialogue",
          "speaker": "朱母",
          "mode": "白",
          "content": "吓吓，媳妇，为婆说话不明，听话不准，还是你进去吧。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "白",
          "content": "这老奸巨滑，吃饭有她，回话她就不去。"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "是，媳妇前去。"
        },
        {
          "type": "dialogue",
          "speaker": "龙套",
          "mode": "同白",
          "content": "哦！"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "哎吓，婆婆，里面喊叫连声，有些害怕，还是你进去吧。"
        },
        {
          "type": "dialogue",
          "speaker": "朱母",
          "mode": "白",
          "content": "儿吓，你大胆些进去，他们不难为你便罢，倘若难为与你，为婆拼这老命不要了，与他拼了！"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "白",
          "content": "吃饱了跑这里来拼命了！"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "是，媳妇前去。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役甲",
          "mode": "白",
          "content": "贫妇告进！"
        },
        {
          "type": "dialogue",
          "speaker": "龙套",
          "mode": "同白",
          "content": "哦！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "赵锦堂跪下"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "参见侯爷。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "那一贫妇为何不抬头？"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "有罪不敢抬头。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "恕你无罪。"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "谢侯爷。"
        },
        {
          "type": "dialogue",
          "speaker": "龙套",
          "mode": "白",
          "content": "哦！"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登、赵锦堂",
          "mode": "同白",
          "content": "哎吓，且住，看这（贫妇）（侯爷），好像我（妻）（丈夫）模样，婶娘道（她）（他），（婆媳）（阵前）已死，怎么（她、她、她）（他、他、他）还在！"
        },
        {
          "type": "dialogue",
          "speaker": "龙套",
          "mode": "同白",
          "content": "哦！"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登、赵锦堂",
          "mode": "同白",
          "content": "既是我（妻）（夫）到此，理当相认。哎吓，我的（妻）（夫）！"
        },
        {
          "type": "dialogue",
          "speaker": "龙套",
          "mode": "同白",
          "content": "哦！"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登、赵锦堂",
          "mode": "同白",
          "content": "错认（民妻）（官长），那还了得。这、这、这便怎么处？嗳，我自有道理。"
        },
        {
          "type": "dialogue",
          "speaker": "龙套",
          "mode": "同白",
          "content": "哦！"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "那一贫妇，我手下之人，哪个为难与你？"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "侯爷问的是他？"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "呔！我们手下之人，哪个难为与你？当着侯爷在此，从实讲来。你们讨饭的也要拿出点天地良心来！"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "侯爷，他、他、他是个好人。"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "侯爷开恩。"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "起过一旁。"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "谢侯爷。"
        },
        {
          "type": "dialogue",
          "speaker": "二衙役",
          "mode": "同白",
          "content": "二爷辛苦呢！"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "滚下去！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "二衙役同下"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "那一贫妇，家住哪里，姓甚名谁？从实讲来，不要害怕，我好周济你们。"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "侯爷容禀："
        },
        {
          "type": "lyric",
          "speaker": "赵锦堂",
          "mode": "西皮导板",
          "content": "赵锦堂跪席棚珠泪满面，"
        },
        {
          "type": "dialogue",
          "speaker": "龙套",
          "mode": "同白",
          "content": "哦！"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "两厢退下。"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "两厢退下。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "龙套同允，同下"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "面朝前跪。"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "是。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "中军下"
        },
        {
          "type": "lyric",
          "speaker": "赵锦堂",
          "mode": "西皮慢板",
          "content": "尊侯爷细听我表一表家园："
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "家住哪里？"
        },
        {
          "type": "lyric",
          "speaker": "赵锦堂",
          "mode": "西皮慢板",
          "content": "家住在山东地石合小县，南门外双槐树有我的家园。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "你父何人？"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "中军上"
        },
        {
          "type": "lyric",
          "speaker": "赵锦堂",
          "mode": "西皮慢板",
          "content": "我的父赵都堂官高爵显，"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "哦，你是赵都堂之女。配夫何人？讲。"
        },
        {
          "type": "lyric",
          "speaker": "赵锦堂",
          "mode": "西皮慢板",
          "content": "配儿夫朱春登……"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "看刀！"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "唗！你侯爷在此问话，要你来打搅？还不下去！"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "是。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "中军下"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "那一贫妇，配夫何人？讲。"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "配儿夫朱春登匹配良缘。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "哎呀，且住。听这女子言讲，果然是我妻到此。婶娘道她婆媳已死，怎么她、她、她还在？我自有道理。那一贫妇，你丈夫往哪里去了？"
        },
        {
          "type": "lyric",
          "speaker": "赵锦堂",
          "mode": "西皮原板",
          "content": "都只为西施国黄龙造反，"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "黄龙造反不造反，是国家大事，与你丈夫什么相干？"
        },
        {
          "type": "lyric",
          "speaker": "赵锦堂",
          "mode": "西皮原板",
          "content": "我儿夫替叔父去到阵前。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "你家既有吃粮之人，可有书信回来？"
        },
        {
          "type": "lyric",
          "speaker": "赵锦堂",
          "mode": "西皮原板",
          "content": "有信回我婶娘不容观看，她说道我儿夫命丧军前。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "哎吓，婶娘吓！这就是你大大的不是了。你侄儿在外为官，为何咒骂与我？后来便怎样？讲。"
        },
        {
          "type": "lyric",
          "speaker": "赵锦堂",
          "mode": "西皮原板",
          "content": "此时间我婶娘逼我改嫁，她叫奴嫁宋成结配良缘。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "吓，婶娘，婶娘，想那宋成乃是甚等之人，敢娶都堂侯爷之妻？真真岂有此理！那一贫妇，你从她没有？讲。"
        },
        {
          "type": "lyric",
          "speaker": "赵锦堂",
          "mode": "西皮原板",
          "content": "我不从打我在磨房挨磨，"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "照吓，不从的好，有志气！往下讲。"
        },
        {
          "type": "lyric",
          "speaker": "赵锦堂",
          "mode": "西皮二六板",
          "content": "到后来赶我去牧羊山中。羊吃草我婆媳也把草用，到晚来与群羊一同安眠。每日里到长街前去讨饭，不想到冲撞了侯爷门前。望侯爷开大恩将奴释放，"
        },
        {
          "type": "lyric",
          "speaker": "赵锦堂",
          "mode": "哭板",
          "content": "侯爷吓！"
        },
        {
          "type": "lyric",
          "speaker": "赵锦堂",
          "mode": "西皮二六板",
          "content": "到来世变犬马结草衔环。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "哦！"
        },
        {
          "type": "lyric",
          "speaker": "朱春登",
          "mode": "西皮慢板",
          "content": "听我妻赵锦堂细说一遍，好一似刀割肉箭把心穿。婶娘道她婆媳早把命染，为什么她还在阳世人间？莫不是她死的苦阴魂不散，莫不是魍魉鬼来把我缠。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "那一妇人，你到底是人呢，是鬼？你侯爷是不怕鬼的！"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "我是人，怎么是鬼？"
        },
        {
          "type": "lyric",
          "speaker": "朱春登",
          "mode": "西皮慢板",
          "content": "我这里出席棚用目观看，又只见红日里未落西山。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "朱春登想"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "吓，有了！"
        },
        {
          "type": "lyric",
          "speaker": "朱春登",
          "mode": "西皮慢板",
          "content": "赵锦堂左手上有硃砂红眼，是不是向前去细问一番。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "那一妇人，你是赵都堂之女，左手上有硃砂红眼，你可有么？"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "伸出来，侯爷观看。"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "这个……"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "不要害怕。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "赵锦堂遮脸"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "侯爷请看。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "哎吓，妻吓！"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "侯爷为何这等相称？"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "贤妻不要害怕，我是你丈夫朱春登作官回来了！"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "你是我丈夫作官回来了，当真？"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "当真！"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "果然？"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "果然。"
        },
        {
          "type": "lyric",
          "speaker": "赵锦堂",
          "mode": "哭板",
          "content": "吓吓吓，我的夫吓！"
        },
        {
          "type": "lyric",
          "speaker": "赵锦堂",
          "mode": "西皮摇板",
          "content": "只说是夫妻们不得相见，又谁知今日里又得团圆。"
        },
        {
          "type": "lyric",
          "speaker": "朱春登",
          "mode": "西皮摇板",
          "content": "问贤妻老娘亲现在何处？"
        },
        {
          "type": "lyric",
          "speaker": "赵锦堂",
          "mode": "西皮摇板",
          "content": "老婆婆现在那席棚外边。"
        },
        {
          "type": "lyric",
          "speaker": "朱春登",
          "mode": "西皮摇板",
          "content": "贤妻与我把路带，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "朱母上"
        },
        {
          "type": "lyric",
          "speaker": "朱春登",
          "mode": "西皮摇板",
          "content": "见了老娘说开怀。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "吓，母亲！"
        },
        {
          "type": "dialogue",
          "speaker": "朱母",
          "mode": "白",
          "content": "碎了你的碗，赔你碗就是了。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "吓，母亲不必害怕，我是你儿朱春登作官回来了！"
        },
        {
          "type": "dialogue",
          "speaker": "朱母",
          "mode": "白",
          "content": "当真？"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "当真！"
        },
        {
          "type": "dialogue",
          "speaker": "朱母",
          "mode": "白",
          "content": "果然？"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "果然。"
        },
        {
          "type": "dialogue",
          "speaker": "朱母",
          "mode": "白",
          "content": "吓，儿吓，你作了官了，为娘讨了饭了！"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "看衣衾更换。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "奏牌子，朱母换冠帔，朱春登拜朱母，赵锦堂拜朱母，中军拜朱母"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "不消你拜。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "母亲请上，孩儿叩谢不孝之罪。"
        },
        {
          "type": "dialogue",
          "speaker": "朱母",
          "mode": "白",
          "content": "儿有何罪？儿吓，家中之事，你要与我问个明白。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "孩儿遵命。中军！"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "请你二老爷。"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "有请二老爷。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "朱春科上"
        },
        {
          "type": "lyric",
          "speaker": "朱春科",
          "mode": "念",
          "content": "忽听兄长唤，迈步到跟前。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春科",
          "mode": "白",
          "content": "兄长何事？"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "贤弟，你伯母、嫂嫂，当真亡故了么？"
        },
        {
          "type": "dialogue",
          "speaker": "朱春科",
          "mode": "白",
          "content": "当真亡故了。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "你往上看。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "奏牌子"
        },
        {
          "type": "dialogue",
          "speaker": "朱春科",
          "mode": "白",
          "content": "哎吓，我那伯母、嫂嫂吓！"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "贤弟，你我在朝为官，不能治家，焉能治国？婶娘干出此事，你要与我问明白！"
        },
        {
          "type": "dialogue",
          "speaker": "朱春科",
          "mode": "白",
          "content": "小弟一概不知，待我请出母亲问个明白。有请母亲。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "宋氏上"
        },
        {
          "type": "lyric",
          "speaker": "宋氏",
          "mode": "念",
          "content": "我儿作高官，凤冠霞帔我来穿。"
        },
        {
          "type": "dialogue",
          "speaker": "宋氏",
          "mode": "白",
          "content": "儿吓，请你母亲出来，有何话说？"
        },
        {
          "type": "dialogue",
          "speaker": "朱春科",
          "mode": "白",
          "content": "伯母、嫂嫂，当真亡故了？"
        },
        {
          "type": "dialogue",
          "speaker": "宋氏",
          "mode": "白",
          "content": "当真亡故了。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春科",
          "mode": "白",
          "content": "朝上看来。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "奏牌子"
        },
        {
          "type": "dialogue",
          "speaker": "朱母",
          "mode": "白",
          "content": "我把你这贱人！"
        },
        {
          "type": "dialogue",
          "speaker": "宋氏",
          "mode": "白",
          "content": "打鬼，打鬼！"
        },
        {
          "type": "dialogue",
          "speaker": "朱春科",
          "mode": "白",
          "content": "母亲，儿不在家中，你干出这等事来，叫儿怎样为人？母亲请上，儿谢养育之恩，待我碰死了吧！"
        },
        {
          "type": "dialogue",
          "speaker": "宋氏",
          "mode": "白",
          "content": "儿吓，不必如此。为娘有害她婆媳之心，我就对天盟誓。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春科",
          "mode": "白",
          "content": "前去盟来！"
        },
        {
          "type": "dialogue",
          "speaker": "宋氏",
          "mode": "白",
          "content": "老天在上，我宋氏在下。我要有害她婆媳之心，立刻叫龙抓去！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "奏牌子，龙形上，龙形抓宋氏同下"
        },
        {
          "type": "dialogue",
          "speaker": "朱春科",
          "mode": "哭",
          "content": "哎吓，母亲吓！"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "贤弟不必啼哭，明日请高僧高道，超度婶娘的亡魂便了。中军！"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "朱春登",
          "mode": "白",
          "content": "后堂摆宴，庆贺团圆。"
        },
        {
          "type": "dialogue",
          "speaker": "朱母",
          "mode": "白",
          "content": "儿吓，馋娘去者。正是："
        },
        {
          "type": "lyric",
          "speaker": "朱母",
          "mode": "念",
          "content": "人亏天不亏，"
        },
        {
          "type": "lyric",
          "speaker": "朱春登",
          "mode": "念",
          "content": "善恶有轮回。"
        },
        {
          "type": "lyric",
          "speaker": "赵锦堂",
          "mode": "念",
          "content": "不信抬头看，"
        },
        {
          "type": "dialogue",
          "speaker": "中军",
          "mode": "白",
          "content": "老太太！"
        },
        {
          "type": "lyric",
          "speaker": "中军",
          "mode": "念",
          "content": "苍天饶过谁？"
        },
        {
          "type": "dialogue",
          "speaker": "赵锦堂",
          "mode": "白",
          "content": "好个“苍天饶过谁”！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "众人同下"
        }
      ],
      "stats": {
        "line_count": 172,
        "lyric_ratio": 0.35,
        "stage_direction_count": 21
      }
    }
  ]
}