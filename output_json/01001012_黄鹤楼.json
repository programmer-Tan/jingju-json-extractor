  "scenes": [
    {
      "scene_id": 1,
      "title": "蜀帐议赴宴",
      "characters_on_stage": [
        "刘备",
        "刘封",
        "诸葛亮",
        "赵云",
        "张飞",
        "四红龙套"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四红龙套引刘备同上"
        },
        {
          "type": "lyric",
          "speaker": "刘备",
          "mode": "引子",
          "content": "义得人和，灭孙曹，孤心安乐"
        },
        {
          "type": "lyric",
          "speaker": "刘备",
          "mode": "念",
          "content": "日月重明照英雄，全仗卧龙建奇功。虽得土地观王化，未能遂意高祖风"
        },
        {
          "type": "dialogue",
          "speaker": "刘备",
          "mode": "白",
          "content": "孤，刘备，乃大树楼桑人氏。曾与关、张桃园结义，共破黄巾。弟兄三顾茅庐，请来诸葛先生，累建奇功。孤虽暂住荆州，与东吴未分明白，叫孤常常忧虑。正是："
        },
        {
          "type": "lyric",
          "speaker": "刘备",
          "mode": "念",
          "content": "苍天遂孤意，重整汉帝基"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "刘封上"
        }
      ],
      "stats": {
        "line_count": 132,
        "lyric_ratio": 0.38,
        "stage_direction_count": 28
      }
    },
    {
      "scene_id": 2,
      "title": "吴帐定计",
      "characters_on_stage": [
        "周瑜",
        "甘宁",
        "四白龙套"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四白龙套引周瑜同上"
        },
        {
          "type": "lyric",
          "speaker": "周瑜",
          "mode": "西皮摇板",
          "content": "水军冲破长江浪，对对儿郎武艺强。刘备中计命必丧，讨回荆州取襄阳"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "甘宁上"
        }
      ],
      "stats": {
        "line_count": 24,
        "lyric_ratio": 0.29,
        "stage_direction_count": 7
      }
    },
    {
      "scene_id": 3,
      "title": "江口相会",
      "characters_on_stage": [
        "刘备",
        "赵云",
        "周瑜",
        "甘宁",
        "四白龙套",
        "船夫"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四红水手、船夫引赵云同上。四水手、船夫引甘宁自下场门同上"
        },
        {
          "type": "dialogue",
          "speaker": "赵云",
          "mode": "白",
          "content": "有请主公"
        },
        {
          "type": "dialogue",
          "speaker": "甘宁",
          "mode": "白",
          "content": "有请都督"
        }
      ],
      "stats": {
        "line_count": 36,
        "lyric_ratio": 0.12,
        "stage_direction_count": 9
      }
    },
    {
      "scene_id": 4,
      "title": "黄鹤楼设宴",
      "characters_on_stage": [
        "刘备",
        "赵云",
        "周瑜",
        "鲁肃",
        "甘宁"
      ],
      "segments": [
