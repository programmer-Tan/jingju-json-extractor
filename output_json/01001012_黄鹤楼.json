          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "鲁肃上"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "摆宴。有请都督"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "〖吹打〗。刘备、赵云、周瑜同上"
        }
      ],
      "stats": {
        "line_count": 42,
        "lyric_ratio": 0.15,
        "stage_direction_count": 11
      }
    },
    {
      "scene_id": 5,
      "title": "楼上交锋",
      "characters_on_stage": [
        "刘备",
        "赵云",
        "周瑜",
        "鲁肃",
        "四白龙套"
      ],
      "segments": [
        {
          "type": "dialogue",
          "speaker": "周瑜",
          "mode": "白",
          "content": "鲁大夫下楼，料理军务去吧"
        },
        {
          "type": "dialogue",
          "speaker": "鲁肃",
          "mode": "白",
          "content": "遵命。皇叔少刻奉陪"
