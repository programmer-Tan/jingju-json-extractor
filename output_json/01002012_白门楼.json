  "scenes": [
    {
      "scene_id": 1,
      "title": "辕门候令",
      "characters_on_stage": [
        "刘备",
        "关羽",
        "张飞",
        "龙套"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四小军、刘备、关羽、张飞同上。"
        },
        {
          "type": "dialogue",
          "speaker": "刘备",
          "mode": "念",
          "content": "桃园义气结金兰，"
        },
        {
          "type": "dialogue",
          "speaker": "关羽、张飞",
          "mode": "同念",
          "content": "保定汉室锦家邦。"
        },
        {
          "type": "dialogue",
          "speaker": "关羽、张飞",
          "mode": "同白",
          "content": "大哥，"
        },
        {
          "type": "dialogue",
          "speaker": "刘备",
          "mode": "白",
          "content": "贤弟，丞相发兵徐州，二位贤弟，同到辕门候令。"
        },
        {
          "type": "dialogue",
          "speaker": "关羽、张飞",
          "mode": "同白",
          "content": "大哥请。带马。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "众人同下。"
        }
      ],
      "stats": {
        "line_count": 7,
        "lyric_ratio": 0.0,
        "stage_direction_count": 2
      }
    },
    {
      "scene_id": 2,
      "title": "曹营发兵",
      "characters_on_stage": [
        "李典",
        "乐进",
        "许褚",
        "曹洪",
        "曹操",
        "刘备",
        "关羽",
        "张飞",
        "龙套"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "李典、乐进、许褚、曹洪同上，同起霸。"
        },
        {
          "type": "lyric",
          "speaker": "李典、乐进、许褚、曹洪",
          "mode": "点绛唇",
          "content": "杀气英豪，儿郎虎豹，军威号，地动山摇，要把狼烟扫。"
        },
        {
          "type": "dialogue",
          "speaker": "李典",
          "mode": "白",
          "content": "李典。"
        },
        {
          "type": "dialogue",
          "speaker": "乐进",
          "mode": "白",
          "content": "乐进。"
        },
        {
          "type": "dialogue",
          "speaker": "许褚",
          "mode": "白",
          "content": "许褚。"
        },
        {
          "type": "dialogue",
          "speaker": "曹洪",
          "mode": "白",
          "content": "曹洪。"
        },
        {
          "type": "dialogue",
          "speaker": "李典",
          "mode": "白",
          "content": "众位将军请了。"
        },
        {
          "type": "dialogue",
          "speaker": "乐进、许褚、曹洪",
          "mode": "同白",
          "content": "请了。"
        },
        {
          "type": "dialogue",
          "speaker": "李典",
          "mode": "白",
          "content": "丞相攻取徐州，你我两厢伺候。"
        },
        {
          "type": "dialogue",
          "speaker": "乐进、许褚、曹洪",
          "mode": "同白",
          "content": "请。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四红龙套引曹操同上。刘备、关羽、张飞同上。"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "引子",
          "content": "忆昔扶汉朝，威风把名标。"
        },
        {
          "type": "dialogue",
          "speaker": "众人",
          "mode": "同白",
          "content": "参见丞相。"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "众位将军少礼。"
        },
        {
          "type": "dialogue",
          "speaker": "众人",
          "mode": "同白",
          "content": "谢丞相。"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "念",
          "content": "汉室空有主，兵权吾为先。怀志冲霄汉，横行宇宙间。"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "老夫曹操。今奉天子明诏，带领人马，扫荡徐州，可恨吕布战又不战，降又不降，使君妙计安在？"
        },
        {
          "type": "dialogue",
          "speaker": "刘备",
          "mode": "白",
          "content": "请丞相发令，备当协力攻打徐州。"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "好，就命使君带领众将，攻打徐州，捉拿吕布满门，不得有误。"
        },
        {
          "type": "dialogue",
          "speaker": "刘备",
          "mode": "白",
          "content": "得令。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "刘备、关羽、张飞同下。"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "众位将军，"
        },
        {
          "type": "dialogue",
          "speaker": "众人",
          "mode": "同白",
          "content": "在。"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "兵发徐州。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "〖牌子〗。众人同下。"
        }
      ],
      "stats": {
        "line_count": 25,
        "lyric_ratio": 0.04,
        "stage_direction_count": 4
      }
    },
    {
      "scene_id": 3,
      "title": "温侯恋酒",
      "characters_on_stage": [
        "吕布",
        "貂蝉",
        "小太监",
        "陈宫"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "小太监上，貂蝉、吕布同上。"
        },
        {
          "type": "lyric",
          "speaker": "吕布",
          "mode": "西皮二六板",
          "content": "每日里闲无事逍遥饮酒，到今日称心愿得坐徐州。只恨的曹操贼屡次入寇，他那里兴人马来夺徐州。狗奸贼要擒我怎能得够？某若是抖威风群贼命休。内侍臣看过了琼浆美酒，我二人只欢乐多饮几瓯。"
        },
        {
          "type": "dialogue",
          "speaker": "貂蝉",
          "mode": "白",
          "content": "看酒。"
        },
        {
          "type": "lyric",
          "speaker": "貂蝉",
          "mode": "西皮摇板",
          "content": "老王允定下了连环巧计，我这里用假意谅他不知。但愿得曹丞相大兵齐至，破徐州俱擒去万事全休。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "吕布、貂蝉同吃酒。"
        },
        {
          "type": "dialogue",
          "speaker": "陈宫",
          "mode": "内白",
          "content": "走吓！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "陈宫上。"
        },
        {
          "type": "lyric",
          "speaker": "陈宫",
          "mode": "西皮摇板",
          "content": "曹操领兵夺徐州，迷恋宫闱吕温侯。将身来在宫门口，见了公公说从头。"
        },
        {
          "type": "dialogue",
          "speaker": "陈宫",
          "mode": "白",
          "content": "烦劳公公，通禀温侯：陈宫有本启奏。"
        },
        {
          "type": "dialogue",
          "speaker": "小太监",
          "mode": "白",
          "content": "原来是公台，请少待，咱家与你启奏。"
        },
        {
          "type": "dialogue",
          "speaker": "陈宫",
          "mode": "白",
          "content": "有劳了。"
        },
        {
          "type": "dialogue",
          "speaker": "小太监",
          "mode": "白",
          "content": "启娘娘：公台有本启奏。"
        },
        {
          "type": "dialogue",
          "speaker": "貂蝉",
          "mode": "白",
          "content": "温侯酒醉，有本改日再奏。"
        },
        {
          "type": "dialogue",
          "speaker": "小太监",
          "mode": "白",
          "content": "是。公台，温侯酒醉，有本改日再奏。"
        },
        {
          "type": "dialogue",
          "speaker": "陈宫",
          "mode": "白",
          "content": "这话是何人讲的？"
        },
        {
          "type": "dialogue",
          "speaker": "小太监",
          "mode": "白",
          "content": "娘娘讲的。"
        },
        {
          "type": "dialogue",
          "speaker": "陈宫",
          "mode": "白",
          "content": "不好了！"
        },
        {
          "type": "lyric",
          "speaker": "陈宫",
          "mode": "西皮摇板",
          "content": "昔日有个商纣王，宠爱妲姬乱朝纲。温侯学了前朝样，蝉貂好比苏娘娘。大着胆儿宫门闯，"
        },
        {
          "type": "dialogue",
          "speaker": "小太监",
          "mode": "白",
          "content": "公台，这是什么地方，你不想着活了？"
        },
        {
          "type": "dialogue",
          "speaker": "陈宫",
          "mode": "白",
          "content": "哎吓！"
        },
        {
          "type": "lyric",
          "speaker": "陈宫",
          "mode": "西皮摇板",
          "content": "顺者昌来逆者亡。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "陈宫下。"
        }
      ],
      "stats": {
        "line_count": 22,
        "lyric_ratio": 0.5,
        "stage_direction_count": 4
      }
    },
    {
      "scene_id": 4,
      "title": "吕布出战",
      "characters_on_stage": [
        "貂蝉",
        "吕布",
        "张辽",
        "小太监",
        "李典",
        "乐进",
        "许褚",
        "曹洪",
        "刘备",
        "关羽",
        "张飞",
        "龙套"
      ],
      "segments": [
        {
          "type": "dialogue",
          "speaker": "貂蝉",
          "mode": "白",
          "content": "温侯请酒。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "张辽上。"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "念",
          "content": "忙将盗马事，报与温侯知。"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "来此已是。哪位在？"
        },
        {
          "type": "dialogue",
          "speaker": "小太监",
          "mode": "白",
          "content": "原来是张将军，到此何事？"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "烦劳公公通禀，张辽有本启奏。"
        },
        {
          "type": "dialogue",
          "speaker": "小太监",
          "mode": "白",
          "content": "温侯酒醉，改日再奏罢。"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "何人讲的？"
        },
        {
          "type": "dialogue",
          "speaker": "小太监",
          "mode": "白",
          "content": "娘娘讲的。"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "闪开了！启温侯：大事不好了！"
        },
        {
          "type": "dialogue",
          "speaker": "吕布",
          "mode": "白",
          "content": "吓，何事惊慌？"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "今日侯成，将温侯赤兔马与画戟盗去了。"
        },
        {
          "type": "dialogue",
          "speaker": "吕布",
          "mode": "白",
          "content": "再探。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "张辽下。"
        },
        {
          "type": "dialogue",
          "speaker": "吕布",
          "mode": "白",
          "content": "不好了！"
        },
        {
          "type": "lyric",
          "speaker": "吕布",
          "mode": "扑灯蛾",
          "content": "闻言怒气发，怒气发，不由人咬碎钢牙。盗去画戟赤兔马，赤手空拳怎战杀。"
        },
        {
          "type": "dialogue",
          "speaker": "貂蝉",
          "mode": "白",
          "content": "好吓！"
        },
        {
          "type": "lyric",
          "speaker": "貂蝉",
          "mode": "扑灯蛾",
          "content": "温侯不必怒气发，妾身有言听根芽：温侯威名谁不怕，无有戟马也胜他。"
        },
        {
          "type": "lyric",
          "speaker": "吕布",
          "mode": "扑灯蛾",
          "content": "吩咐众将备战马，生擒活捉把贼拿。"
        },
        {
          "type": "dialogue",
          "speaker": "吕布",
          "mode": "白",
          "content": "来，吩咐备马。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "吕布下。"
        },
        {
          "type": "dialogue",
          "speaker": "貂蝉",
          "mode": "白",
          "content": "温侯吓，事到其时，此去定被曹公所擒，可怪不得你妻子了。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "貂蝉下。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "马夫上，备马。"
        },
        {
          "type": "dialogue",
          "speaker": "马夫",
          "mode": "白",
          "content": "有请温侯上马。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四小军、大将自两边分上。吕布上，李典、乐进、许褚、曹洪同上，会阵。刘备、关羽、张飞同上，开打。众人同下。"
        }
      ],
      "stats": {
        "line_count": 26,
        "lyric_ratio": 0.23,
        "stage_direction_count": 6
      }
    },
    {
      "scene_id": 5,
      "title": "下邳城破",
      "characters_on_stage": [
        "陈宫",
        "张辽",
        "貂蝉",
        "吕布",
        "李典",
        "乐进",
        "许褚",
        "曹洪",
        "刘备",
        "关羽",
        "张飞",
        "龙套"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四龙套同上，陈宫上。"
        },
        {
          "type": "dialogue",
          "speaker": "陈宫",
          "mode": "念",
          "content": "眼观旌旗起，"
        },
        {
          "type": "stage_direction",
