        },
        {
          "type": "lyric",
          "speaker": "吕布",
          "mode": "内西皮导板",
          "content": "今日里在小沛大败一仗，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四龙套斜门同上。吕布上。"
        },
        {
          "type": "lyric",
          "speaker": "吕布",
          "mode": "西皮慢板",
          "content": "似猛虎离山岗落了平阳。自幼儿出母胎情性傲强，灭却了董卓贼各霸一方。到如今陷小沛身入罗网，要活命除非是转世还阳。"
        },
        {
          "type": "lyric",
          "speaker": "吕布",
          "mode": "西皮快板",
          "content": "俺好比夏后羿月窟遭殃，某好比公叔段命丧沙场。俺好比汉高祖兵败咸阳，某好比三齐王命丧未央。"
        },
        {
          "type": "dialogue",
          "speaker": "吕布",
          "mode": "白",
          "content": "咳！"
        },
        {
          "type": "lyric",
          "speaker": "吕布",
          "mode": "西皮快板",
          "content": "没奈何进帐去哀求丞相，屈膝跪低下头吕布归降。"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "下跪何人？"
        },
        {
          "type": "dialogue",
          "speaker": "吕布",
          "mode": "白",
          "content": "被擒吕布。"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "抬起头来。"
        },
        {
          "type": "dialogue",
          "speaker": "吕布",
          "mode": "白",
          "content": "有罪不敢抬头。"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "恕你无罪。"
        },
        {
          "type": "dialogue",
          "speaker": "吕布",
          "mode": "白",
          "content": "谢丞相。"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "你虎牢关的威风何在？"
        },
        {
          "type": "dialogue",
          "speaker": "吕布",
          "mode": "白",
          "content": "天下英雄怎敌丞相？"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "你待怎讲？"
        },
        {
          "type": "dialogue",
          "speaker": "吕布",
          "mode": "白",
          "content": "怎比丞相？"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "三笑",
          "content": "哈哈，哈哈，哈哈哈！"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "刘使君！"
        },
        {
          "type": "dialogue",
          "speaker": "刘备",
          "mode": "白",
          "content": "丞相。"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "老夫有意将吕布收留帐下，你看如何？"
        },
        {
          "type": "dialogue",
          "speaker": "刘备",
          "mode": "白",
          "content": "杀也在丞相，放也在丞相，可记得丁董之故事乎？"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "本当将你收留，恐学那丁、董之故事。来，斩！"
        },
        {
          "type": "dialogue",
          "speaker": "吕布",
          "mode": "白",
          "content": "刘使君，你今为上坐客，布为阶下囚，为何在一旁多言？"
        },
        {
          "type": "dialogue",
          "speaker": "刘备",
          "mode": "白",
          "content": "丞相传令，谁敢违抗？"
        },
        {
          "type": "dialogue",
          "speaker": "吕布",
          "mode": "白",
          "content": "可记得辕门射戟之时乎？"
        },
        {
          "type": "dialogue",
          "speaker": "刘备",
          "mode": "白",
          "content": "天长日久，备倒失记了。"
        },
        {
          "type": "dialogue",
          "speaker": "吕布",
          "mode": "白",
          "content": "你且听听！"
        },
        {
          "type": "lyric",
          "speaker": "吕布",
          "mode": "西皮快板",
          "content": "大耳贼——"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "张辽上。"
        },
        {
          "type": "lyric",
          "speaker": "吕布",
          "mode": "西皮快板",
          "content": "忘却了辕门射戟，有袁术差纪灵将你来逼。那时节全亏我射戟神力，一杆戟唬退了猛将姓纪。到今日忘前情反做仇敌，"
        },
        {
          "type": "dialogue",
          "speaker": "吕布",
          "mode": "白",
          "content": "罢！"
        },
        {
          "type": "lyric",
          "speaker": "吕布",
          "mode": "西皮快板",
          "content": "某死后定将你生魂来逼。某只得二次里屈膝跪地，"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "温侯，难道你还怕死么？"
        },
        {
          "type": "dialogue",
          "speaker": "吕布",
          "mode": "白",
          "content": "将军吓！"
        },
        {
          "type": "lyric",
          "speaker": "吕布",
          "mode": "西皮摇板",
          "content": "某死后汉室中英雄还有谁？"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四龙套押吕布同下，三鼓。龙套甲拿头上付与张辽。"
        },
        {
          "type": "lyric",
          "speaker": "张辽",
          "mode": "西皮摇板",
          "content": "烈烈英雄辈，钢刀把命追。宠爱貂蝉女，昏迷在宫闱。今日刀下死，此时埋怨谁？人头搭在宝帐内，开言大骂狗奸贼！"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "下站何人？"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "瞎了儿的狗眼，连你张老爷都不认识了！"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "原来是火烧濮阳的火头军。"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "可惜吓，可惜！"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "可惜什么？"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "可惜濮阳的火小；若是火大，将你这奸贼烧死，免却我君臣的后难。"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "今日被擒，还是这样性傲。来，斩了！"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "三笑",
          "content": "哈哈，哈哈，哈哈哈！"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "抓回来！"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "要斩就斩，何必多言？"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "你为何在辕门发笑？"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "俺乃天下豪杰，死在你这奸贼之手，岂不可笑？"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "张将军，你若归顺老夫帐下，必然重用。"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "岂与你这逆贼同党。"
        },
        {
          "type": "dialogue",
          "speaker": "关羽",
          "mode": "白",
          "content": "张将军你若不降，你家中还有妻室老小，依靠何人？你要再思再想。"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "要俺归降，依我三件大事。"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "哪三件？"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "头一件将温侯死首，不可损坏；第二件将他尸首，要金井玉葬；第三件，要你这奸贼亲自下位松绑。"
        },
        {
          "type": "dialogue",
          "speaker": "关羽",
          "mode": "白",
          "content": "某家代劳。"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "后帐摆宴，与众位将军同饮。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "众人同下。"
        }
      ],
      "stats": {
        "line_count": 59,
        "lyric_ratio": 0.39,
        "stage_direction_count": 4
      }
    }
  ]
