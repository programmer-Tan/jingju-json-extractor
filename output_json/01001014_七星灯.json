  "scenes": [
    {
      "scene_id": 1,
      "title": "",
      "characters_on_stage": [
        "诸葛亮",
        "旗牌",
        "众将",
        "姜维",
        "魏延"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮上"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "念",
          "content": "安排脂粉计，耻笑司马懿"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "旗牌上"
        },
        {
          "type": "lyric",
          "speaker": "旗牌",
          "mode": "念",
          "content": "忙将机密事，报与丞相知"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "参见丞相"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "你回来了？"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "小人回来了"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "脂粉钗裙可曾送去？"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "送去了"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "那司马懿见礼物便怎么样？"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "我说：“丞相见你停兵不战，送你脂粉裙钗，穿在身上，往丞相处拜他几拜，丞相就可收兵。”"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "他说些什么？"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "他说道：“取笑由他，各有用兵之计。”"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "吓，这是司马懿说的！后来呢？"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "小人还在他营中，饮过宴来"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "如此说来，他还款待你的？酒席筵前，说些什么？"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "他问道丞相饮食如何？"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "你是怎么回答的？"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "小人说道：“丞相饮食减少。”"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "唗！退下！"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "是"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "旗牌下"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "且住。指望送去脂粉钗裙，耻笑那司马懿，不想被旗牌将机关泄漏，这大事休矣！"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄慢板",
          "content": "仰面朝天自己嗟叹，司马懿可算得将中魁元。送脂粉和钗裙不恼可赞，反与那旗牌官酒食来餐。有刚有柔是好汉，我诸葛要学他难上加难。先帝爷下南阳君臣见面，受深恩定扭转汉室江山。博望坡烧曹兵初次交战，借东风助周郎火烧战船。用火攻烧藤甲南蛮丧胆，谁不知诸葛亮计能扭天。到如今遇司马两下会战，葫芦谷设地雷定下机关。我料他父子们定遭此难，又谁知天不随也是枉然。一霎时急得我遍体是汗"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮吐"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄慢板",
          "content": "怕的是大数到性命难全"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "众将同上"
        },
        {
          "type": "lyric",
          "speaker": "众将",
          "mode": "同二黄摇板",
          "content": "忽听帐内闹声喧，忙到帐内看分明"
        },
        {
          "type": "dialogue",
          "speaker": "众将",
          "mode": "同白",
          "content": "丞相为何这等模样？"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "列为将军有所不知，老夫昨夜仰观天象，见北斗昏暗，看来老夫性命休矣！"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "丞相自幼精习奇门之法，何不在此高搭玄台，祝告上苍，保得阳寿，也未可知"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "不知天意如何？"
        },
        {
          "type": "dialogue",
          "speaker": "魏延",
          "mode": "白",
          "content": "哽"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "魏延听令"
        },
        {
          "type": "dialogue",
          "speaker": "魏延",
          "mode": "白",
          "content": "何令？"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "命你带领一哨人马，巡营撩哨，以防司马，无令不许擅入！"
        },
        {
          "type": "dialogue",
          "speaker": "魏延",
          "mode": "白",
          "content": "得令"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "魏延下"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "姜维听令"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "在"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "命你在中央戊已土，高搭玄台，上用七星黑旗一面，安明灯七盏，却是老夫本命之灯，不可打熄；倘若打熄，大事难成"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "末将知道"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "姜维下"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "正是："
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "念",
          "content": "三寸气在千般用，一旦无常万事休"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮下"
        }
      ],
      "stats": {
        "line_count": 48,
        "lyric_ratio": 0.375,
        "stage_direction_count": 6
      }
    },
    {
      "scene_id": 2,
      "title": "",
      "characters_on_stage": [
        "司马懿",
        "龙套"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二白龙套引司马懿同上"
        },
        {
          "type": "lyric",
          "speaker": "司马懿",
          "mode": "二黄导板",
          "content": "一霎时玉兔升星明朗见"
        },
        {
          "type": "lyric",
          "speaker": "司马懿",
          "mode": "二黄原板",
          "content": "又听得营棚内打罢初更。叫三军掌银灯把高岗来进"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "司马懿上山"
        },
        {
          "type": "lyric",
          "speaker": "司马懿",
          "mode": "二黄原板",
          "content": "虎目圆睁看分明：观东方甲乙木，木旺生火，观南方丙丁火，火能克金。正西方亢金龙昂然坐定，观北方壬癸水，水见壬庚。在北斗口内仔细看"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮星、魏延星拿黑旗自两边分上，碰头后分下"
        },
        {
          "type": "dialogue",
          "speaker": "司马懿",
          "mode": "白",
          "content": "吓！"
        },
        {
          "type": "lyric",
          "speaker": "司马懿",
          "mode": "二黄原板",
          "content": "见北斗主星黑暗不明。那诸葛本是七星保命，算就了五丈原必落此星。叫三军把高岗下听我号令"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二白龙套同喝"
        },
        {
          "type": "lyric",
          "speaker": "司马懿",
          "mode": "二黄摇板",
          "content": "若见那灵官走定是孔明。四更时分造战饭，五更一打要交兵。此一番一个个用力战胜，回营中奏皇封都是功臣"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "司马懿、二白龙套同下"
        }
      ],
      "stats": {
        "line_count": 21,
        "lyric_ratio": 0.714,
        "stage_direction_count": 4
      }
    },
    {
      "scene_id": 3,
      "title": "",
      "characters_on_stage": [
        "姜维",
        "诸葛亮",
        "魏延"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "姜维捧灯上，打扫玄台"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "有请师父！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮上"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄慢板",
          "content": "为国家把我的心血用尽，都只为先帝爷托孤之恩。执宝剑上玄台难以扎挣，险些儿把老夫跌倒埃尘"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "上苍吓！亮在乱世，隐居隆中。蒙先帝三顾之恩，任幼主托孤之重。统众六出祁山，讨贼不果。将星欲落，阳寿已终。虔诚祝告上苍：假我数年，扶持汉室，上报先帝托孤之恩，下免万民一切之苦。神明在上，鉴我此心！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮烧表三道"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄原板",
          "content": "诸葛亮不敢扭天行，为的是吾主锦乾坤。拜北斗和南斗赐我阳寿，执簿官掌笔庚留下人情。中央戊已深深拜"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮看"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "笑",
          "content": "哈哈哈……"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "北斗星光渐渐明！纵然拜起主星台北斗，不知生死若何论？"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮下。魏延急上"
        },
        {
          "type": "lyric",
          "speaker": "魏延",
          "mode": "二黄摇板",
          "content": "司马懿父子来踹营，报与丞相得知情"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "魏延熄灯。诸葛亮执剑上"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "想是我大限有一定，魏延打熄本命灯。将宝剑插在尘埃地"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "姜维上"
        },
        {
          "type": "lyric",
          "speaker": "姜维",
          "mode": "二黄摇板",
          "content": "丞相为何发雷霆？"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "我今拜灯整六天，看看七日大功全。恨魏延他把我本命灯扑暗，我的性命就在顷刻间。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "哎吓，贼子吓！"
        },
        {
          "type": "lyric",
          "speaker": "姜维",
          "mode": "二黄摇板",
          "content": "我师父拜斗六天整，看看拜起本命星。为何将灯来打熄？想是贼子起反心！手执宝剑将你砍"
        },
        {
          "type": "dialogue",
          "speaker": "魏延",
          "mode": "白",
          "content": "你不能！"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "将军息怒慢稍停"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "魏延你慌慌张张走进帐内，跑上玄台，可是司马命人前来骂阵么？"
        },
        {
          "type": "dialogue",
          "speaker": "魏延",
          "mode": "白",
          "content": "正是"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "命你带领本部人马，抵敌司马来将，无令休来见我"
        },
        {
          "type": "dialogue",
          "speaker": "魏延",
          "mode": "白",
          "content": "得令"
        },
        {
          "type": "lyric",
          "speaker": "魏延",
          "mode": "念",
          "content": "恨小非君子，无毒不丈夫！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "魏延下"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "姜维搀我下玄台"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "姜维搀诸葛亮同下玄台"
        }
      ],
      "stats": {
        "line_count": 32,
        "lyric_ratio": 0.531,
        "stage_direction_count": 8
      }
    },
    {
      "scene_id": 4,
      "title": "",
      "characters_on_stage": [
        "诸葛亮",
        "姜维",
        "李福",
        "杨仪",
        "马岱",
        "王平"
      ],
      "segments": [
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "姜维与我快些请，后帐快请李大人"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "有请李大人"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "李福上"
        },
        {
          "type": "lyric",
          "speaker": "李福",
          "mode": "二黄摇板",
          "content": "忽听丞相唤一声，急忙进帐问分明"
        },
        {
          "type": "dialogue",
          "speaker": "李福",
          "mode": "白",
          "content": "参见丞相"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "罢了"
        },
        {
          "type": "dialogue",
          "speaker": "李福",
          "mode": "白",
          "content": "唤我进帐，有何军情？"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "李大人吓，我今病已沉重，不久于人世。有遗表一道，烦劳大人，去往成都，转奏后主，意下如何？"
        },
        {
          "type": "dialogue",
          "speaker": "李福",
          "mode": "白",
          "content": "丞相差遣，愿去不辞"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "姜维看表过来"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "是"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "搀扶了"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "是"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "圣上吓！念臣鞠躬尽瘁，死而后已！"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "对着西川深深拜，拜谢后主爵禄恩。羞愧难见刘先主，李大人你速速转奏奔都城！"
        },
        {
          "type": "lyric",
          "speaker": "李福",
          "mode": "二黄摇板",
          "content": "辞别丞相跨金镫，不分昼夜奔都城"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "李福下"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "叫头",
          "content": "姜维！"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "叫头",
          "content": "丞相！"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "叫头",
          "content": "姜伯约！"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "叫头",
          "content": "师父！"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "叫头",
          "content": "将军吓！"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄快三眼",
          "content": "我和你虽是将帅，却有那师徒之义"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "坐下"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄原板",
          "content": "必须要学师父扶保乾坤。我命该活七十四，祭东风损去十年春。烧藤甲又损我十年寿，到如今五十四岁命归阴。我死后要依我三件要事，一桩桩一件件牢记在心"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "这头一件？"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄原板",
          "content": "第一件满营中休要举哀挂孝"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "第二件？"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄原板",
          "content": "第二件必须要缓缓移营"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "这第三件？"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄原板",
          "content": "第三件我死后魏延必反"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "吓！"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "我自有妙计杀此人"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "姜维，"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "我将这奇门遁甲传与你，阵阵不离此图形。这一弩能发十条箭，九伐中原你当承！"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "遵命"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "将军与我传一令，快传马岱、杨仪与王平！"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "马岱、杨仪、王平进帐！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "马岱、杨仪、王平同上"
        },
        {
          "type": "lyric",
          "speaker": "马岱、杨仪、王平",
          "mode": "同二黄摇板",
          "content": "忽听帐中传一令，见了丞相问分明"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮昏"
        },
        {
          "type": "dialogue",
          "speaker": "马岱、杨仪、王平",
          "mode": "同白",
          "content": "丞相醒来！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮醒"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "指望霸业归炎汉，谁知半路不周全。猛然睁开昏花眼，又只见众将官站立面前"
        },
        {
          "type": "dialogue",
          "speaker": "马岱、杨仪、王平",
          "mode": "同白",
          "content": "丞相"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "杨仪！"
        },
        {
          "type": "dialogue",
          "speaker": "杨仪",
          "mode": "白",
          "content": "在"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "我死后军师牌印你掌管，事事小心须周全。我今与你一小柬，里面安排巧机关"
        },
        {
          "type": "dialogue",
          "speaker": "杨仪",
          "mode": "白",
          "content": "遵命"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "王平！"
        },
        {
          "type": "dialogue",
          "speaker": "王平",
          "mode": "白",
          "content": "在"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "我与你一封书和柬，我死之后仔细观"
        },
        {
          "type": "dialogue",
          "speaker": "王平",
          "mode": "白",
          "content": "遵命"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "马岱！"
        },
        {
          "type": "dialogue",
          "speaker": "马岱",
          "mode": "白",
          "content": "在"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "我今与你书和柬，这里面暗藏巧机关。倘若魏延造了反，只须如此并这般"
        },
        {
          "type": "dialogue",
          "speaker": "马岱",
          "mode": "白",
          "content": "遵命"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "众将官搀扶我把先帝爷拜见，诸葛亮营中叩龙颜。恕为臣不能与主重兴汉，恕为臣不能与主保江山。霎时间心血涌遍体是汗，我面前站定了庞统士元"
        },
        {
          "type": "dialogue",
          "speaker": "马岱、杨仪、王平、姜维",
          "mode": "同白",
          "content": "他前来作甚？"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "在荆州对将八字推算"
        },
        {
          "type": "dialogue",
          "speaker": "马岱、杨仪、王平、姜维",
          "mode": "同白",
          "content": "算些什么？"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "我二人各有不周全"
        },
        {
          "type": "dialogue",
          "speaker": "马岱、杨仪、王平、姜维",
          "mode": "同白",
          "content": "丞相算他何来？"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "我算他落凤坡前带箭死"
        },
        {
          "type": "dialogue",
          "speaker": "马岱、杨仪、王平、姜维",
          "mode": "同白",
          "content": "他算丞相怎样？"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "他道我难逃五丈原"
        },
        {
          "type": "dialogue",
          "speaker": "马岱、杨仪、王平、姜维",
          "mode": "同白",
          "content": "丞相保重了！"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "二黄摇板",
          "content": "一霎时咽喉哽心血上犯，无常到万事休命赴九泉"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮死"
        },
        {
          "type": "dialogue",
          "speaker": "马岱、杨仪、王平、姜维",
          "mode": "同哭",
          "content": "哎呀，丞相吓！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "李福上"
        },
        {
          "type": "dialogue",
          "speaker": "李福",
          "mode": "白",
          "content": "众位将军，丞相怎么样了？"
        },
        {
          "type": "dialogue",
          "speaker": "马岱、杨仪、王平、姜维",
          "mode": "同白",
          "content": "丞相下世去了"
        },
        {
          "type": "dialogue",
          "speaker": "李福",
          "mode": "白",
          "content": "哎呀，耽误国家大事了！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮醒"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "哼！"
        },
        {
          "type": "dialogue",
          "speaker": "马岱、杨仪、王平、姜维",
          "mode": "同白",
          "content": "啊！丞相醒来！李大人来了！"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "李大人转来则甚？"
        },
        {
          "type": "dialogue",
          "speaker": "李福",
          "mode": "白",
          "content": "幼主问道，丞相下世，军中大事，何人料理？"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "姜维、杨仪"
        },
        {
          "type": "dialogue",
          "speaker": "李福",
          "mode": "白",
          "content": "朝歌大事？"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "蒋公琰"
        },
        {
          "type": "dialogue",
          "speaker": "李福",
          "mode": "白",
          "content": "蒋公琰之后？"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "费文炜"
        },
        {
          "type": "dialogue",
          "speaker": "李福",
          "mode": "白",
          "content": "费文炜之后？"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "三国归于……"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮死。众人同哭"
        },
        {
          "type": "dialogue",
          "speaker": "李福",
          "mode": "白",
          "content": "列位将军，你等料理丞相，待我报与幼主知道"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "李福下"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "列位将军，丞相下世，有锦囊一封，大众拆开一看，便知明白"
        },
        {
          "type": "dialogue",
          "speaker": "马岱、杨仪、王平、姜维",
          "mode": "同白",
          "content": "有理"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "奏牌子"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "吓，原来丞相说道，用沉香木雕成偶像，自有退兵之计。你我照计而行"
        },
        {
          "type": "dialogue",
          "speaker": "马岱、杨仪、王平",
          "mode": "同哭",
          "content": "哎呀，丞相吓！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "众人同下"
        }
      ],
      "stats": {
        "line_count": 97,
        "lyric_ratio": 0.474,
        "stage_direction_count": 10
      }
    },
    {
      "scene_id": 5,
      "title": "",
      "characters_on_stage": [
        "司马懿",
        "司马师",
        "司马昭",
        "众将",
        "龙套",
        "姜维",
        "马岱",
        "王平"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "司马懿上，司马师、司马昭、众将、龙套同上"
        },
        {
          "type": "dialogue",
          "speaker": "司马懿",
          "mode": "白",
          "content": "俺，司马懿。昨夜仰观天象，将星坠下，孔明已死。本帅带领人马前去抢他尸首粮草。众将！"
        },
        {
          "type": "dialogue",
          "speaker": "众将",
          "mode": "同白",
          "content": "有"
        },
        {
          "type": "dialogue",
          "speaker": "司马懿",
          "mode": "白",
          "content": "就此前去，暗地踹营"
        },
        {
          "type": "dialogue",
          "speaker": "众将",
          "mode": "同白",
          "content": "得令！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "会阵。姜维、马岱、王平同上"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "暗地里踹营，何为大将？我家师父，正在用兵拿你！"
        },
        {
          "type": "dialogue",
          "speaker": "司马懿",
          "mode": "白",
          "content": "我却不信！"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "有请师父！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "众将同推诸葛亮上。司马懿唬，退下"
        },
        {
          "type": "dialogue",
          "speaker": "姜维",
          "mode": "白",
          "content": "丞相已死，威名还在。众将官，好好看守！"
        },
        {
          "type": "dialogue",
          "speaker": "众将",
          "mode": "同白",
          "content": "哦！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "众人同下"
        }
      ],
      "stats": {
        "line_count": 14,
        "lyric_ratio": 0,
        "stage_direction_count": 4
      }
    },
    {
      "scene_id": 6,
