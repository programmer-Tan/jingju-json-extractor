  "scenes": [
    {
      "scene_id": 1,
      "title": "赵府问事",
      "characters_on_stage": [
        "赵高",
        "门官",
        "丫鬟",
        "赵艳容"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵高上"
        },
        {
          "type": "lyric",
          "speaker": "赵高",
          "mode": "引子",
          "content": "月影照纱窗，梅花绕粉墙"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "念",
          "content": "人人说道老夫奸，我看世人心更偏。为人若无良谋智，焉能富贵两双全"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "老夫赵高，时才下朝回来，闻听外人言讲，道我儿叫那家人赵忠一声“丈夫”，不免将我儿唤出问个明白。来，门官"
        },
        {
          "type": "dialogue",
          "speaker": "门官",
          "mode": "白",
          "content": "有"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "请小姐出堂"
        },
        {
          "type": "dialogue",
          "speaker": "门官",
          "mode": "白",
          "content": "后堂传话，小姐出堂！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "丫鬟内白：哑叭哑叭！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵艳容、丫鬟同上"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "念",
          "content": "杜鹃迎头泣，血泪含悲啼"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "爹爹，孩儿万福"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "罢了，一旁坐下"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "唤孩儿出堂有何教训？"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "时才为父下朝回来，闻听外人言讲，道我儿叫那家人赵忠一声“丈夫”，可是有的？"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "爹爹说哪里话来，想那赵忠他是甚等样人，孩儿岂肯叫他一声“丈夫”？"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "待为父修下本章，明日早朝奏明圣上"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "爹爹恩宽。丫奴磨墨伺候"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "丫鬟磨墨"
        },
        {
          "type": "lyric",
          "speaker": "赵艳容",
          "mode": "西皮慢板",
          "content": "老爹爹恩德宽把本修上，明早朝上金殿启奏我王。我主爷有道君皇恩浩荡，准此本免去了满门祸殃"
        }
      ],
      "stats": {
        "line_count": 22,
        "lyric_ratio": 0.227,
        "stage_direction_count": 4
      }
    },
    {
      "scene_id": 2,
      "title": "秦王幸府",
      "characters_on_stage": [
        "四太监",
        "秦王",
        "门官",
        "赵高",
        "赵艳容",
        "丫鬟"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四太监引秦王同上"
        },
        {
          "type": "dialogue",
          "speaker": "秦王",
          "mode": "白",
          "content": "摆驾！"
        },
        {
          "type": "lyric",
          "speaker": "秦王",
          "mode": "西皮摇板",
          "content": "时才间观花灯与民间乐，观相府好一似龙楼凤阁"
        },
        {
          "type": "dialogue",
          "speaker": "门官",
          "mode": "白",
          "content": "参见万岁！"
        },
        {
          "type": "dialogue",
          "speaker": "秦王",
          "mode": "白",
          "content": "罢了。相国可在府中？"
        },
        {
          "type": "dialogue",
          "speaker": "门官",
          "mode": "白",
          "content": "现在表本。待蝼蚁通报"
        },
        {
          "type": "dialogue",
          "speaker": "秦王",
          "mode": "白",
          "content": "不用通报，退下"
        },
        {
          "type": "dialogue",
          "speaker": "门官",
          "mode": "白",
          "content": "是"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "门官下"
        },
        {
          "type": "dialogue",
          "speaker": "秦王",
          "mode": "白",
          "content": "内侍摆驾"
        },
        {
          "type": "lyric",
          "speaker": "秦王",
          "mode": "西皮摇板",
          "content": "内侍掩灯相府进，灯光之下遇美人"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵艳容、丫鬟同下"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "赵高见驾，吾皇万岁！"
        },
        {
          "type": "dialogue",
          "speaker": "秦王",
          "mode": "白",
          "content": "平身，赐坐"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "谢坐"
        },
        {
          "type": "dialogue",
          "speaker": "秦王",
          "mode": "白",
          "content": "卿家在此则甚？"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "在此表本"
        },
        {
          "type": "dialogue",
          "speaker": "秦王",
          "mode": "白",
          "content": "呈上来"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "是"
        },
        {
          "type": "dialogue",
          "speaker": "秦王",
          "mode": "白",
          "content": "原来邝府之事，寡人一概不究"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "谢万岁"
        },
        {
          "type": "dialogue",
          "speaker": "秦王",
          "mode": "白",
          "content": "时才灯光之下见一妇人，她是何人？"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "乃是老臣小女"
        },
        {
          "type": "dialogue",
          "speaker": "秦王",
          "mode": "白",
          "content": "孤王意欲宣进宫去同掌山河，意下如何？"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "明日早朝送进宫去"
        },
        {
          "type": "dialogue",
          "speaker": "秦王",
          "mode": "白",
          "content": "好！太师听封：封你掌朝太师之职"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "谢主龙恩！"
        },
        {
          "type": "dialogue",
          "speaker": "秦王",
          "mode": "白",
          "content": "摆驾回宫"
        },
        {
          "type": "lyric",
          "speaker": "秦王",
          "mode": "西皮摇板",
          "content": "内侍摆驾回宫廷，明日早朝看美人"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "秦王下"
        }
      ],
      "stats": {
        "line_count": 32,
        "lyric_ratio": 0.188,
        "stage_direction_count": 4
      }
    },
    {
      "scene_id": 3,
      "title": "装疯拒婚",
      "characters_on_stage": [
        "赵艳容",
        "丫鬟",
        "赵高"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵艳容、丫鬟同上"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "念",
          "content": "有事在心头，终日眉头皱"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "呀，爹爹，圣驾到此为了何事？"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "万岁到此将邝府之事一概不究"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "我主才是有道明君"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "本来是有道明君。恭喜我儿，贺喜我儿！"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "喜从何来？"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "时才万岁见我儿生得美貌，有意带进宫去同掌山河"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "爹爹怎样回奏？"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "明日早朝送进宫去"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "爹爹啊，你身为当朝首相，位列三台，连这三纲五常都不晓得了么？"
        },
        {
          "type": "lyric",
          "speaker": "赵艳容",
          "mode": "西皮散板",
          "content": "老爹爹说此话真个可骇，怪不得骂名儿四海喧传。你孩儿曾念过列女真传，岂肯做那失节妇遗臭万年？"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "儿呵，难道不遵父命么？"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "爹爹，又道是“先嫁由父母，后嫁自由身”。我看此事就用不着你了"
        },
        {
          "type": "lyric",
          "speaker": "赵艳容",
          "mode": "西皮散板",
          "content": "常言道“嫁鸡随鸡走”，又道是“嫁犬犬同行”"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "难道说不遵圣名么？"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "爹爹啊，慢说是圣命，就一把钢刀将儿首级割下也是不能遵命的了"
        },
        {
          "type": "lyric",
          "speaker": "赵艳容",
          "mode": "西皮散板",
          "content": "见此情一时间不能言断，必须要生巧计才得安然"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "丫鬟比手教装疯"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "呀！"
        },
        {
          "type": "lyric",
          "speaker": "赵艳容",
          "mode": "西皮散板",
          "content": "见丫奴在一旁挤眉绉眼，莫非她叫我假装疯癫。没奈何我只得青丝扯乱"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "吓！"
        },
        {
          "type": "lyric",
          "speaker": "赵艳容",
          "mode": "西皮散板",
          "content": "我这里脱绣鞋扯破衣衫"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "儿敢是疯了么？"
        },
        {
          "type": "lyric",
          "speaker": "赵艳容",
          "mode": "西皮散板",
          "content": "听说疯我乐得随机应变，倒卧在尘埃地信口胡言"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "儿呀，你当真的疯了么？"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "怎么讲？"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "疯了么？"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "哈哈哈……爹爹，孩儿要上天！"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "天高上不去！"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "吓吓吓吓……爹爹，我要入地！"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "地厚无门下不去！"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "吓吓吓吓……爹爹，我那亲……"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "“亲”什么？"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "亲生的儿呵！"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "呸！"
        },
        {
          "type": "lyric",
          "speaker": "赵艳容",
          "mode": "反二黄慢板",
          "content": "我这里假意儿来睁杏眼，摇摇摆摆摇摇摆摆摇向前。我把他当做了夫君高唤，我的夫啊！"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "爹，来呀！"
        },
        {
          "type": "lyric",
          "speaker": "赵艳容",
          "mode": "反二黄慢板",
          "content": "我和你红罗帐倒凤颠鸾"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "呸！"
        },
        {
          "type": "dialogue",
          "speaker": "丫鬟",
          "mode": "白",
          "content": "哑叭哑叭！"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "净白",
          "content": "呸！"
        },
        {
          "type": "lyric",
          "speaker": "赵艳容",
          "mode": "反二黄慢板",
          "content": "我这里睁开眼天昏地暗"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "我的天！"
        },
        {
          "type": "lyric",
          "speaker": "赵艳容",
          "mode": "反二黄慢板",
          "content": "许多的怨鬼魂站立在门前"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "打鬼！"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "白",
          "content": "儿呀！那不是鬼，乃是太湖石"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "白",
          "content": "太湖石呀！"
        },
        {
          "type": "lyric",
          "speaker": "赵艳容",
          "mode": "反二黄慢板",
          "content": "那一旁来了个牛头、马面，玉皇爷驾祥云接我上天"
        },
        {
          "type": "dialogue",
          "speaker": "赵艳容",
          "mode": "笑",
          "content": "哈哈哈，吓，哈哈哈……"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵艳容下"
        },
        {
          "type": "dialogue",
          "speaker": "赵高",
          "mode": "念",
          "content": "闭门家中坐，祸从天上来！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
