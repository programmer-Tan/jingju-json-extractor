  "scenes": [
    {
      "scene_id": 1,
      "title": "",
      "characters_on_stage": [
        "康氏",
        "张义"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "康氏上。"
        },
        {
          "type": "lyric",
          "speaker": "康氏",
          "mode": "引子",
          "content": "家无隔夜粮，饥寒实难当。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "念",
          "content": "老身生来命运薄，好似路上草一棵，过了今年七八月，不知来年活不活。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "老身康氏，配夫张世华。所生二子，长子张仁，次子张义。长子进京求官，杳无音信回来，只剩张义一人，每日在孟津河下钓鱼为生，这般时候，还不见回来。正是："
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "念",
          "content": "家贫出孝子，国乱显忠臣。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "张义上。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "念",
          "content": "忙将河下事，报与母亲知。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "参见母亲。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "罢了，儿吓，今日打了多少鱼，卖了多少钱？"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "孩儿未曾打得鱼，卖得钱。打得一样宝贝。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "这宝贝出在大户人家，想必是你偷来的，快快与人家送了过去。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "母亲，孩儿也不是偷来的，那是我河下钓鱼钓来的。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "拿来为娘亲看。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "是，你可不要生气。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "为娘不生气就是。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "如此待儿取来。母亲请看。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "待为娘看来。哦，为娘怎样与你言讲，三种鱼不许你钓，黑鱼、鲇鱼、乌龟，偏偏将这乌龟钓来，不听娘言，就为不孝。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "母亲不要动怒，待孩儿一言告禀，孩儿奉了母亲之命，去到孟津河下钓鱼，孩儿下了鱼勾，头一钓把这乌龟钓起来了，孩儿一看是一只乌龟。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "你就该放它下去。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "是吓，将它放下去了。我又到上河里去钓，又把它钓起来了。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "你就该放它下去才是。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "他吃了我两回食，我岂肯放它下去。又找了一块石头，打他几下。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "岂不打死了。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "我一打就打出屎来了。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "哎！"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "我一看是黄的，我想乌龟的屎是黑的。我闻听人说，孟津河下有一只金龟。想必被我钓了上来。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "慢，儿吓。人言金子是甜的，铜是苦的。拿来待为娘尝上一尝。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "遵命，待儿取来。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "待为娘尝来。果然是甜的金子。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "金子。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "宝贝。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "宝贝。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "哈哈哈，儿吓！"
        },
        {
          "type": "lyric",
          "speaker": "康氏",
          "mode": "二黄慢板",
          "content": "这都是儿孝心皇天报应。那上苍赐儿的宝贝珍。母子们有了这无价宝，只享荣华不愁贫。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "儿吓，你我母子有了这宝贝，去到大街上去，换些银钱，多买柴米少卖鱼肉。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "如今有了银钱，多买鱼肉，少买柴米。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "儿吓，有道是：常将有日思无日，莫把无时当有时。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "如此说来，多买柴米少买鱼肉，待我去买来吧。我想起一件事来了，待我禀告母亲知道。恭喜母亲，贺喜母亲！"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "为娘喜从何来。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "母亲有所不知，哥哥进京，得中第八名进士。官授祥符县正堂，岂不是一喜？"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "此话当真？"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "当真。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "果然？"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "果然。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "待为娘谢天谢地！"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "当谢天地！"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "儿吓，拿来。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "拿什么来？"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "拿报单来。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "拿来。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "拿什么来？"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "拿书信来。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "为娘在这寒窑，哪里来的书信？"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "儿在河下钓鱼，哪来的报单？"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "此话哪个对你言讲？"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "周家伯伯。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "想那周家伯伯，上了几岁年纪，颠三倒四，你去问个明白。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "待儿且去问来。呀，周家伯伯！我家兄长，可是做了官了？"
        },
        {
          "type": "dialogue",
          "speaker": "周家伯伯",
          "mode": "内白",
          "content": "正是做了官了。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "为何没有书信前来？"
        },
        {
          "type": "dialogue",
          "speaker": "周家伯伯",
          "mode": "内白",
          "content": "书信有的，被下书人下错了。下到王家庄上去了。又被王氏嫂嫂接去，今收拾收拾，雇了两乘小轿，只奔任上去了。临走之时，讲了两句淡话。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "哪两句淡话？"
        },
        {
          "type": "dialogue",
          "speaker": "周家伯伯",
          "mode": "内白",
          "content": "要叫你母子饿死寒窑。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "张义哭。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "儿吓，哪个打了你了？"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "没有人打我。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "为了何事啼哭？"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "周家伯伯言道，我家哥哥做了相符县正堂是真的。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "是真的，可有书信？"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "被下书人下错了。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "下到哪里？"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "下到王家庄上，又被王氏嫂嫂接去。收拾收拾，雇了两乘小轿。直奔任上去了。临行之时，留了两句淡话。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "哪两句淡话？"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "要将我母子饿死寒窑！"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "怎么讲？"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "要将我母子饿死寒窑！"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "好贱人吓！"
        },
        {
          "type": "lyric",
          "speaker": "康氏",
          "mode": "二黄摇板",
          "content": "听罢言来怒气生，骂声王氏狗贱人！指定了相符县高声骂，亲妻灭母败人伦。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "儿吓你那兄长做了官，他不养为娘；还是我儿孝道，你养为娘的罢。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "呀吓，慢慢想：当初有好吃的给我哥哥吃，有好穿得给我哥哥穿。如今他做了官不养活你，难道叫我打鱼的儿子养活你？我也不养活你了！"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "什么，你也不养活为娘了？"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "我说不养活你，就不养活你！"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "当真？"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "当真。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "果然？"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "果然。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "张义！"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "怎么样？"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "儿吓！"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "你不要说哭，你唱我也不养活你！"
        },
        {
          "type": "lyric",
          "speaker": "康氏",
          "mode": "二黄快三眼",
          "content": "康氏女在寒窑珠泪滚滚，骂一声张义儿不孝的畜生！"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "你不要骂。"
        },
        {
          "type": "lyric",
          "speaker": "康氏",
          "mode": "二黄快三眼",
          "content": "遭不幸儿的父早年丧命，撇下了母子们苦度光阴。街坊上花大姐叫娘改嫁，娘骂他尽都是下贱之人。娘本当去改嫁怕人议论，撇下了你弟兄二人，无父无母孤苦伶仃有谁来看承？我那张义儿吓！"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "你不要说，我不要听。"
        },
        {
          "type": "lyric",
          "speaker": "康氏",
          "mode": "二黄原板",
          "content": "那乌鸦它倒有反哺之义，那绵羊它还有跪乳之恩；那虎狼它倒有守邱之分，那黄犬它倒有报主之心。我的儿养为娘好有一比，好比那，王祥卧冰、孟宗哭竹，二十四孝，我的儿可算第一！我的儿吓！"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "好了，不要哄玩儿。"
        },
        {
          "type": "lyric",
          "speaker": "康氏",
          "mode": "二黄原板",
          "content": "养为娘不过是三年五载，娘好比风中烛能活几春。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "儿吓，娘与你讲了半日，你可养活为娘的了。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "你说了半天，我没有听见。我还是不养活你！"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "你当真不养活为娘？"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "这还有什么假的！"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "你不养活为娘，我就要……"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "你就要怎么样？"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "我就要到大街上去讨。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "哦，你要去讨饭，丢你做官儿子的脸。难道丢我打鱼的儿子的脸？你给我去吧。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "好奴才吓！"
        },
        {
          "type": "lyric",
          "speaker": "康氏",
          "mode": "二黄摇板",
          "content": "张义起了不良心，倒叫老身无计行。没奈何出窑门把饭讨。"
        },
        {
          "type": "lyric",
          "speaker": "张义",
          "mode": "二黄摇板",
          "content": "哪个儿子不养娘亲！"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "母亲不必动怒，孩儿我养活母亲了。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "哦，养活为娘了？"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "正是。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "好吓。"
        },
        {
          "type": "lyric",
          "speaker": "康氏",
          "mode": "二黄摇板",
          "content": "好个张义多孝顺，你兄长不思养育恩。母子双双寒窑进。"
        },
        {
          "type": "lyric",
          "speaker": "张义",
          "mode": "二黄摇板",
          "content": "孩儿起了登程心。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "孩儿要去到任上，找我那兄长。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "儿吓，那兄嫂不孝之人，寻他做甚？"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "孩儿去心一定。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "为娘也不阻拦与你。这儿有拐杖一根，到了任上，打也打得，骂也骂得。你问他身从何处来？"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "母亲所养。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "官从何处起？"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "母亲的训教。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "我儿请上，受为娘一拜！"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "母亲，岂不折杀孩儿了！"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "儿吓，为娘并非拜你，乃拜的你那不义的兄嫂！"
        },
        {
          "type": "lyric",
          "speaker": "康氏",
          "mode": "二黄摇板",
          "content": "张义请上受娘拜，叫声我儿听开怀：你骂他不是我后代，为何一去不回来？"
        },
        {
          "type": "lyric",
          "speaker": "张义",
          "mode": "二黄摇板",
          "content": "辞别母亲出窑门，"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "转来。"
        },
        {
          "type": "lyric",
          "speaker": "张义",
          "mode": "二黄摇板",
          "content": "母亲有话快讲明。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "儿吓，此番前去，必须早去早回！"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "却是为何？"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "我说你那无义的兄嫂死在外面！"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "呀吓，"
        },
        {
          "type": "lyric",
          "speaker": "张义",
          "mode": "二黄摇板",
          "content": "母亲一言来提醒，提起南柯梦中人。"
        },
        {
          "type": "dialogue",
          "speaker": "张义",
          "mode": "白",
          "content": "我怕。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "你怕什么？"
        },
        {
          "type": "lyric",
          "speaker": "张义",
          "mode": "二黄摇板",
          "content": "怕的此去丧了命，白发人反送黑发人。辞别母亲往前奔，不见兄嫂不回程。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏、张义",
          "mode": "同三叫头",
          "content": "（母亲）（张义），（老娘）（我儿）呀，啊，（娘）（我的儿呀）！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "张义下。"
        },
        {
          "type": "lyric",
          "speaker": "康氏",
          "mode": "二黄摇板",
          "content": "张义儿上了阳关道，不由老身痛在心。悲悲切切寒窑进，且听我儿好信音。"
        },
        {
          "type": "dialogue",
          "speaker": "康氏",
          "mode": "白",
          "content": "儿呀！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "content": "康氏下。"
        }
      ],
      "stats": {
        "line_count": 162,
        "lyric_ratio": 0.22,
        "stage_direction_count": 5
      }
    }
  ]
