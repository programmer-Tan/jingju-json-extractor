  "scenes": [
    {
      "scene_id": 1,
      "title": "夜访秦府",
      "characters_on_stage": [
        "秦琼",
        "秦怀玉",
        "院子",
        "旗牌",
        "程咬金"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "院子上。秦怀玉搀秦琼同上。"
        },
        {
          "type": "lyric",
          "speaker": "秦琼",
          "mode": "西皮摇板",
          "content": "投唐保国扶江山，东荡西除马上眠。自从扫贼回朝转，身得疾病有一年。嗟叹日红落西晚，心中焦躁不耐烦。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "旗牌打灯引程咬金同上。"
        },
        {
          "type": "lyric",
          "speaker": "程咬金",
          "mode": "西皮摇板",
          "content": "万岁金殿把旨传，晓谕文武共两班：明日过府把病探，怕的是泄漏巧机关。"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "来此秦府。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "前去通报：鲁国公要见。"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "门上哪位？"
        },
        {
          "type": "dialogue",
          "speaker": "院子",
          "mode": "白",
          "content": "什么人？"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "鲁国公要见。"
        },
        {
          "type": "dialogue",
          "speaker": "院子",
          "mode": "白",
          "content": "候着。启爵主：鲁国公要见。"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "爹爹，程叔父到。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "我儿出迎。"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "遵命。"
        },
        {
          "type": "lyric",
          "speaker": "秦怀玉",
          "mode": "西皮摇板",
          "content": "怀玉出行府门前，人讲礼仪孝为先。"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "迎接叔父。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "罢了。贤侄，你父病体如何？"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "照常一样。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "今在何处？"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "现在病房。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "带路。"
        },
        {
          "type": "lyric",
          "speaker": "程咬金",
          "mode": "西皮摇板",
          "content": "来在病房用目观，观看二哥旧容颜。疾病缠身容颜变，形容不比旧当年。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "二哥醒来。"
        },
        {
          "type": "lyric",
          "speaker": "秦琼",
          "mode": "西皮摇板",
          "content": "适才朦胧双合眼，听得耳旁有人言。猛然睁开昏花眼，只见贤弟在眼前。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "贤弟请坐。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "有座。二哥病体如何？"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "十分沉重。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "需要保重。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "咳！贤弟，连夜过府何事？"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "二哥，我有一桩要紧之事与你商量，你要依我。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "贤弟，自结金兰，数十余载，患难相顾，有什么事，愚兄依你就是。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "二哥有所不知，今有张士贵有本回朝，招军已满，请主发兵征东。万岁见你染病在床，无人挂帅。可恨牛鼻子老道，保尉迟恭挂帅。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "那尉迟恭乃是一介村夫，况且目不识丁，怎能掌得帅印？"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "小弟因为此事，与黑贼、军师争论几句。圣上命我前来取印。小弟心中想了一想，这颗印二哥执掌多年，若是前来取印，岂不白白送与这黑贼？那时弟在午门闲游一会，上殿谎奏，只望几句花言巧语蒙过圣上。谁知牛鼻子老道启奏一本，请圣上亲自过府，一来探病，二来取印。想这些事二哥一概不知，因此星夜过府，与你通知此事。倘若圣上明日到府，问起取印之事，你就说小弟来过府上，岂不周全小弟无罪。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "这个愚兄知道。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "二哥，想你我兄弟投唐——"
        },
        {
          "type": "lyric",
          "speaker": "程咬金",
          "mode": "西皮摇板",
          "content": "垂髫相交数十年，并无分手过一天。生死患难共相顾，这桩心事要周全。"
        },
        {
          "type": "lyric",
          "speaker": "秦琼",
          "mode": "西皮摇板",
          "content": "贤弟只管放宽心，些须小事我应承。可叹万岁见识浅，听信军师乱用人。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "怀玉取印过来。"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "是。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "放在床前。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "二哥，明日黑贼保驾前来，你必须要用几句狂言，摆布于他，也免得他在人前耀武扬威。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "贤弟，愚兄自有言语摆布与他。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "〖起三更鼓〗。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "贤弟，夜已深了，请回去罢。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "小弟方才说的话，你要紧记，告辞了。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "怀玉送过叔父。"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "是。"
        },
        {
          "type": "lyric",
          "speaker": "程咬金",
          "mode": "西皮摇板",
          "content": "你我投唐数十年，为主江山哪得闲。辞别二哥抽身转，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "秦琼下。"
        },
        {
          "type": "lyric",
          "speaker": "程咬金",
          "mode": "西皮摇板",
          "content": "猛然想起巧机关。"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "送过叔父。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "怀玉转来。"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "叔父有何吩咐？"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "你可知道你父亲之病，因何而得？"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "是金殿之上，比武而得。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "这倒不是。为叔不讲，你也不知：昔日在美良川打鞭换锏，马跳红衣涧，你父在马上伤及胸膛，故而成病，至今才发。娃娃，这是你，别个我是不讲得。"
        },
        {
          "type": "lyric",
          "speaker": "程咬金",
          "mode": "西皮摇板",
          "content": "昔日大战美良川，打鞭换锏得病还。你父忍伤称好汉，有仇不报枉为男。明日只管将他打，打出祸来我承当，与你无干。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "你要记下了。"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "送叔父。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "转来。"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "有何吩咐？"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "明日圣上过府，黑贼保驾前来，你父亲用言语激发与他，必定斗骂，那时节你只管打他。"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "他乃是开国元勋，侄儿不敢打。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "咳，怕什么开国元勋。你父亲也是开国元勋，只管打！"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "打出祸来，怕圣上降罪。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "不妨，你也无职，降你什么罪？"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "侄儿打他不过。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "年幼后生，说的软弱话。你若打不过，为叔前来帮助与你。"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "侄儿遵命。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "记下了。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "程咬金下。"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "送叔父。"
        },
        {
          "type": "lyric",
          "speaker": "秦怀玉",
          "mode": "西皮摇板",
          "content": "适才叔父对我言，为的昔日旧仇冤。为子若把父仇报，暗用心机不漏言。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "秦怀玉下。"
        }
      ],
      "stats": {
        "line_count": 132,
        "lyric_ratio": 0.41,
        "stage_direction_count": 7
      }
    },
    {
      "scene_id": 2,
      "title": "御驾取印",
      "characters_on_stage": [
        "李世民",
        "徐勣",
        "尉迟恭",
        "程咬金",
        "秦怀玉",
        "秦琼",
        "院子",
        "四太监",
        "四大铠"
      ],
      "segments": [
        {
          "type": "dialogue",
          "speaker": "李世民",
          "mode": "内白",
          "content": "起驾。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四太监、四大铠、徐勣、尉迟恭、程咬金、李世民同上。秦怀玉上。"
        },
        {
          "type": "dialogue",
          "speaker": "李世民",
          "mode": "白",
          "content": "怀玉，你父亲病体如何？"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "十分沉重。"
        },
        {
          "type": "dialogue",
          "speaker": "李世民",
          "mode": "白",
          "content": "孤王亲自前来看病。"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "领旨。"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "念",
          "content": "君入臣门地，蓬荜又生辉。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "秦怀玉下。"
        },
        {
          "type": "dialogue",
          "speaker": "李世民",
          "mode": "白",
          "content": "尉迟王兄，少时恩公若问征东命何人挂帅，孤言及命卿，他乃有病之人恐言语不顺，你需要忍耐些。"
        },
        {
          "type": "dialogue",
          "speaker": "尉迟恭",
          "mode": "白",
          "content": "领旨。"
        },
        {
          "type": "dialogue",
          "speaker": "李世民",
          "mode": "白",
          "content": "程王兄吩咐銮驾府外伺候。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "领旨。銮驾府外伺候。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "秦怀玉上。"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "启万岁：臣父睡卧不醒，叫之不应，请驾回。"
        },
        {
          "type": "dialogue",
          "speaker": "李世民",
          "mode": "白",
          "content": "孤王特为你父亲病体而来，再去通报，说孤王在此等候。"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "领旨。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "秦怀玉下。"
        },
        {
          "type": "dialogue",
          "speaker": "李世民",
          "mode": "白",
          "content": "皇兄吓。"
        },
        {
          "type": "lyric",
          "speaker": "李世民",
          "mode": "西皮摇板",
          "content": "齐摆銮驾到府门，华堂内外喜盈盈。山水古书多齐整，屏内奇花色色新。君臣暂在厅堂等，且候怀玉回信音。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "秦怀玉上。"
        },
        {
          "type": "lyric",
          "speaker": "秦怀玉",
          "mode": "西皮摇板",
          "content": "君入臣门多侥幸，龙行一步百草生。"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "臣启万岁：臣父昏迷不醒，请驾回宫。"
        },
        {
          "type": "dialogue",
          "speaker": "李世民",
          "mode": "白",
          "content": "徐王兄，恩公叫之不应，如何是好？"
        },
        {
          "type": "dialogue",
          "speaker": "徐勣",
          "mode": "白",
          "content": "万岁亲入病房，将他唤醒。"
        },
        {
          "type": "dialogue",
          "speaker": "李世民",
          "mode": "白",
          "content": "怀玉引孤到病房。"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "领旨。"
        },
        {
          "type": "lyric",
          "speaker": "李世民",
          "mode": "西皮摇板",
          "content": "恩公睡卧不得醒，去至病房看假真。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "众人同下。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "院子扶秦琼同上。"
        },
        {
          "type": "lyric",
          "speaker": "秦琼",
          "mode": "西皮摇板",
          "content": "昨夜咬金来报信，果然今日驾临门。假装昏迷睡不醒，且看万岁怎样行。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "李世民、秦怀玉、徐勣、尉迟恭同上。"
        },
        {
          "type": "lyric",
          "speaker": "李世民",
          "mode": "西皮摇板",
          "content": "孤王御驾来探病，功劳买动帝王心。迈步且把病房进，只见恩公睡沉沉。"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "爹爹，圣驾到。"
        },
        {
          "type": "dialogue",
          "speaker": "李世民",
          "mode": "白",
          "content": "恩公醒来。"
        },
        {
          "type": "lyric",
          "speaker": "秦琼",
          "mode": "西皮摇板",
          "content": "一觉睡卧方才醒，耳旁又听有人声。猛然睁开昏花眼，"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "哎呀！"
        },
        {
          "type": "lyric",
          "speaker": "秦琼",
          "mode": "西皮摇板",
          "content": "抬头只见帝王君。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "怀玉，万岁驾到，为何不来通报为父知道？"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "孩儿看爹爹睡卧不醒，不敢惊动。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "吓，既是为父不醒就该推醒，圣驾亲到病房，儿才通报，就该万死之罪。"
        },
        {
          "type": "dialogue",
          "speaker": "李世民",
          "mode": "白",
          "content": "寡人自进，休怪小爱卿。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "不是圣上开恩，定要问罪，谢过万岁。"
        },
        {
          "type": "dialogue",
          "speaker": "秦怀玉",
          "mode": "白",
          "content": "谢万岁。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "万岁驾到，臣病在身，未曾接驾，万岁恕罪。"
        },
        {
          "type": "dialogue",
          "speaker": "李世民",
          "mode": "白",
          "content": "你乃有病之人，何处此言。病体如何？"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "照常一样，呕吐不止。"
        },
        {
          "type": "dialogue",
          "speaker": "李世民",
          "mode": "白",
          "content": "你乃久病之人，何须忧虑。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "虽然久病之人，比前更重。"
        },
        {
          "type": "dialogue",
          "speaker": "尉迟恭",
          "mode": "白",
          "content": "元帅，某家这几日有朝事在身，少来问候，今日随驾与元帅问安。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "二哥你可曾听见：这几日他有朝事在身，少来问候，今日保驾前来，带来问问你的安。二哥你要领他的情吓。"
        },
        {
          "type": "dialogue",
          "speaker": "徐勣",
          "mode": "白",
          "content": "你少开口。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "我就不开口。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "万岁，征东之事，怎样发落？"
        },
        {
          "type": "dialogue",
          "speaker": "李世民",
          "mode": "白",
          "content": "寡人昨日设朝，张士贵招军已满，战船造齐，有本进京，请孤兴兵。见你染病在床，无人挂帅，孤心未决。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "万岁兴兵事大，臣病吓——"
        },
        {
          "type": "lyric",
          "speaker": "秦琼",
          "mode": "西皮原板",
          "content": "染病缠身整一春，是吉是凶担忧心。残生难逃幽冥境，不能与主定太平。"
        },
        {
          "type": "lyric",
          "speaker": "李世民",
          "mode": "西皮原板",
          "content": "孤王一见痛伤情，好似狼牙箭穿心。恩公病重难挂帅，何人与孤领雄兵？"
        },
        {
          "type": "lyric",
          "speaker": "秦琼",
          "mode": "西皮原板",
          "content": "怀玉臣子年纪轻，文韬武略将超群。胸中颇有安邦论，可以挂帅领雄兵。"
        },
        {
          "type": "lyric",
          "speaker": "李世民",
          "mode": "西皮原板",
          "content": "恩公说话不思论，寡人言来你且听：此番征东把贼剿，尽是开国老元勋。怀玉虽然武艺好，年幼焉能压公卿？况且王兄身有病，现在膝下奉晨昏。"
        },
        {
          "type": "lyric",
          "speaker": "秦琼",
          "mode": "西皮原板",
          "content": "甘罗十二为相品，无志空长百岁人。臣子年幼难挂帅，何人替主掌权衡？"
        },
        {
          "type": "lyric",
          "speaker": "李世民",
          "mode": "西皮原板",
          "content": "昨日金殿同议论，"
        },
        {
          "type": "lyric",
          "speaker": "李世民",
          "mode": "西皮快板",
          "content": "公保尉迟老将军。因此孤王来请印，即日兴兵往东征。"
        },
        {
          "type": "lyric",
          "speaker": "秦琼",
          "mode": "西皮快板",
          "content": "听说尉迟挂帅印，急得我心头火似焚。为臣竭力把唐顺，东西杀来南北征。提兵调将威风凛，并无差误半毫分。虽然染病难挂帅，我岂将印信让他人？尉迟有勇无学问，怎能挂印领雄兵？非是为臣抗君命，万岁本是错用人。"
        },
        {
          "type": "lyric",
          "speaker": "徐勣",
          "mode": "西皮流水板",
          "content": "休道万岁错用人，病困绳索利在心。将军卧病一年整，无人挂帅掌权衡。某家暂挂元帅印，剿灭辽东盖苏文。且等将军病安稳，再往高丽扫狼烟。万岁行事比尧舜，岂负你开国老元勋？"
        },
        {
          "type": "lyric",
          "speaker": "尉迟恭",
          "mode": "西皮流水板",
          "content": "元帅息怒且消停，末将言来你且听：双锏打出唐社稷，某单鞭争来锦乾坤。某家虽然无学问，可以挂帅领将兵。征战辽东干戈定，帅印依旧付将军。非是有意来夺印，元帅还要三思行。"
        },
        {
          "type": "lyric",
          "speaker": "程咬金",
          "mode": "西皮流水板",
          "content": "黑贼不必逞舌能，我等俱是有功臣。投唐国公三十八，岂无尉迟一人能？无才无学能挂印，俺咬金可以领雄兵。"
        },
        {
          "type": "dialogue",
          "speaker": "尉迟恭",
          "mode": "白",
          "content": "你不能！"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "你也不能！"
        },
        {
          "type": "dialogue",
          "speaker": "徐勣",
          "mode": "白",
          "content": "多嘴！"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "总是你帮他！"
        },
        {
          "type": "lyric",
          "speaker": "李世民",
          "mode": "西皮流水板",
          "content": "二位王兄免争论，多是开国老元勋。尉迟王兄挂得印，程王兄可以领雄兵。太平原是将军定，原要将军定太平。海外一扫狼烟尽，不伏辽东盖苏文。打来战表欺孤王，灭却高丽称我心。恩公不肯退帅印，军中大事去不成。"
        },
        {
          "type": "lyric",
          "speaker": "秦琼",
          "mode": "西皮导板",
          "content": "狼烟一起主亲征，"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "万岁，为臣焉敢拦阻？圣上此番东征，三年不知，五载不晓，想臣病只在危急之中，倘有不测，主在边庭，君不能见臣，臣不能见君。臣子怀玉年幼，未受王恩，尚未婚配，臣死九泉之下，也不瞑目的吓。"
        },
        {
          "type": "lyric",
          "speaker": "秦琼",
          "mode": "西皮摇板",
          "content": "我死九泉不甘心。"
        },
        {
          "type": "lyric",
          "speaker": "李世民",
          "mode": "西皮二六板",
          "content": "孤王心中似雷震，铁石人闻也泪淋。王兄只管心拿定，此事有孤免挂心。倘若不测遭不幸，须听为王赐表旌。追封王位归正品，儿孙代代入朝门。孤有公主银瓶女，赐与怀玉配为婚。众位王兄为媒证，吉日婚配孤起程，孤的王兄放宽心。"
        },
        {
          "type": "lyric",
          "speaker": "秦琼",
          "mode": "西皮摇板",
          "content": "叔宝闻言心安稳，纵死九泉也甘心。在枕上叩首龙恩谢，转回再谢众公卿。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "怀玉！"
        },
        {
          "type": "lyric",
          "speaker": "秦琼",
          "mode": "西皮二六板",
          "content": "叫怀玉近前听父命，万岁金言记在心：为父不幸遭不测，追封王位葬山林。怀玉父子受职品，银屏公主配为婚。伯叔公卿为媒证，即日婚配驾起程。我的儿向前顿首禀，三跪九叩谢王恩。"
        },
        {
          "type": "lyric",
          "speaker": "秦怀玉",
          "mode": "西皮摇板",
          "content": "怀玉床前遵父命，含悲忍泪谢王恩：蒙主赐臣父职品，食王爵禄报君恩。叩罢万岁龙恩盛，回头再谢叔父尊：侄儿在朝受恩重，还望叔父好看成。倘有一点差池处，还看侄儿年纪轻。"
        },
        {
          "type": "lyric",
          "speaker": "程咬金",
          "mode": "西皮摇板",
          "content": "怀玉只管乱胡行，万事有俺程咬金。你父身归蓬莱境，当今驸马怕谁人？打死谗臣除奸佞，天大祸儿我耽承，我的儿你是个驸马公卿！"
        },
        {
          "type": "lyric",
          "speaker": "秦琼",
          "mode": "西皮快板",
          "content": "咬金不必逞舌能，不是良言训子孙。我儿在朝受王恩，大事全仗徐先生。年幼须要你教训，须念当初结拜情。叫怀玉请过兵帅印，再听为父细叮咛。后堂设宴安排定，好与为父把孝行。"
        },
        {
          "type": "lyric",
          "speaker": "秦怀玉",
          "mode": "西皮摇板",
          "content": "父亲严命不留停，准备酒宴来饯行。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "秦怀玉下。"
        },
        {
          "type": "lyric",
          "speaker": "秦琼",
          "mode": "西皮快板",
          "content": "床前摆列元帅印，见物情伤好惨心。为臣挂印威风凛，灭贼平寇定乾坤。忧民忧国多劳顿，保王社稷数十春。今日身得沉重病，印信推让姓尉迟的人。咽喉哽哽语难尽，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "秦琼吐血。"
        },
        {
          "type": "lyric",
          "speaker": "秦琼",
          "mode": "西皮摇板",
          "content": "再与尉迟把话云。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "尉迟将军，圣上征东，可是命你为帅？"
        },
        {
          "type": "dialogue",
          "speaker": "尉迟恭",
          "mode": "白",
          "content": "命我为帅。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "你可知挂帅的道理？"
        },
        {
          "type": "dialogue",
          "speaker": "尉迟恭",
          "mode": "白",
          "content": "身为武将，怎么不知？"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "你且讲来。"
        },
        {
          "type": "dialogue",
          "speaker": "尉迟恭",
          "mode": "白",
          "content": "元帅听道：为帅者，盔缨灿烂，铠甲鲜明，刀枪耀日，战鼓齐鸣。安营坚固，大营点兵，须要强壮，上阵须观动静；若是不能取胜，某家匹马单鞭，杀到万马营中，战他三回九合，方可收兵。才是元帅之道。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "放屁！"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "此乃一派胡言！跪下，待本帅教导与你。"
        },
        {
          "type": "dialogue",
          "speaker": "尉迟恭",
          "mode": "白",
          "content": "元帅有何金言吩咐，当面领教，要跪却不能。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "一定要跪。"
        },
        {
          "type": "dialogue",
          "speaker": "尉迟恭",
          "mode": "白",
          "content": "谁来跪你！"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "若是命我为帅，我就跪他一年无妨！"
        },
        {
          "type": "dialogue",
          "speaker": "李世民",
          "mode": "白",
          "content": "尉迟王兄，念在征东事大，看孤王分上跪下罢。"
        },
        {
          "type": "dialogue",
          "speaker": "尉迟恭",
          "mode": "白",
          "content": "领旨。看在万岁金面，权且跪下。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "两条腿多要跪下。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "听我吩咐：为帅者，必须要饱读经纶，熟知战策，决胜千里之外，运筹帷幄之中；兵马不可糟蹋青苗，将士不可扰害良民；安营扎寨，须靠水而近山；遇高山，莫先登，遇空城，勿乱入。高防围困，低防水淹，深林防埋伏，绿林防火攻，身为元帅，令不乱传，得功升赏，违令责罚，又道：“朝中天子诏三宣，阃外将军发一令”；令出山摇动，言发鬼神惊，受得苦中苦，方为人上人。须要牢牢记下。"
        },
        {
          "type": "dialogue",
          "speaker": "程咬金",
          "mode": "白",
          "content": "这才服了我的心。"
        },
        {
          "type": "dialogue",
          "speaker": "尉迟恭",
          "mode": "白",
          "content": "末将记下了。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "印在此，拿去。"
        },
        {
          "type": "dialogue",
          "speaker": "尉迟恭",
          "mode": "白",
          "content": "拿来。"
        },
        {
          "type": "dialogue",
          "speaker": "秦琼",
          "mode": "白",
          "content": "呀，想这帅印乃是万岁御赐与我，理当交与圣上，你是甚等之人，敢伸手夺印，好不知羞耻！"
        },
        {
          "type": "lyric",
          "speaker": "秦琼",
          "mode": "西皮快板",
          "content": "不记得大战美良川，三鞭两锏定输赢：三鞭打不退秦叔宝，两锏打走姓尉人。今日得病难挂帅，敢到帅府夺兵权。不看万岁金面情，定要叉出帅府门。"
        },
        {
          "type": "lyric",
          "speaker": "尉迟恭",
          "mode": "西皮摇板",
          "content": "可恨秦琼心太狠，藐视尉迟一品臣。就是某家来取印，只为辽东盖苏文。战表不住报得紧，万岁金殿宣老臣。军师命某挂帅印，为什么不肯让与人？怒气不息到前厅，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "尉迟恭下。"
        },
        {
          "type": "lyric",
          "speaker": "程咬金",
          "mode": "西皮摇板",
          "content": "程咬金随后听信音。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "程咬金下。"
        },
        {
          "type": "lyric",
          "speaker": "徐勣",
          "mode": "西皮摇板",
          "content": "准备酒宴多齐整，特请万岁饮杯巡。"
        },
        {
          "type": "lyric",
          "speaker": "秦琼",
          "mode": "西皮摇板",
          "content": "后堂饮宴多安顿，请先生陪驾饮杯巡。"
        },
        {
          "type": "lyric",
          "speaker": "李世民",
          "mode": "西皮摇板",
          "content": "辞别恩公把酒饮，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "李世民下。"
        },
        {
          "type": "lyric",
          "speaker": "徐勣",
          "mode": "西皮摇板",
          "content": "后堂陪宴天子尊。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "徐勣下。"
        },
        {
          "type": "lyric",
          "speaker": "秦琼",
          "mode": "西皮摇板",
          "content": "好个有道圣明君，赛过尧舜掌龙庭。嗟叹秦琼身染病，不能替主扫烟尘。"
        },
        {
          "type": "stage_direction",
