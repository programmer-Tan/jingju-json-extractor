  "scenes": [
    {
      "scene_id": 1,
      "title": "",
      "characters_on_stage": [
        "公孙杵臼",
        "程婴"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "公孙杵臼上"
        },
        {
          "type": "lyric",
          "speaker": "公孙杵臼",
          "mode": "引子",
          "content": "赵屠结怨恨，恨奸贼，何日罢休"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "老汉公孙杵臼，曾在赵家为门客。可恨屠贼，误杀赵家三百余口。只剩庄姬一人，逃进宫去。闻得屠贼进宫搜孤，天呐天呐，看看忠良无救了"
        },
        {
          "type": "lyric",
          "speaker": "公孙杵臼",
          "mode": "二黄摇板",
          "content": "可恨屠贼太欺心，误杀赵家一满门。看看忠良无救应，大事还要问程婴"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "内白",
          "content": "走吓"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "程婴上"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄摇板",
          "content": "适才屠贼传一令，要害晋国众儿孙"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "来此已是。公孙兄在家么"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "哪一个"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "小弟来了"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "请进"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "晋国之中，又出了一种奇事"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "什么奇事"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "屠贼进宫搜孤，未曾搜出孤儿，出下赏格在外：十日之内，有人献出孤儿，赏赐千金；十日之内，若无孤儿下落，要将这晋国之中，与孤儿同庚者，斩尽杀绝"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "愚兄早已知道，你的来意如何"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "小弟来意，与公孙兄商议"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "愚兄慌忙无计"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "弟倒有计在此"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "你有何妙计"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "只要有人舍得一命，舍得一子，方能搭救孤儿"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "愚兄若大年纪，死亦何惧，情愿舍命，但不知何人舍子"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "小弟家中，现有一子，与孤儿同庚，将我儿藏在你家，将孤儿掉换，倘若屠贼前来搜寻，尤恐连累与你"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "弟妇可曾应允"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "你那弟妇那是贤德的"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "快快回去商议"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "告辞了"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "请"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄摇板",
          "content": "公孙兄且把心放定，救孤之事我担承"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "程婴下"
        },
        {
          "type": "lyric",
          "speaker": "公孙杵臼",
          "mode": "二黄摇板",
          "content": "但愿救得忠良后，满斗焚香谢神灵"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "公孙杵臼下"
        }
      ],
      "stats": {
        "line_count": 27,
        "lyric_ratio": 0.33,
        "stage_direction_count": 4
      }
    },
    {
      "scene_id": 2,
      "title": "",
      "characters_on_stage": [
        "程妻",
        "程婴"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "程妻上"
        },
        {
          "type": "lyric",
          "speaker": "程妻",
          "mode": "引子",
          "content": "仗义救孤身，妻随夫志行"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "程婴上"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "念",
          "content": "大事安排定，劝妻舍亲生"
        },
        {
          "type": "dialogue",
          "speaker": "程妻",
          "mode": "白",
          "content": "官人回来了，请坐"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "有座。唉！"
        },
        {
          "type": "dialogue",
          "speaker": "程妻",
          "mode": "白",
          "content": "官人，我想相国，忠心为国，爱民如子，反遭灭门大祸，眼见上天没有报应了！"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "卑人也是这等讲，只是那贼又出了狠毒的心了！"
        },
        {
          "type": "dialogue",
          "speaker": "程妻",
          "mode": "白",
          "content": "又出了什么狠毒的心？"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "搜孤不出，有赏格在外：十日之内，有人献出孤儿便罢；若无人献出孤儿，要将晋国中与孤儿同庚者，尽行斩绝。"
        },
        {
          "type": "dialogue",
          "speaker": "程妻",
          "mode": "白",
          "content": "想屠贼如此的行事，只怕孤儿难保也！"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "卑人有一两全之计，可以救得孤儿。"
        },
        {
          "type": "dialogue",
          "speaker": "程妻",
          "mode": "白",
          "content": "有何两全之计？"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "只要有人舍得一命，舍得一子，可以救得孤儿。"
        },
        {
          "type": "dialogue",
          "speaker": "程妻",
          "mode": "白",
          "content": "何人能得舍命？"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "就是公孙老爷，情愿舍命。"
        },
        {
          "type": "dialogue",
          "speaker": "程妻",
          "mode": "白",
          "content": "还有何人舍子？"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "乃是卑人许他……"
        },
        {
          "type": "dialogue",
          "speaker": "程妻",
          "mode": "白",
          "content": "许他什么？"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "娘子，你我夫妻，受过赵相大恩，眼见孤儿无救。你我夫妻，所生一子，舍了也罢，替换孤儿，也好接代赵氏门中后裔。"
        },
        {
          "type": "dialogue",
          "speaker": "程妻",
          "mode": "白",
          "content": "官人此言差矣！你我所生一子，岂肯搭救他人，那是万万不能！"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "娘子吓！"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄原板",
          "content": "娘子不必太烈性，卑人言来听分明：赵屠二家结仇恨，三百余口命归阴。你今救得忠良后，赵家代代感你的恩！"
        },
        {
          "type": "lyric",
          "speaker": "程妻",
          "mode": "二黄原板",
          "content": "官人说话理虽顺，妾身言来听分明：你今有了五十整，妾身也有四十春。夫妻只生一个子，怎肯舍子救他人？"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄原板",
          "content": "卑人五十不算老，娘子年纪倒还轻。你今舍了亲生子，来年必定降麒麟。"
        },
        {
          "type": "lyric",
          "speaker": "程妻",
          "mode": "二黄原板",
          "content": "赵家犯罪赵家受，为什么连累小姣生？"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄摇板",
          "content": "再三相劝她不应，不舍子来孤难存。没奈何只得忙跪定，哀劝娘子舍亲生！"
        },
        {
          "type": "lyric",
          "speaker": "程妻",
          "mode": "二黄摇板",
          "content": "你要跪来你就跪，叫我舍子万不能"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄摇板",
          "content": "常言道妇人心肠狠，最毒不过妇人心！"
        },
        {
          "type": "lyric",
          "speaker": "程妻",
          "mode": "二黄摇板",
          "content": "又道是虎狼不食子，你比虎狼狠十分！"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄摇板",
          "content": "倒不如程婴死了罢！"
        },
        {
          "type": "lyric",
          "speaker": "程妻",
          "mode": "二黄摇板",
          "content": "或生或死一路行！"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "也罢！"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄摇板",
          "content": "手拿钢刀取你命，"
        },
        {
          "type": "lyric",
          "speaker": "程妻",
          "mode": "二黄摇板",
          "content": "用手带上小房门。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "程妻下。公孙杵臼上。"
        }
      ],
      "stats": {
        "line_count": 35,
        "lyric_ratio": 0.51,
        "stage_direction_count": 3
      }
    },
    {
      "scene_id": 3,
      "title": "",
      "characters_on_stage": [
        "程婴",
        "公孙杵臼",
        "程妻"
      ],
      "segments": [
        {
          "type": "lyric",
          "speaker": "公孙杵臼",
          "mode": "二黄摇板",
          "content": "又与程婴把计定，不知他心与我心。"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "来此已是，待我进去。贤弟在家么？"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "公孙兄来了，请坐。"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "有座。弟妇可曾应允？"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "这贱人执意不肯！"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "请出弟妇，愚兄相劝。"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "是。娘子哪里？"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "程妻上。"
        },
        {
          "type": "dialogue",
          "speaker": "程妻",
          "mode": "白",
          "content": "来了，官人何事？"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "公孙兄来了，上前见过。"
        },
        {
          "type": "dialogue",
          "speaker": "程妻",
          "mode": "白",
          "content": "是。公孙老爷万福！"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "弟夫人来了，请坐。"
        },
        {
          "type": "dialogue",
          "speaker": "程妻",
          "mode": "白",
          "content": "有座。公孙老爷，到此何事？"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "弟夫人听你丈夫之言，舍了亲生之子，救得忠良之后。你今日舍了亲生子，来年必定降祥麟。"
        },
        {
          "type": "lyric",
          "speaker": "公孙杵臼",
          "mode": "二黄原板",
          "content": "人有善念天有神，莫大阴功此时行。弟妇舍了亲生子，来年必定降祥麟。"
        },
        {
          "type": "lyric",
          "speaker": "程妻",
          "mode": "二黄原板",
          "content": "公孙兄说话理难顺，我夫妻吵的乱纷纷。爱子搭救他人命，要我舍子万不能！"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "啊呀！"
        },
        {
          "type": "lyric",
          "speaker": "公孙杵臼",
          "mode": "二黄摇板",
          "content": "老汉的薄面情要准，"
        },
        {
          "type": "lyric",
          "speaker": "程妻",
          "mode": "二黄摇板",
          "content": "谁能舍子救他人？"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "唉！"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄摇板",
          "content": "看起来你就是无义人"
        },
        {
          "type": "lyric",
          "speaker": "程妻",
          "mode": "二黄摇板",
          "content": "你要尽忠奴不行。"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "也罢！"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄摇板",
          "content": "手拿钢刀来自刎，"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "且慢！"
        },
        {
          "type": "lyric",
          "speaker": "公孙杵臼",
          "mode": "二黄摇板",
          "content": "贤弟息怒慢稍停。走上前来言相劝，死了丈夫靠何人？"
        },
        {
          "type": "dialogue",
          "speaker": "程妻",
          "mode": "白",
          "content": "多口！"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "啊吓！"
        },
        {
          "type": "lyric",
          "speaker": "公孙杵臼",
          "mode": "二黄摇板",
          "content": "没奈何只得忙跪定，哀求弟妇舍亲生！"
        },
        {
          "type": "lyric",
          "speaker": "程妻",
          "mode": "二黄摇板",
          "content": "他二人哭得珠泪滚，铁石人儿也泪淋。公孙老爷你请起，奴家情愿舍亲生。"
        },
        {
          "type": "lyric",
          "speaker": "公孙杵臼",
          "mode": "二黄摇板",
          "content": "多谢弟妇开了恩，上得史书表得名！"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄摇板",
          "content": "多谢娘子舍亲生，你母子快快两离分。"
        },
        {
          "type": "dialogue",
          "speaker": "程妻",
          "mode": "白",
          "content": "啊吓！"
        },
        {
          "type": "lyric",
          "speaker": "程妻",
          "mode": "二黄摇板",
          "content": "一句话儿错出唇，把姣儿送在枉死城。怀抱姣儿泪难忍，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "程婴抢子，程婴、程妻、公孙杵臼同下。"
        }
      ],
      "stats": {
        "line_count": 34,
        "lyric_ratio": 0.53,
        "stage_direction_count": 2
      }
    },
    {
      "scene_id": 4,
      "title": "",
      "characters_on_stage": [
        "屠岸贾",
        "四龙套",
        "程婴"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四龙套同上，屠岸贾上。"
        },
        {
          "type": "lyric",
          "speaker": "屠岸贾",
          "mode": "念",
          "content": "斩草不除根，萌芽依旧生。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "老夫屠岸贾，前番进宫搜孤，未曾搜出孤儿。出下赏格在外：十日之内，有人献出孤儿，赏赐千金。今当十日已满，不见孤儿下落。校尉的伺候了。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "程婴上，击鼓。"
        },
        {
          "type": "dialogue",
          "speaker": "四龙套",
          "mode": "同白",
          "content": "有人击鼓。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "带进来。"
        },
        {
          "type": "dialogue",
          "speaker": "四龙套",
          "mode": "同白",
          "content": "击鼓人上堂。"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "来了。参见大人。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "唗！为何擅击老夫堂鼓？"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "小人有密言告禀。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "有何密言，当面讲来。"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "这个……耳目甚众。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "两旁俱是老夫心腹之人，但讲何妨。"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "前番大人进宫搜孤可曾搜出孤儿？"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "未曾搜出。"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "孤儿现在……"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "现在哪里？"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "现在首阳山公孙杵臼家中。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "校尉的，去到首阳山将公孙杵臼拿来见我！"
        },
        {
          "type": "dialogue",
          "speaker": "二龙套",
          "mode": "同白",
          "content": "遵命！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二龙套同下。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "你怎么知道？"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "小人与他曾在赵家以为门客，再三相劝，他执意不肯。恐怕牵连在内，前来出首与你。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "可是实言？"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "句句实言。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "你叫什么名字？"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "小人叫程婴。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "站过一旁。"
        }
      ],
      "stats": {
        "line_count": 26,
        "lyric_ratio": 0.04,
        "stage_direction_count": 3
      }
    },
    {
      "scene_id": 5,
      "title": "",
      "characters_on_stage": [
        "屠岸贾",
        "四龙套",
        "程婴",
        "公孙杵臼"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二龙套同上，公孙杵臼上。"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "参见大人。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "唗！胆大老狗，隐藏孤儿，为何不报？"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "小人隐藏孤儿，谁人得见？"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "抬头观看。"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "呵吓大人呐！他叫程婴。他与小人旧有仇恨，乃是诬告小人！"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "你在怎讲？"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "诬告小人！"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "住了！"
        },
        {
          "type": "lyric",
          "speaker": "屠岸贾",
          "mode": "二黄摇板",
          "content": "听罢言来怒气升，大骂老狗不是人！隐藏孤儿你不报，论皇法就该问斩刑！"
        },
        {
          "type": "lyric",
          "speaker": "公孙杵臼",
          "mode": "二黄摇板",
          "content": "白虎堂上禀一声，尊声大人听分明：只是程婴诬告我，拿什么孤儿与大人？"
        },
        {
          "type": "lyric",
          "speaker": "屠岸贾",
          "mode": "二黄摇板",
          "content": "白虎堂上开言问，不动大刑不招认。人来与我乱棍打，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四龙套同打公孙杵臼。"
        },
        {
          "type": "lyric",
          "speaker": "公孙杵臼",
          "mode": "二黄摇板",
          "content": "打死小人不招承！"
        },
        {
          "type": "lyric",
          "speaker": "屠岸贾",
          "mode": "二黄摇板",
          "content": "回头便把程婴叫，公堂赐你鞭一根。一边打来一边问，看他招承不招承！"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "遵命！"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄导板",
          "content": "白虎门领了大人命，"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "你与老夫重重的打！"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄叠板",
          "content": "可怜他为孤儿到如今连累了他白发苍苍受苦情，倒叫我好不伤心！"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄原板",
          "content": "背转身自思忖，好似钢刀刺在心。哪知道二人把计定，连累白发丧残生。使一个眼色把他问，公孙老爷你且听：你若说至死不招承，大人的王法不任情。手执皮鞭将你打，打你，打你，你不要胡言乱语诬攀好人。"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "好贼子吓！"
        },
        {
          "type": "lyric",
          "speaker": "公孙杵臼",
          "mode": "二黄摇板",
          "content": "手指程婴骂高声，你本忘恩负义人！我今一死不要紧，"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "贼吓，贼吓！"
        },
        {
          "type": "lyric",
          "speaker": "公孙杵臼",
          "mode": "二黄摇板",
          "content": "阴曹地府等你魂！"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄摇板",
          "content": "公孙老爷不招承，首阳山前去搜寻！"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "何不到他家中去寻找？"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "校尉的！"
        },
        {
          "type": "dialogue",
          "speaker": "四龙套",
          "mode": "同白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "打道首阳山。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四龙套同滑门。"
        },
        {
          "type": "dialogue",
          "speaker": "四龙套",
          "mode": "同白",
          "content": "来此首阳山。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "两厢搜来！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四龙套同搜，抱孤儿上。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "唗！胆大的老狗！隔壁墙内，婴孩哪里来的？"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "好贼子吓！"
        },
        {
          "type": "lyric",
          "speaker": "公孙杵臼",
          "mode": "二黄摇板",
          "content": "贼子做事太欺心，苦害忠良后代根。舍死忘生把孤儿抢，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "屠岸贾踢公孙杵臼。"
        },
        {
          "type": "lyric",
          "speaker": "屠岸贾",
          "mode": "二黄摇板",
          "content": "一足踢你地埃尘！人来与我忙上捆，"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄摇板",
          "content": "这是你飞蛾投火自烧生。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "校尉的，将孤儿与老狗绑赴法场。"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "好贼子吓！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二龙套、公孙杵臼同下。"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "小人讨祭。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "为何讨祭？"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "小人与他八拜之交，如不祭奠，岂不被天下人叫骂？"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "容你一祭。"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "多谢大人！"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄摇板",
          "content": "准备祭礼黄粱饭，一表当年故旧情。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "程婴下。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "校尉的，打道法场。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "屠岸贾、二龙套同下。"
        }
      ],
      "stats": {
        "line_count": 49,
        "lyric_ratio": 0.51,
        "stage_direction_count": 7
      }
    },
    {
      "scene_id": 6,
      "title": "",
      "characters_on_stage": [
        "公孙杵臼",
        "程婴",
        "屠岸贾",
        "四龙套"
      ],
      "segments": [
        {
          "type": "lyric",
          "speaker": "公孙杵臼",
          "mode": "内二黄导板",
          "content": "一片好心反成恨，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "公孙杵臼上。"
        },
        {
          "type": "lyric",
          "speaker": "公孙杵臼",
          "mode": "二黄原板",
          "content": "年迈苍苍血染身。将孤儿来在法场进，咬定牙关等时辰。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "程婴上。"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄摇板",
          "content": "手捧祭礼法场进，只见孤儿与公孙。"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "公孙兄，赵公子，你二人死在阴曹，休来怨我！"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄原板",
          "content": "我躬身施礼忙拜定，眼望孤儿两泪淋。法场上看的人人恨，个个叫骂我程婴。我是个负义之人，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "锣鼓。"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄原板",
          "content": "多道我享荣华富贵断送忠良后代根。可怜我好心成歹意，我这满腹含冤向谁明。"
        },
        {
          "type": "lyric",
          "speaker": "公孙杵臼",
          "mode": "二黄原板",
          "content": "我见他说话不留神，泄漏了机关事不成。去掉了好言换恶语，开言大骂小程婴：你不过贪图受富贵，断送忠良后代根！我今一死不要紧，一桩桩一件件记在心！"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄原板",
          "content": "公孙兄说话句句真，口口指教我程婴。我为孤儿丧了子，你为孤儿伤残生。我这里烧两把酒斟，"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "哭",
          "content": "公孙兄，我的亲……"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "程婴两边看。"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "哭",
          "content": "亲生的儿吓！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "程婴敬酒三杯，烧纸钱。"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄摇板",
          "content": "但愿灵魂早讨生。"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "有请大人。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "屠岸贾上，四龙套同上。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "可曾祭过？"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "已经祭过。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "校尉的。将孤儿与老狗，一齐开刀！"
        },
        {
          "type": "dialogue",
          "speaker": "公孙杵臼",
          "mode": "白",
          "content": "好贼子呀！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "公孙杵臼、四龙套同下。起鼓，四龙套同上。"
        },
        {
          "type": "dialogue",
          "speaker": "四龙套",
          "mode": "同白",
          "content": "斩首已毕。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "起过了。程婴，程婴！"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "在。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "呀，你为何落下泪来？"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "小人与他八拜之交，见他一死故而流泪。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "喔，是了。来！"
        },
        {
          "type": "dialogue",
          "speaker": "四龙套",
          "mode": "同白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "与程婴看赏。"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "且慢，小人不愿领赏。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "为何愿不领赏？"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "小人家中，现有一子，与孤儿同庚，怨怕旁人暗害我父子。"
        },
        {
          "type": "dialogue",
          "speaker": "屠岸贾",
          "mode": "白",
          "content": "将你儿子，保在老夫面前，料来无事。"
        },
        {
          "type": "dialogue",
          "speaker": "程婴",
          "mode": "白",
          "content": "遵命。"
        },
        {
          "type": "lyric",
          "speaker": "程婴",
          "mode": "二黄摇板",
          "content": "辞别大人回家门，奸贼中了我的巧计生！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "程婴下。"
        },
        {
          "type": "lyric",
          "speaker": "屠岸贾",
          "mode": "二黄摇板",
          "content": "老夫的仇人俱杀尽，这才是剪草又除根！"
        }
      ],
