  "scenes": [
    {
      "scene_id": 1,
      "title": "县衙接旨",
      "characters_on_stage": [
        "寇准",
        "四青袍",
        "金牌官",
        "家院"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四青袍同上，寇准上"
        },
        {
          "type": "lyric",
          "speaker": "寇准",
          "mode": "引子",
          "content": "做清官民之父母，积阴功留与儿孙"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "念",
          "content": "读诗书智广才高，中状元青史名表。三杯御酒加封号，被谗臣一本参掉"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "下官寇准，蒙圣恩得中一甲一名，又被权相参掉。是我在吏部效力三载，除授霞榖县正堂。到任以来，黎民倒也好训。今当三、六、九日，放告之期。左右将放告牌抬出"
        },
        {
          "type": "dialogue",
          "speaker": "金牌官",
          "mode": "内白",
          "content": "圣旨下"
        },
        {
          "type": "dialogue",
          "speaker": "四青袍",
          "mode": "白",
          "content": "圣旨下"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "有请！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "金牌官上"
        },
        {
          "type": "dialogue",
          "speaker": "金牌官",
          "mode": "白",
          "content": "金牌下，寇准听者：圣上有旨调寇准连夜进京，不得有误。"
        },
        {
          "type": "dialogue",
          "speaker": "金牌官",
          "mode": "念",
          "content": "金牌如虎啸"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "念",
          "content": "即刻便登程！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "金牌官下"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "掩门。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四青袍同下，家院上"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "有请夫人。"
        }
      ],
      "stats": {
        "line_count": 15,
        "lyric_ratio": 0.07,
        "stage_direction_count": 4
      }
    },
    {
      "scene_id": 2,
      "title": "别妻饯行",
      "characters_on_stage": [
        "寇准",
        "家院",
        "夫人",
        "丫鬟",
        "马牌子"
      ],
      "segments": [
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "白",
          "content": "有请夫人。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "夫人上"
        },
        {
          "type": "dialogue",
          "speaker": "夫人",
          "mode": "念",
          "content": "夫受皇家禄，妻沾雨露恩。"
        },
        {
          "type": "dialogue",
          "speaker": "夫人",
          "mode": "白",
          "content": "吓，老爷，"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "吓，夫人请坐。"
        },
        {
          "type": "dialogue",
          "speaker": "夫人",
          "mode": "白",
          "content": "适才金牌到此，不知为了何事？"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "金牌调我连夜进京，不知所为何事。"
        },
        {
          "type": "dialogue",
          "speaker": "夫人",
          "mode": "白",
          "content": "想是老爷为官清正，加官受爵，也未可知。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "但愿如此。"
        },
        {
          "type": "dialogue",
          "speaker": "夫人",
          "mode": "白",
          "content": "不知老爷几时起程？"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "即刻起程。"
        },
        {
          "type": "dialogue",
          "speaker": "夫人",
          "mode": "白",
          "content": "妾身备得有酒与老爷饯行。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "有劳夫人。看衣衾更换。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "寇准换衣。"
        },
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "白",
          "content": "马牌子走上。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "马牌子上。"
        },
        {
          "type": "dialogue",
          "speaker": "马牌子",
          "mode": "白",
          "content": "什么事？"
        },
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "白",
          "content": "老爷进京，命你备马二匹。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "马牌子允，下。"
        },
        {
          "type": "dialogue",
          "speaker": "夫人",
          "mode": "白",
          "content": "丫鬟看酒。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "丫鬟允。"
        },
        {
          "type": "lyric",
          "speaker": "夫人",
          "mode": "二黄原板",
          "content": "叫丫鬟看过了酒一樽，我与老爷来饯行。但愿老爷早到京，但愿得老爷步步高升。"
        },
        {
          "type": "lyric",
          "speaker": "寇准",
          "mode": "二黄原板",
          "content": "接过了夫人酒一樽，背转身来谢神灵。叫家院请右堂来护印，你就说你老爷即刻登程。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "家院下。"
        },
        {
          "type": "lyric",
          "speaker": "寇准",
          "mode": "二黄原板",
          "content": "夫人请上受一礼，礼下还有所托情：老母老母你孝顺，早晚侍奉要殷勤。辞别夫人跨金镫，披星戴月奔帝京。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "马牌子带马上，马牌下。寇准跨马，下。"
        },
        {
          "type": "lyric",
          "speaker": "夫人",
          "mode": "二黄摇板",
          "content": "一见老爷足踏镫，但愿老爷早回程。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "夫人下。"
        }
      ],
      "stats": {
        "line_count": 28,
        "lyric_ratio": 0.57,
        "stage_direction_count": 7
      }
    },
    {
      "scene_id": 3,
      "title": "夜宿馆驿",
      "characters_on_stage": [
        "寇准",
        "马牌子",
        "家院",
        "驿丞官"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "马牌子、家院、寇准同上，同走圆场。"
        },
        {
          "type": "lyric",
          "speaker": "寇准",
          "mode": "二黄摇板",
          "content": "马蹄踏遍路旁草，日落西山小桃红。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "寇准下马。"
        },
        {
          "type": "dialogue",
          "speaker": "马牌子",
          "mode": "白",
          "content": "咳，这里有人么？"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "驿丞官上。"
        },
        {
          "type": "dialogue",
          "speaker": "驿丞官",
          "mode": "白",
          "content": "什么人吵？"
        },
        {
          "type": "dialogue",
          "speaker": "马牌子",
          "mode": "白",
          "content": "我们跟寇老爷来的，安排什么地方？"
        },
        {
          "type": "dialogue",
          "speaker": "驿丞官",
          "mode": "白",
          "content": "你这么海外，你是什么人？"
        },
        {
          "type": "dialogue",
          "speaker": "马牌子",
          "mode": "白",
          "content": "我里里外外、上上下下一个马牌子！"
        },
        {
          "type": "dialogue",
          "speaker": "驿丞官",
          "mode": "白",
          "content": "哦，马牌子，认识我么？"
        },
        {
          "type": "dialogue",
          "speaker": "马牌子",
          "mode": "白",
          "content": "不认识。"
        },
        {
          "type": "dialogue",
          "speaker": "驿丞官",
          "mode": "白",
          "content": "我是驿丞官，单管你们马牌子！"
        },
        {
          "type": "dialogue",
          "speaker": "马牌子",
          "mode": "白",
          "content": "哎吓，上司老爷来了！带马遛了吧。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "马牌子下。"
        },
        {
          "type": "dialogue",
          "speaker": "驿丞官",
          "mode": "白",
          "content": "滚下去吧！参见大老爷。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "罢了。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "寇准、家院同进门。"
        },
        {
          "type": "dialogue",
          "speaker": "驿丞官",
          "mode": "白",
          "content": "老爷可用些什么？"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "前途俱已用过，取明灯一盏。"
        },
        {
          "type": "dialogue",
          "speaker": "驿丞官",
          "mode": "白",
          "content": "老爷，明灯到。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "退下了。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "驿丞官允，下。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "家院，四更时官带伺候。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "家院允，下。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "想我寇准，职授霞榖县令，上不亏君，下不亏民。金牌调我连夜进京，也不知所为何事。今夜独宿馆驿，好不愁闷人也！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "〖起初更鼓〗。"
        },
        {
          "type": "lyric",
          "speaker": "寇准",
          "mode": "二黄慢板",
          "content": "一更一点月东升，闷坐馆驿自思忖。臣伴君好一似羊伴虎，尽得忠来难把孝行。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "〖起二更鼓〗。"
        },
        {
          "type": "lyric",
          "speaker": "寇准",
          "mode": "二黄原板",
          "content": "二更二点月正明，睡不安来坐不宁。在霞榖并不曾亏负百姓，金牌调我所为何情？"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "〖起三更鼓〗。"
        },
        {
          "type": "lyric",
          "speaker": "寇准",
          "mode": "二黄原板",
          "content": "三更三点月照阶，想起了霞榖县管万民。早堂接状早堂审，午堂接状审得清。到晚来接下了无头状，一盏红灯审到天明。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "家院捧茶上。"
        },
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "白",
          "content": "请老爷更衣。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "〖起四更鼓〗。寇准换衣。"
        },
        {
          "type": "lyric",
          "speaker": "寇准",
          "mode": "二黄原板",
          "content": "四更时分衣冠正，叫一声家院听分明：回家去与老爷送上一信，一路之上莫要留停。若是夫人来问你，你就说你老爷平安到京。倘若是太夫人来问你，你就说你老爷已进京城，见万岁，一步一步，步步高升，请太夫人放心！"
        },
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "白",
          "content": "是。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "家院下。寇准出驿。"
        },
        {
          "type": "lyric",
          "speaker": "寇准",
          "mode": "二黄原板",
          "content": "朝臣待漏五更尽，铁甲将军夜渡津。东华门乃是文官走，西华门本是武将行。有寇准也打从东华门进，又听得两班内文武笑声。是是是来明白了，他笑我七品县令当今。有志何在官大小，无才枉受爵禄恩。撩袍端带御街进，品级台前口称臣。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "臣寇准见驾，吾皇万岁！"
        }
      ],
      "stats": {
        "line_count": 45,
        "lyric_ratio": 0.62,
        "stage_direction_count": 12
      }
    },
    {
      "scene_id": 4,
      "title": "金殿受封",
      "characters_on_stage": [
        "寇准",
        "宋王",
        "赵德芳",
        "太监"
      ],
      "segments": [
        {
          "type": "dialogue",
          "speaker": "宋王",
          "mode": "内白",
          "content": "卿家进京来了？"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "臣进京来了。调臣进京所为何事？"
        },
        {
          "type": "dialogue",
          "speaker": "宋王",
          "mode": "内白",
          "content": "调卿进京非为别事，只为潘、杨二家官事命卿审问。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "一家太师之职，一家郡马之职，臣官卑职小，难以审问。"
        },
        {
          "type": "dialogue",
          "speaker": "宋王",
          "mode": "内白",
          "content": "外廉御史，加升西台御史；外赐圣旨一道。审明回奏。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵德芳上，坐。太监捧圣旨上。"
        },
        {
          "type": "dialogue",
          "speaker": "太监",
          "mode": "念",
          "content": "金殿赐圣旨，"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "念",
          "content": "捧旨下龙庭。"
        },
        {
          "type": "dialogue",
          "speaker": "太监",
          "mode": "白",
          "content": "贤爷在此！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "参见八千岁。臣寇准见驾，念臣有圣旨在身，不能全礼，贤爷千岁！"
        },
        {
          "type": "dialogue",
          "speaker": "赵德芳",
          "mode": "白",
          "content": "寇卿回京来了？我叔皇调卿进京所为何事？"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "调臣进京，审问潘、杨二家官事。"
        },
        {
          "type": "dialogue",
          "speaker": "赵德芳",
          "mode": "白",
          "content": "卿可知前任御史之事？"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "臣却不知。"
        },
        {
          "type": "dialogue",
          "speaker": "赵德芳",
          "mode": "白",
          "content": "只因他审问潘、杨二家官事，不明不白，被小王金锏打死！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "内侍回复御旨。"
        },
        {
          "type": "dialogue",
          "speaker": "赵德芳",
          "mode": "白",
          "content": "且慢！卿家只管问。倘有不明之处，到我南清宫领教。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "臣领钧旨。"
        },
        {
          "type": "lyric",
          "speaker": "寇准",
          "mode": "二黄摇板",
          "content": "八千岁做了主大胆审问，哪怕潘洪是皇亲。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "寇准下。"
        },
        {
          "type": "lyric",
          "speaker": "赵德芳",
          "mode": "二黄摇板",
          "content": "好一个忠心小寇准，七品县令审皇亲。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵德芳下。"
        }
      ],
      "stats": {
        "line_count": 22,
        "lyric_ratio": 0.18,
        "stage_direction_count": 3
      }
    },
    {
      "scene_id": 5,
      "title": "受礼问计",
      "characters_on_stage": [
        "寇准",
        "四青袍",
        "马牌子",
        "太监"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四青袍、马牌子、寇准同上。"
        },
        {
          "type": "lyric",
          "speaker": "寇准",
          "mode": "二黄摇板",
          "content": "金殿之上奉圣命，升迁西台审皇亲。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "〖吹打〗。"
        },
        {
          "type": "dialogue",
          "speaker": "衙役",
          "mode": "内白",
          "content": "公公到！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "太监上。"
        },
        {
          "type": "dialogue",
          "speaker": "太监",
          "mode": "念",
          "content": "一封丹草诏，飞下九重霄。"
        },
        {
          "type": "dialogue",
          "speaker": "太监",
          "mode": "白",
          "content": "请旨！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "有请！公公驾到，未曾远迎，恕罪！"
        },
        {
          "type": "dialogue",
          "speaker": "太监",
          "mode": "白",
          "content": "恭喜寇老先生，贺喜寇老先生！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "喜从何来？"
        },
        {
          "type": "dialogue",
          "speaker": "太监",
          "mode": "白",
          "content": "七品县令升为西台御史，可喜可贺！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "公公提拔。"
        },
        {
          "type": "dialogue",
          "speaker": "太监",
          "mode": "白",
          "content": "潘、家二家官事，在贵衙审问么？"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "在敝衙审问。"
        },
        {
          "type": "dialogue",
          "speaker": "太监",
          "mode": "白",
          "content": "后宫潘娘娘有份礼单，拿去看来！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "好一份厚礼！吓，公公此礼为何？"
        },
        {
          "type": "dialogue",
          "speaker": "太监",
          "mode": "白",
          "content": "后宫潘娘娘有句话嘱咐你：只要太师在，不要太师坏。你要动了他一根毫毛，哥哥你这顶乌纱戴不牢了！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "王法森严，必须要照律而断！"
        },
        {
          "type": "dialogue",
          "speaker": "太监",
          "mode": "白",
          "content": "礼单收下！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "无功不受禄！"
        },
        {
          "type": "dialogue",
          "speaker": "太监",
          "mode": "白",
          "content": "受禄必有功！收下了好！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "不敢收！"
        },
        {
          "type": "dialogue",
          "speaker": "太监",
          "mode": "念",
          "content": "暂离西台地，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "太监下。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "念",
          "content": "王法不容情！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "且住，正要升堂理事，后宫潘娘娘有份礼单前来。若是收下，岂不学了前任御史之故；欲是不收，后宫潘娘娘降罪，这、这、这便如何是好？吓，有了，方才八千岁言道：若有为难之处，去往南清宫领教。我不免前去领教便了。来，打道南清宫。"
        },
        {
          "type": "lyric",
          "speaker": "寇准",
          "mode": "二黄摇板",
          "content": "吩咐人役把路引，南清宫内问分明。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "寇准下。"
        }
      ],
      "stats": {
        "line_count": 28,
        "lyric_ratio": 0.14,
        "stage_direction_count": 4
      }
    },
    {
      "scene_id": 6,
      "title": "贤王赠马",
      "characters_on_stage": [
        "赵德芳",
        "太监",
        "寇准"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵德芳、太监同上。"
        },
        {
          "type": "lyric",
          "speaker": "赵德芳",
          "mode": "二黄摇板",
          "content": "独坐宫中心烦闷，等候寇准到来临。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "寇准上。"
        },
        {
          "type": "lyric",
          "speaker": "寇准",
          "mode": "二黄摇板",
          "content": "将身来在宫闱境，只为疑难见圣人。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "来此已是，待我扣环。"
        },
        {
          "type": "dialogue",
          "speaker": "太监",
          "mode": "白",
          "content": "何人扣环？"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "烦劳通禀：寇准求见。"
        },
        {
          "type": "dialogue",
          "speaker": "太监",
          "mode": "白",
          "content": "启千岁：寇准求见。"
        },
        {
          "type": "dialogue",
          "speaker": "赵德芳",
          "mode": "白",
          "content": "传他进来。"
        },
        {
          "type": "dialogue",
          "speaker": "太监",
          "mode": "白",
          "content": "千岁传，小心了。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "寇准见驾，贤爷千岁。"
        },
        {
          "type": "dialogue",
          "speaker": "赵德芳",
          "mode": "白",
          "content": "平身赐座。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "谢座。"
        },
        {
          "type": "dialogue",
          "speaker": "赵德芳",
          "mode": "白",
          "content": "卿家审问潘、杨如何？"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "正要升堂理问，后宫潘娘娘有份礼单前来，千岁请看。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵德芳看。"
        },
        {
          "type": "dialogue",
          "speaker": "赵德芳",
          "mode": "白",
          "content": "好一份厚礼！卿家就该收下。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "恐怕学那前任刘御史之故耳。"
        },
        {
          "type": "dialogue",
          "speaker": "赵德芳",
          "mode": "白",
          "content": "卿家只管收下，有孤家作主。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "为此暂存南清宫，事完之后，再来领取。"
        },
        {
          "type": "dialogue",
          "speaker": "赵德芳",
          "mode": "白",
          "content": "来，收下。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "太监收礼。"
        },
        {
          "type": "dialogue",
          "speaker": "赵德芳",
          "mode": "白",
          "content": "可叹吓，可叹！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "千岁此叹何来？"
        },
        {
          "type": "dialogue",
          "speaker": "赵德芳",
          "mode": "白",
          "content": "我想那潘老太师犯罪，就有后宫潘娘娘送卿家一份厚礼；那杨郡马与孤王是门内亲，孤王又是个穷王子，没有什么东西相送卿家，岂不惭愧？"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "寇准跪。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "臣必照律而断！"
        },
        {
          "type": "dialogue",
          "speaker": "赵德芳",
          "mode": "白",
          "content": "卿家请起。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "寇准起身。"
        },
        {
          "type": "dialogue",
          "speaker": "赵德芳",
          "mode": "白",
          "content": "卿家还是马来，还是轿来？"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "臣是步行而来。"
        },
        {
          "type": "dialogue",
          "speaker": "赵德芳",
          "mode": "白",
          "content": "岂不跑坏了卿家？我叔皇赐孤上朝御马，金鞍玉辔，今送与卿家罢！内侍带马。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "太监带马。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "往下带。"
        },
        {
          "type": "dialogue",
          "speaker": "赵德芳",
          "mode": "白",
          "content": "带上些。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "带下些。"
        },
        {
          "type": "dialogue",
          "speaker": "赵德芳",
          "mode": "白",
          "content": "嗒，唗！"
        },
        {
          "type": "lyric",
          "speaker": "赵德芳",
          "mode": "二黄摇板",
          "content": "内待带马不中用，孤王亲自带白龙。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "寇准跪。"
        },
        {
          "type": "lyric",
          "speaker": "寇准",
          "mode": "二黄摇板",
          "content": "自盘古哪有个君与臣带马，"
        },
        {
          "type": "lyric",
          "speaker": "赵德芳",
          "mode": "二黄摇板",
          "content": "功劳买动贤卿心。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "寇准起身。"
        },
        {
          "type": "lyric",
          "speaker": "寇准",
          "mode": "二黄摇板",
          "content": "臣大胆谢千岁忙跨金镫，满脸红光笑盈盈。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "笑",
          "content": "哈哈哈！"
        },
        {
          "type": "dialogue",
          "speaker": "太监",
          "mode": "白",
          "content": "呔！这是什么地方！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "吓！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "寇准下。"
        },
        {
          "type": "lyric",
          "speaker": "赵德芳",
          "mode": "二黄摇板",
          "content": "内侍带路后宫进，等候寇准奏分明。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵德芳下。"
        }
      ],
      "stats": {
        "line_count": 48,
        "lyric_ratio": 0.25,
        "stage_direction_count": 9
      }
    },
    {
      "scene_id": 7,
      "title": "公堂审潘",
      "characters_on_stage": [
        "寇准",
        "四青袍",
        "马牌子",
        "潘洪"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四青袍、马牌子、寇准同上。"
        },
        {
          "type": "lyric",
          "speaker": "寇准",
          "mode": "二黄摇板",
          "content": "御史衙前下金镫，钦奉圣命审皇亲。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "寇准坐。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "来，潘洪到此，叫他报门而进。"
        },
        {
          "type": "dialogue",
          "speaker": "四青袍",
          "mode": "白",
          "content": "呵！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "潘洪上。"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "从前做事差，如今后悔迟。"
        },
        {
          "type": "dialogue",
          "speaker": "四青袍",
          "mode": "白",
          "content": "哦吓！"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "小小御史衙门，倒有些威风杀气！"
        },
        {
          "type": "dialogue",
          "speaker": "马牌子",
          "mode": "白",
          "content": "衙门虽小，威风是有的。你来了么？"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "与老夫报名而进。"
        },
        {
          "type": "dialogue",
          "speaker": "马牌子",
          "mode": "白",
          "content": "报：犯官告进！"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "要叫“太师”！"
        },
        {
          "type": "dialogue",
          "speaker": "马牌子",
          "mode": "白",
          "content": "要叫“犯官”！"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "“太师”！"
        },
        {
          "type": "dialogue",
          "speaker": "马牌子",
          "mode": "白",
          "content": "当初在雁门关兵马大元帅，可以叫得“太师”；如今王子犯法与庶民同罪，只好叫“犯官”。"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "还是“太师”！"
        },
        {
          "type": "dialogue",
          "speaker": "马牌子",
          "mode": "白",
          "content": "就是太师。报：太师犯官告进！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "马牌子下。"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "吾道是谁，原来是小寇儿。请了！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "潘洪，见了本御史为何不跪？"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "见了你下跪，见了当今的万岁，岂不俯伏在地？"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "你欺我官卑职小。请过圣命！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "〖吹打〗。四青袍同请圣旨。"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "臣潘洪见驾，吾皇万岁！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "潘洪：圣旨在上面，本御史在此，快将谋害杨家，私通胡儿，一一讲来！"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "臣启万岁：臣在边关，日间与胡儿交战，晚来与我主耽忧。杨六懒战貅貔，诬告老臣，万岁做主！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "我把你潘洪这大胆的奸贼！想你身为当朝宰相，一人之下，万人之上，何等不好？不该宠信你子潘豹在天齐庙摆下百日擂台，指望将天下的英雄打尽，就要扬名天下。也是杨老将军家教不严，杨七将军私出府门，行到天齐庙前，见你子潘豹在擂台之上洋洋得意：请吓，请吓！那杨七将军性如烈火，上得擂台，三拳两足，将你子潘豹打死！你这老贼与杨老将军抓袍夺带，面见圣上。好一个有道明君，不加罪与他，与你两家讲和。谁知你老贼暗修书信一封，勾通北国胡儿，打来连环战表，要夺我主江山。你这老贼在金殿讨印，要那杨老将军马前先行。那杨老将军恐怕你这老贼要报打子旧恨，连退数本，怎奈万岁不准。偏偏的八千岁养病在宫，杨老将军情急无奈，在金殿讨下保官。圣上命呼老将军以为杨家的保官。你这老贼也要讨下保官，满朝文武，谁肯与你老贼作保。只有贺朝进与你老贼作保，想那贺朝进乃是你这老贼同党，正好朋比为奸！那杨老将军情急无奈，去到瓦雀三关，调来他六子共灭胡儿。天气炎热，误了你的卯期，也是有的。你就要将他斩首。那呼老将军进帐讲情，你把他假情准下，暗命小军报道：营中无粮。你命呼老将军催运军粮。那呼老将军乃是杨家的保官，岂是与你催押粮草之人？出得营来，气呕身亡。杨老将军见他保官一死，反初大营，不服你的调度。你命白牌令箭调他父子回营。那杨七将军性如烈火，打碎白牌，扭断令箭，也是有的。那杨老将军原是知罪的臣子，命他六子进帐请罪。你也不管他是朝廷的郡马，一捆四十。传下将令：黄道之日，不许他父子出马；黑道之日，命他父子出兵。这黄道吉日出兵，必定旗开得胜，马到成功；那黑道之日出兵，不是损兵，就是折将。偏偏的得胜而回，你就该立刻开关，迎接他父子进关才是。你不开关也罢了，反命贺朝进带领五百名雁翎刀手，把住关口，又命他父子将胡儿斩尽杀绝，方可开关。那胡儿人马如潮水一般，一时焉能斩尽？他父子只得杀一阵败一阵，败到两狼山下！只困得里无粮草，外无救兵。杨老将军无奈，命他七子回来颁兵。你这老贼想起打子旧恨，将他诓下马来，用酒灌醉，绑在芭蕉树上，射了他一百零三箭，将他射死！你也消了心头之恨，就该发兵，救他父子回朝，才是你为帅之道。怎么按兵不动？那杨老将军二次命他六子打听他七子下落。可叹那杨老将军在两狼山，望兵兵不到，盼子子不归，无奈撞死在李陵碑下！杨六将军闻知他父已死，逃回京来，告下御状，圣上命刘御史审问你这老贼的口供，不明不白，被八千岁金锏打死。圣上又命银銮尉调下官连夜进京，审问你这老贼。为臣不忠，为子不孝，你这不忠不孝、不仁不义之人，今日犯在本御史之手，岂肯容易！"
        },
        {
          "type": "lyric",
          "speaker": "寇准",
          "mode": "二黄摇板",
          "content": "老贼不信抬头看，本御史不比前任的官。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "来，打！"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "老夫皇亲国戚，谁人敢打！"
        },
        {
          "type": "lyric",
          "speaker": "寇准",
          "mode": "二黄摇板",
          "content": "你道是皇亲国戚我不敢打，打的谋朝篡位臣！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四青袍同打。"
        },
        {
          "type": "lyric",
          "speaker": "潘洪",
          "mode": "二黄导板",
          "content": "上堂来打我四十大板，"
        },
        {
          "type": "dialogue",
          "speaker": "马牌子",
          "mode": "白",
          "content": "大刑到！"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "这作什么？"
        },
        {
          "type": "dialogue",
          "speaker": "马牌子",
          "mode": "白",
          "content": "这是伺候你老人家的。"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "不用。"
        },
        {
          "type": "dialogue",
          "speaker": "马牌子",
          "mode": "白",
          "content": "一刻儿就用。"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "拿下些。"
        },
        {
          "type": "dialogue",
          "speaker": "马牌子",
          "mode": "白",
          "content": "我偏要拿上些。"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "罢了！"
        },
        {
          "type": "dialogue",
          "speaker": "马牌子",
          "mode": "白",
          "content": "大了？这是小三号！"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "咳！"
        },
        {
          "type": "dialogue",
          "speaker": "马牌子",
          "mode": "白",
          "content": "矮吓矮，垫块砖。"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "罢了吓，罢了！"
        },
        {
          "type": "lyric",
          "speaker": "潘洪",
          "mode": "二黄摇板",
          "content": "打得两腿鲜血淋。咬定牙关不招认，看他把我怎样行！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "潘洪，圣上在此，将苦害杨家，一一讲来！"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "杨六诬告老臣，万岁做主！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "住口！"
        },
        {
          "type": "lyric",
          "speaker": "寇准",
          "mode": "二黄摇板",
          "content": "钻天鹞子拔你翅，走兽麒麟抽你筋！人来看过铜夹棍，看他招承不招承！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四青袍同用刑。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "问他有招无招？"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "无招。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "收！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四青袍同收刑。"
        },
        {
          "type": "dialogue",
          "speaker": "四青袍",
          "mode": "白",
          "content": "吓，昏去了！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "潘洪，圣上问你，私通北国胡儿，谋害杨家，谁与同谋？"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "要问同谋之人，就是你小寇儿！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "呀呀呸！"
        },
        {
          "type": "lyric",
          "speaker": "寇准",
          "mode": "二黄摇板",
          "content": "口如砂糖舌如刀，心如狼虎未长毛。人来看过铜铁链，不招即刻赴阴曹！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四青袍同收刑。"
        },
        {
          "type": "dialogue",
          "speaker": "马牌子",
          "mode": "白",
          "content": "启老爷：太师厥去了！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "哎呀，且住，五刑俱已用过，老贼没有口供，人已昏去，这、这、这便怎么处？"
        },
        {
          "type": "dialogue",
          "speaker": "马牌子",
          "mode": "白",
          "content": "老爷不要着急，人不伤，心不死，一口凉水就活。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "快去取来。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "马牌子喷水，潘洪醒。"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "哦……"
        },
        {
          "type": "dialogue",
          "speaker": "马牌子",
          "mode": "白",
          "content": "太师放了个屁。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "出了一口气，搀扶起来！"
        },
        {
          "type": "dialogue",
          "speaker": "四青袍",
          "mode": "白",
          "content": "太师醒来！"
        },
        {
          "type": "lyric",
          "speaker": "潘洪",
          "mode": "二黄原板",
          "content": "铜铁链烧得我昏迷不醒，三魂渺渺又还阳。猛然睁开昏花眼，面前站的对头人。手摸胸膛想一想，后宫是我什么人？太师上前奏一本，管叫削职为庶民！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "太师不必动怒，待下官将此事多推在杨六郎身上，与太师无干。"
        },
        {
          "type": "dialogue",
          "speaker": "潘洪",
          "mode": "白",
          "content": "这便才是！"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "来，搀下去。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "马牌子搀潘洪同下。"
        },
        {
          "type": "dialogue",
          "speaker": "寇准",
          "mode": "白",
          "content": "哎呀，且住，老贼没有口供，这便怎么处？哇，有了，不免去到南清宫，与八千岁商议，再作道理。来，打道南清宫。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四青袍同允，四青袍、寇准同下。"
        }
      ],
      "stats": {
        "line_count": 88,
        "lyric_ratio": 0.17,
        "stage_direction_count": 12
      }
    }
  ]
}