        "stage_direction_count": 3
      }
    },
    {
      "scene_id": 4,
      "title": "",
      "characters_on_stage": [
        "姬光",
        "四太监",
        "四御林军",
        "太监甲"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四太监同上，姬光上。"
        },
        {
          "type": "lyric",
          "speaker": "姬光",
          "mode": "引子",
          "content": "龙楼凤阁，怎能够，江山归我。"
        },
        {
          "type": "lyric",
          "speaker": "姬光",
          "mode": "念",
          "content": "人无害虎意，虎有伤人心。要摘天边月，足下不生云。"
        },
        {
          "type": "dialogue",
          "speaker": "姬光",
          "mode": "白",
          "content": "孤，姬光。适才二位先生奏道：伍子胥避难至此。不知身落何地，不免前去寻访。内侍，吩咐御林军走上。"
        },
        {
          "type": "dialogue",
          "speaker": "太监甲",
          "mode": "白",
          "content": "御林军走上。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四御林军同上。"
        },
        {
          "type": "dialogue",
          "speaker": "姬光",
          "mode": "白",
          "content": "带马。"
        },
        {
          "type": "lyric",
          "speaker": "姬光",
          "mode": "西皮原板",
          "content": "芳草青青隐翠微，青山绿水鸟空啼。闻得子胥到此地，去访贤臣扶社稷。御林军摆驾出城地，亲自去访伍子胥。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "众人同下。"
        }
      ],
      "stats": {
        "line_count": 19,
        "lyric_ratio": 0.632,
        "stage_direction_count": 3
      }
    },
    {
      "scene_id": 5,
      "title": "",
      "characters_on_stage": [
        "伍员",
        "姬光",
        "四御林军",
        "太监甲"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "伍员上。"
        },
        {
          "type": "lyric",
          "speaker": "伍员",
          "mode": "西皮快板",
          "content": "行过东来又转西，举目无亲独自悲。衣衫褴褛谁周济，竹箫焉能免得饥。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "俺，伍员。自从与专诸结拜，闲住苏城，衣衫典尽，衣履全无，只落的乞讨之中。天吓，天吓，想俺伍员，堂堂奇男子，烈烈大英雄，只落得吹箫讨饭吓！"
        },
        {
          "type": "lyric",
          "speaker": "伍员",
          "mode": "西皮原板",
          "content": "姜子牙无事隐钓溪，时衰运败鬼神欺。周姬昌梦飞熊夜扑帐里，亲访贤臣兴社稷。东迁洛邑王纲坠，"
        },
        {
          "type": "lyric",
          "speaker": "伍员",
          "mode": "西皮快板",
          "content": "战将刀枪何日离。伍员单人把楚弃，父母冤仇气不息。要借吴兵心少计，我与姬光会无期。英雄落魄如蝼蚁，手拿竹箫讨饭吃。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "姬光、四御林军、太监甲同上。"
        },
        {
          "type": "lyric",
          "speaker": "姬光",
          "mode": "西皮快板",
          "content": "孤王打马出宫闱，姑苏城内多光辉。勒住马头用目望，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "伍员吹箫。"
        },
        {
          "type": "lyric",
          "speaker": "姬光",
          "mode": "西皮快板",
          "content": "见一老臣相貌奇：鹤发童颜少年纪，手拿竹箫信口吹。勒马停蹄街头立，且听来人他是谁。"
        },
        {
          "type": "lyric",
          "speaker": "伍员",
          "mode": "西皮摇板",
          "content": "子胥抬头用目望，"
        },
        {
          "type": "lyric",
          "speaker": "伍员",
          "mode": "西皮流水板",
          "content": "见一位官长相貌奇：头戴金冠双龙戏，身上穿的龙凤衣。龙眉凤目非凡体，想是天子下瑶池。莫非他就是姬千岁，有意来访我伍子胥。上前通名去见礼，冠破衣穿不整齐。眉头一皱心生计，把我冤仇提一提。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "天吓，天吓！"
        },
        {
          "type": "lyric",
          "speaker": "伍员",
          "mode": "反西皮摇板",
          "content": "子胥阀阅门眉第，到如今落魄天涯有谁知。父母的冤仇沉海地，我好比凤脱翎毛怎能飞？伍子胥，伍明辅，父母的冤仇不能报，爹娘吓！"
        },
        {
          "type": "lyric",
          "speaker": "姬光",
          "mode": "西皮快板",
          "content": "听罢言来我心喜，来的果是伍子胥。本当向前把话启，猛然一计在心里。"
        },
        {
          "type": "dialogue",
          "speaker": "姬光",
          "mode": "白",
          "content": "内侍，唤那吹萧之人向前答话。"
        },
        {
          "type": "dialogue",
          "speaker": "太监甲",
          "mode": "白",
          "content": "是。那一汉子，我家千岁，唤你上前答话。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "来了。"
        },
        {
          "type": "lyric",
          "speaker": "伍员",
          "mode": "西皮快板",
          "content": "听说千岁传子胥，愁人脸上笑嘻嘻。走上前来忙见礼，愿君福寿与天齐。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "参见千岁。"
        },
        {
          "type": "dialogue",
          "speaker": "姬光",
          "mode": "白",
          "content": "平身。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "谢千岁。"
        },
        {
          "type": "dialogue",
          "speaker": "姬光",
          "mode": "白",
          "content": "家住哪里，姓甚名谁，一一讲来。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "千岁吓！"
        },
        {
          "type": "lyric",
          "speaker": "伍员",
          "mode": "西皮二六板",
          "content": "富贵穷通不由己，也是我时衰命运低。我本是楚国功臣家住在监利，我的父伍奢保华夷。恨平王无道纳儿媳，信用那奸贼费无极。我的父谏奏反诛死，又杀我满门实惨凄。闻千岁招贤纳士多仁义，还望你拿云仙手你把难人提。伍子胥若得这步地，知恩报德不敢移。"
        },
        {
          "type": "lyric",
          "speaker": "姬光",
          "mode": "西皮摇板",
          "content": "闻得将军多仁义，今日一见果是实。内侍摆驾回宫里，我与将军叙军机。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "吹打。伍员换衣。孙武、被离同上。"
        },
        {
          "type": "lyric",
          "speaker": "孙武、被离",
          "mode": "同西皮摇板",
          "content": "慢步且把宝帐进，见了主公说分明。"
        },
        {
          "type": "dialogue",
          "speaker": "孙武、被离",
          "mode": "同白",
          "content": "参见主公。"
        },
        {
          "type": "dialogue",
          "speaker": "姬光",
          "mode": "白",
          "content": "罢了，见过伍将军。"
        },
        {
          "type": "dialogue",
          "speaker": "孙武、被离",
          "mode": "同白",
          "content": "吓，伍将军。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "二位先生请坐。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "刘展雄上。"
        },
        {
          "type": "dialogue",
          "speaker": "刘展雄",
          "mode": "白",
          "content": "吓，"
        },
        {
          "type": "lyric",
          "speaker": "刘展雄",
          "mode": "西皮摇板",
          "content": "正在后帐把箭比，听说来了伍子胥。慢步且进宝帐里，仁兄为何白了须？"
        },
        {
          "type": "lyric",
          "speaker": "伍员",
          "mode": "西皮快板",
          "content": "手挽手儿叫贤弟，恨平王无道纳儿媳。擅杀忠良当儿戏，兄来借兵你莫心疑。"
        },
        {
          "type": "lyric",
          "speaker": "刘展雄",
          "mode": "西皮摇板",
          "content": "仁兄点动人和马，再与昏王见高低。"
        },
        {
          "type": "dialogue",
          "speaker": "刘展雄",
          "mode": "白",
          "content": "请坐。"
        },
        {
          "type": "dialogue",
          "speaker": "姬光",
          "mode": "白",
          "content": "二位先生，伍将军到此，大事可能成功？"
        },
        {
          "type": "dialogue",
          "speaker": "孙武、被离",
          "mode": "同白",
          "content": "还是不能成功。须必要有一粗心胆大之人，方能成功。"
        },
        {
          "type": "dialogue",
          "speaker": "姬光",
          "mode": "白",
          "content": "这粗心胆大之人哪里有？"
        },
        {
          "type": "dialogue",
          "speaker": "孙武、被离",
          "mode": "同白",
          "content": "自然有。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "启禀千岁：臣有一义弟，名唤专诸。此人义孝皆全，大可委用。"
        },
        {
          "type": "dialogue",
          "speaker": "姬光",
          "mode": "白",
          "content": "内侍，带定黄金千两，随伍将军前去聘请。"
        },
        {
          "type": "dialogue",
          "speaker": "太监甲",
          "mode": "白",
          "content": "遵命。"
        },
        {
          "type": "lyric",
          "speaker": "伍员",
          "mode": "西皮摇板",
          "content": "有道有德光恩义，敬贤礼士称第一。辞王别驾奉聘礼，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "伍员、太监甲同下。"
        }
      ],
      "stats": {
        "line_count": 80,
        "lyric_ratio": 0.738,
        "stage_direction_count": 5
      }
    },
    {
      "scene_id": 6,
      "title": "",
      "characters_on_stage": [
        "姬光",
        "孙武",
        "被离",
        "刘展雄",
        "伍员",
        "专诸",
        "太监甲"
      ],
      "segments": [
        {
          "type": "lyric",
          "speaker": "姬光",
          "mode": "西皮摇板",
          "content": "得了楚国伍子胥。孤王江山可得的？"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "伍员、专诸同上。"
        },
        {
          "type": "lyric",
          "speaker": "专诸",
          "mode": "西皮摇板",
          "content": "有劳仁兄把我提。进帐前行君臣礼，"
        },
        {
          "type": "lyric",
          "speaker": "姬光",
          "mode": "西皮摇板",
          "content": "壮士果然世间稀。君臣对作把话理，"
        },
        {
          "type": "lyric",
          "speaker": "伍员",
          "mode": "西皮摇板",
          "content": "风吹云散见虹霓。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "草民有何德能，敢劳千岁，下此聘礼。"
        },
        {
          "type": "dialogue",
          "speaker": "姬光",
          "mode": "白",
          "content": "些些小事，何劳挂齿。二位先生，大事可能成功？"
        },
        {
          "type": "dialogue",
          "speaker": "孙武、被离",
          "mode": "同白",
          "content": "兄皇平常所爱何物？"
        },
        {
          "type": "dialogue",
          "speaker": "姬光",
          "mode": "白",
          "content": "所爱鲜鱼。"
        },
        {
          "type": "dialogue",
          "speaker": "孙武、被离",
          "mode": "同白",
          "content": "就把鲜鱼刺之。"
        },
        {
          "type": "dialogue",
          "speaker": "姬光",
          "mode": "白",
          "content": "我兄皇内穿膛鳞袄，刀枪不入。"
        },
        {
          "type": "dialogue",
          "speaker": "孙武、被离",
          "mode": "同白",
          "content": "膛鳞袄的怕是鱼肠剑。"
        },
        {
          "type": "dialogue",
          "speaker": "姬光",
          "mode": "白",
          "content": "鱼肠剑哪里有？"
        },
        {
          "type": "dialogue",
          "speaker": "被离",
          "mode": "白",
          "content": "吓，世兄，我下山之时，师傅赐我宝剑，名曰匕首，世兄请看。"
        },
        {
          "type": "dialogue",
          "speaker": "孙武",
          "mode": "白",
          "content": "待我看来。"
        },
        {
          "type": "lyric",
          "speaker": "孙武",
          "mode": "念",
          "content": "“内破膛鳞袄，外面刺王僚。”"
        },
        {
          "type": "dialogue",
          "speaker": "孙武",
          "mode": "白",
          "content": "正是此物。"
        },
        {
          "type": "dialogue",
          "speaker": "姬光",
          "mode": "白",
          "content": "有了鱼肠剑，可能成功？"
        },
        {
          "type": "dialogue",
          "speaker": "孙武、被离",
          "mode": "同白",
          "content": "必须有酒宴前行刺之人，方能成功。"
        },
        {
          "type": "dialogue",
          "speaker": "姬光",
          "mode": "白",
          "content": "这就难了。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "千岁，俺专诸不才，情愿行刺那王僚。"
        },
        {
          "type": "dialogue",
          "speaker": "姬光",
          "mode": "白",
          "content": "我兄皇战将千员，壮士有性命之忧。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "千岁，草民家有八旬老母，还望千岁另眼看待。"
        },
        {
          "type": "dialogue",
          "speaker": "姬光",
          "mode": "白",
          "content": "我若错待伯母，叫我天诛地灭。内侍，看过黄金千金，回去拜到伯母，就说孤不不了。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "谢千岁。"
        },
        {
          "type": "lyric",
          "speaker": "专诸",
          "mode": "西皮摇板",
          "content": "多谢千岁赐黄金，回家禀报老娘亲。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "专诸下。"
        },
        {
          "type": "lyric",
          "speaker": "姬光",
          "mode": "西皮摇板",
          "content": "内侍将酒来摆定，我与众卿诉军情。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "众人同下。"
        }
      ],
      "stats": {
        "line_count": 42,
        "lyric_ratio": 0.405,
        "stage_direction_count": 3
      }
    }
  ]
}