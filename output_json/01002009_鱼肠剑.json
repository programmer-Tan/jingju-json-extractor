  "scenes": [
    {
      "scene_id": 1,
      "title": "",
      "characters_on_stage": [
        "伍员"
      ],
      "segments": [
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "内白",
          "content": "马来"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "伍员上"
        },
        {
          "type": "lyric",
          "speaker": "伍员",
          "mode": "西皮摇板",
          "content": "匹马单枪弃楚营，龙离沧海虎奔山。黎阳安居七夜晚，发似银条过昭关。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "俺，伍员。多蒙东皋公、皇甫讷定计，救我出关。看看吴国城池不远，就此马上加鞭。"
        },
        {
          "type": "lyric",
          "speaker": "伍员",
          "mode": "西皮原板",
          "content": "一事无成两鬓斑，恨光阴一去不回还。日月轮流长相见，看青山绿水在眼前。俺伍员弃楚非本愿，恨平王杀害我慈颜。匹马单枪走如电，黎阳山下遇高贤。定计出关无风险，马到长江有渡船。幸得渔人行方便，他为我投江实可怜。浣纱女，实好善，一饭之恩前世缘。眼望吴国路不远，心急求兵马加鞭。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "伍员下"
        }
      ],
      "stats": {
        "line_count": 26,
        "lyric_ratio": 0.846,
        "stage_direction_count": 2
      }
    },
    {
      "scene_id": 2,
      "title": "",
      "characters_on_stage": [
        "专诸",
        "牛二",
        "三邻人",
        "老丈",
        "专诸妻"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "专诸上"
        },
        {
          "type": "lyric",
          "speaker": "专诸",
          "mode": "引子",
          "content": "爱习拳棒，论英雄，盖世无双。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "专诸坐"
        },
        {
          "type": "lyric",
          "speaker": "专诸",
          "mode": "念",
          "content": "家住吴国在城东，孝义皆全论英雄。苍天若助三分志，拜相封侯谈笑中。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "在下专诸，乃吴国人士。胸中颇有智谋，爱习拳棒，恨俺时运未至，在这城内开了一座肉铺。前者拉了牛二几匹牲口，帐还未清，倘若找上门来，又是一场吵闹。正是："
        },
        {
          "type": "lyric",
          "speaker": "专诸",
          "mode": "念",
          "content": "君子生平运不通，苍天为何困英雄。"
        },
        {
          "type": "dialogue",
          "speaker": "牛二",
          "mode": "内白",
          "content": "哽嚏。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "牛二上"
        },
        {
          "type": "lyric",
          "speaker": "牛二",
          "mode": "念",
          "content": "可恨专诸太欺情，惹得牛儿找上门。"
        },
        {
          "type": "dialogue",
          "speaker": "牛二",
          "mode": "白",
          "content": "我，牛二。可恨专诸，拉了我几匹牲口，老没给钱，今天找上门去，定要与他吵闹。正是："
        },
        {
          "type": "lyric",
          "speaker": "牛二",
          "mode": "念",
          "content": "行行去去，去去行行。"
        },
        {
          "type": "dialogue",
          "speaker": "牛二",
          "mode": "白",
          "content": "到了。专诸开门来！"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "是哪一个？"
        },
        {
          "type": "dialogue",
          "speaker": "牛二",
          "mode": "白",
          "content": "是我。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "原来是牛二哥，请进。"
        },
        {
          "type": "dialogue",
          "speaker": "牛二",
          "mode": "白",
          "content": "进去就进去。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "请坐。"
        },
        {
          "type": "dialogue",
          "speaker": "牛二",
          "mode": "白",
          "content": "坐下就坐下。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "牛二哥，怒气不息，为着谁来？"
        },
        {
          "type": "dialogue",
          "speaker": "牛二",
          "mode": "白",
          "content": "我就为你。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "为小弟何来？"
        },
        {
          "type": "dialogue",
          "speaker": "牛二",
          "mode": "白",
          "content": "你前两天拉了我两匹牲口，老没给钱，是何道理？"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "这几日买卖不好，改日有了银钱，送上府去。"
        },
        {
          "type": "dialogue",
          "speaker": "牛二",
          "mode": "白",
          "content": "你没有钱，你这个店让我开了。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "哦，牛二哥要开，恭喜恭喜，开市大吉我让与你了！"
        },
        {
          "type": "dialogue",
          "speaker": "牛二",
          "mode": "白",
          "content": "你回来。你这个店里，什么东西都没有，等要帐的来，难道我还与你还账么？"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "牛二哥不必如此，等小弟时来运转，加利奉还。"
        },
        {
          "type": "dialogue",
          "speaker": "牛二",
          "mode": "白",
          "content": "你还走运了，你等那走死运吧！"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "住了！"
        },
        {
          "type": "lyric",
          "speaker": "专诸",
          "mode": "扑灯蛾",
          "content": "牛二太欺情，开口就伤人。俺两膀千金力，谁敢行凶到门厅！"
        },
        {
          "type": "lyric",
          "speaker": "牛二",
          "mode": "扑灯蛾",
          "content": "专诸无理无理，不该把我牛二欺。恨不得一拳打死你！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "牛二打。三邻人、老丈同上。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "列位吓！"
        },
        {
          "type": "lyric",
          "speaker": "专诸",
          "mode": "西皮摇板",
          "content": "列位有所不知情，牛二开口就伤人。吵得街邻不安静，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "牛二打。"
        },
        {
          "type": "lyric",
          "speaker": "专诸",
          "mode": "西皮摇板",
          "content": "暂且饶你命残生。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "专诸妻上。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸妻",
          "mode": "白",
          "content": "吓，母亲唤你。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "专诸妻下。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "来了。"
        },
        {
          "type": "lyric",
          "speaker": "专诸",
          "mode": "念",
          "content": "忽闻母亲唤，双手闭祸门。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "专诸下。"
        },
        {
          "type": "dialogue",
          "speaker": "牛二",
          "mode": "白",
          "content": "你不要逃走，出来！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "三邻人、老丈同相劝，三邻人、牛二同下。"
        }
      ],
      "stats": {
        "line_count": 58,
        "lyric_ratio": 0.328,
        "stage_direction_count": 7
      }
    },
    {
      "scene_id": 3,
      "title": "",
      "characters_on_stage": [
        "伍员",
        "老丈",
        "专诸"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "伍员上。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "呀。老丈请转。"
        },
        {
          "type": "dialogue",
          "speaker": "老丈",
          "mode": "白",
          "content": "何事？"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "方才这一大汉，与人争斗，出来一女子，手执拐杖，呼唤即回，莫非此人惧内么？"
        },
        {
          "type": "dialogue",
          "speaker": "老丈",
          "mode": "白",
          "content": "此人名唤专诸，乃是大孝之人，这拐杖就是他母亲的拐杖，故而呼唤即回。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "敬重父母，理所当然。"
        },
        {
          "type": "dialogue",
          "speaker": "老丈",
          "mode": "白",
          "content": "听壮士不像此地人氏。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "本来不是此地人氏。"
        },
        {
          "type": "dialogue",
          "speaker": "老丈",
          "mode": "白",
          "content": "哪里人氏？"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "楚国监利人氏，避难至此。"
        },
        {
          "type": "dialogue",
          "speaker": "老丈",
          "mode": "白",
          "content": "请到寒舍待茶。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "萍水相逢，怎好打扰。"
        },
        {
          "type": "dialogue",
          "speaker": "老丈",
          "mode": "白",
          "content": "改日再会。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "请。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "老丈下。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "哦，啊呀。方才听得老丈之言：那专诸孝义兼全。我不免与他结交，若是借得吴兵伐楚，定然助我一臂之力。正是："
        },
        {
          "type": "lyric",
          "speaker": "伍员",
          "mode": "念",
          "content": "结交要结真君子，求人须求大丈夫。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "来此已是。吓，专兄开门来！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "专诸上。"
        },
        {
          "type": "lyric",
          "speaker": "专诸",
          "mode": "念",
          "content": "君子不得志，低头且耐时。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "是哪一个？"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "在下拜府。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "请进。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "请。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "请问老丈尊姓大名？"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "在下姓伍名员，字子胥，乃楚国监利人氏。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "原来是伍将军，失敬了。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "岂敢。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "为何这等狼狈？"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "专兄呀。"
        },
        {
          "type": "lyric",
          "speaker": "伍员",
          "mode": "西皮快板",
          "content": "恨平王无道乱楚邦，父纳子妻乱纲常。父兄满门具遭丧，借兵报仇见吴王。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "今有姬千岁，招贤纳士，何不投奔那里，借兵报仇。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "本待投奔姬千岁那里，奈无机会，不敢擅入。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "就在寒舍，暂住几日。姬千岁闻知，必定前来聘请。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "若得如此，俺子胥幸也。我观专兄，孝义兼全，意欲与专兄结为昆仲，幸勿见却。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "俺乃一介蠢夫，怎敢高攀。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "俺子胥真情实意，不必过谦。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸",
          "mode": "白",
          "content": "需要见过老母。"
        },
        {
          "type": "dialogue",
          "speaker": "伍员",
          "mode": "白",
          "content": "正要叩见伯母。"
        },
        {
          "type": "dialogue",
          "speaker": "专诸、伍员",
          "mode": "同白",
          "content": "请！"
        },
        {
          "type": "lyric",
          "speaker": "伍员",
          "mode": "西皮摇板",
          "content": "孝意兼全人钦仰，"
        },
        {
          "type": "lyric",
          "speaker": "专诸",
          "mode": "西皮摇板",
          "content": "兄有事来弟挂肠。"
        },
        {
          "type": "lyric",
          "speaker": "伍员",
          "mode": "西皮摇板",
          "content": "报仇事儿全仰仗，"
        },
        {
          "type": "lyric",
          "speaker": "专诸",
          "mode": "西皮摇板",
          "content": "借来吴兵灭平王。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "伍员、专诸同下。"
        }
      ],
      "stats": {
        "line_count": 49,
