      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "薛蛟上。"
        },
        {
          "type": "dialogue",
          "speaker": "徐策",
          "mode": "白",
          "content": "儿吓。"
        },
        {
          "type": "lyric",
          "speaker": "徐策",
          "mode": "二黄原板",
          "content": "一路行去要当心。"
        },
        {
          "type": "lyric",
          "speaker": "薛蛟",
          "mode": "二黄原板",
          "content": "向前来拜别我的父。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "薛蛟哭。"
        },
        {
          "type": "dialogue",
          "speaker": "薛蛟",
          "mode": "白",
          "content": "哎，爹爹吓！"
        },
        {
          "type": "lyric",
          "speaker": "薛蛟",
          "mode": "二黄原板",
          "content": "一心打马往前行。"
        },
        {
          "type": "dialogue",
          "speaker": "徐策",
          "mode": "白",
          "content": "儿吓，回来。"
        },
        {
          "type": "dialogue",
          "speaker": "薛蛟",
          "mode": "白",
          "content": "爹爹何事？"
        },
        {
          "type": "dialogue",
          "speaker": "徐策",
          "mode": "白",
          "content": "你今前去卧龙山婶娘那里，搬兵报仇，报仇之后，回来我若还在世，亲眼看见，也不枉为父一片热心。我若不在，你可手拿几张纸钱，走到为父坟前，大哭一场，多拜几拜，儿吓，难道为父当真受了你的不成，也等那旁人叹息几句。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "徐策哭。"
        },
        {
          "type": "dialogue",
          "speaker": "徐策",
          "mode": "白",
          "content": "吾儿吓！"
        },
        {
          "type": "dialogue",
          "speaker": "薛蛟",
          "mode": "白",
          "content": "哎呀，爹爹这等说，孩儿不去了。"
        },
        {
          "type": "dialogue",
          "speaker": "徐策",
          "mode": "白",
          "content": "你怎的不去？"
        },
        {
          "type": "dialogue",
          "speaker": "薛蛟",
          "mode": "白",
          "content": "待爹爹百年以后再去。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "徐策笑。"
        },
        {
          "type": "dialogue",
          "speaker": "徐策",
          "mode": "白",
          "content": "儿吓，为父的还不老，你只管前去。"
        },
        {
          "type": "dialogue",
          "speaker": "薛蛟",
          "mode": "白",
          "content": "孩儿不去。"
        },
        {
          "type": "dialogue",
          "speaker": "徐策",
          "mode": "白",
          "content": "唔，你再说不去，我就打。"
        },
        {
          "type": "dialogue",
          "speaker": "薛蛟",
          "mode": "白",
          "content": "打死孩儿也不去。"
        },
        {
          "type": "dialogue",
          "speaker": "徐策",
          "mode": "白",
          "content": "好没来由。吓，若是我的亲生金斗孩儿，叫他往东，他就在东，叫他往西，他就在西。吓，这等看起来，好不气死我也。"
        },
        {
          "type": "dialogue",
          "speaker": "薛蛟",
          "mode": "白",
          "content": "爹爹不必如此，孩儿愿去。"
        },
        {
          "type": "dialogue",
          "speaker": "徐策",
          "mode": "白",
          "content": "你是怎讲？"
        },
        {
          "type": "dialogue",
          "speaker": "薛蛟",
          "mode": "白",
          "content": "孩儿愿去。"
        },
        {
          "type": "dialogue",
          "speaker": "徐策",
          "mode": "白",
          "content": "哈哈哈，好吓！"
        },
        {
          "type": "lyric",
          "speaker": "薛蛟",
          "mode": "二黄原板",
          "content": "拜别爹爹上了马。"
        },
        {
          "type": "dialogue",
          "speaker": "薛蛟",
          "mode": "白",
          "content": "哎呀，爹吓！"
        },
        {
          "type": "lyric",
          "speaker": "薛蛟",
          "mode": "二黄原板",
          "content": "去到卧龙把兵搬。"
        },
        {
          "type": "dialogue",
          "speaker": "徐策",
          "mode": "白",
          "content": "徐蛟儿吓。"
        },
        {
          "type": "lyric",
          "speaker": "薛蛟",
          "mode": "二黄原板",
          "content": "小豪杰打马上阳关，要把冤仇一旦伸！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "薛蛟下。"
        },
        {
          "type": "dialogue",
          "speaker": "徐策",
          "mode": "白",
          "content": "儿吓，你真去了！哎，我的儿吓！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "徐策哭。"
        },
        {
          "type": "lyric",
          "speaker": "徐策",
          "mode": "二黄原板",
          "content": "一见蛟儿去登程，好似钢刀刺我心。将身便把内堂进，见了夫人说分明。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "徐策下。"
        }
      ],
