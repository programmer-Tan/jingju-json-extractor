  "scenes": [
    {
      "scene_id": 1,
      "title": "",
      "characters_on_stage": [
        "韩廷凤",
        "家院",
        "媒婆",
        "轿夫",
        "丫鬟",
        "江氏"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "韩廷凤上。"
        },
        {
          "type": "stage_direction",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "笑"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "哈哈哈……"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄摇板",
          "content": "今夜晚前后厅灯光明亮，我不想年半百又做新郎。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "家院上。媒婆上。"
        },
        {
          "type": "lyric",
          "speaker": "媒婆",
          "mode": "念",
          "content": "新人过门厅，媒钱自然增。"
        },
        {
          "type": "dialogue",
          "speaker": "媒婆",
          "mode": "",
          "content": "启老爷：新人已到。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "将轿搭上堂来。"
        },
        {
          "type": "dialogue",
          "speaker": "媒婆",
          "mode": "",
          "content": "花轿搭上堂来。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "轿夫、丫鬟、江氏同上。江氏出轿，轿夫下。"
        },
        {
          "type": "dialogue",
          "speaker": "媒婆",
          "mode": "",
          "content": "娘子见过老爷。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "江氏坐。"
        },
        {
          "type": "dialogue",
          "speaker": "媒婆",
          "mode": "",
          "content": "小人们讨赏。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "下面领赏。"
        },
        {
          "type": "dialogue",
          "speaker": "媒婆",
          "mode": "",
          "content": "谢老爷。媒人一片苦心肠，一边欢喜一边伤。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "媒婆下。家院下。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "丫头！"
        },
        {
          "type": "dialogue",
          "speaker": "丫鬟",
          "mode": "",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "掌灯，待我一观。"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄慢板",
          "content": "借灯光暗地里细观姣娘，我看她与前妻一样风光。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "江氏哭。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "哎呀！"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄慢板",
          "content": "只见她愁眉皱泪流脸上，莫不是嫌我老难配鸾凰？"
        },
        {
          "type": "dialogue",
          "speaker": "江氏",
          "mode": "",
          "content": "不是。"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄原板",
          "content": "要穿衣锦绣衫任你掉样，你有甚心中事细说端详，这有何妨？"
        },
        {
          "type": "dialogue",
          "speaker": "江氏",
          "mode": "",
          "content": "大老爷启禀！"
        },
        {
          "type": "lyric",
          "speaker": "江氏",
          "mode": "二黄原板",
          "content": "未开言不由人泪如雨降，尊一声大老爷细听端详：奴丈夫病沉疴久卧床上，因此上少银钱变卖妻房。我岂肯贪富贵痴心妄想，可怜我好夫妻两下离分。大老爷开大恩将奴释放，纵死在九泉下瞑目不忘。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "呀！"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄摇板",
          "content": "听她言伊现有妇随夫唱，怎奈我两下里拆散鸳鸯。再不要做恶事天在头上，自情愿伴孤灯永守空房。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "院子哪里？"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "家院上。"
        },
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "",
          "content": "老爷何事？"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "你可将这女子送回，聘礼不要，再取银子一百两，送她到家，全她夫妻恩情，以完这女子贞节之名。"
        },
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "",
          "content": "晓得。"
        },
        {
          "type": "dialogue",
          "speaker": "江氏",
          "mode": "",
          "content": "既蒙老爷开恩仗义，不肯收留，又叨恩赐，容小妇人叩谢。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "不消了。"
        },
        {
          "type": "lyric",
          "speaker": "江氏",
          "mode": "二黄摇板",
          "content": "救命银是我夫重生父样，全贞节是难妇再世爹娘。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "回来。"
        },
        {
          "type": "dialogue",
          "speaker": "江氏",
          "mode": "",
          "content": "是。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "你这婚书在此。"
        },
        {
          "type": "dialogue",
          "speaker": "江氏",
          "mode": "",
          "content": "但凭恩人。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "当面烧化了吧！"
        },
        {
          "type": "dialogue",
          "speaker": "江氏",
          "mode": "",
          "content": "多谢恩人。"
        },
        {
          "type": "lyric",
          "speaker": "江氏",
          "mode": "二黄摇板",
          "content": "积阴功救难妇放开罗网，回家去同丈夫答报商量。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "家院领江氏同下。"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄摇板",
          "content": "她言道本丈夫染病在床，因此上卖了她好度日光。将他人比自己俱是一样，善与恶自有那天理昭彰。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "韩廷凤下。"
        }
      ],
      "stats": {
        "line_count": 48,
        "lyric_ratio": 0.52,
        "stage_direction_count": 8
      }
    },
    {
      "scene_id": 2,
      "title": "",
      "characters_on_stage": [
        "吴惠泉",
        "家院",
        "江氏",
        "韩廷凤"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "吴惠泉上。"
        },
        {
          "type": "lyric",
          "speaker": "吴惠泉",
          "mode": "二黄摇板",
          "content": "孤单单病奄奄坐卧病床，断送了好夫妇凤友鸾凰。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "家院、江氏同上。"
        },
        {
          "type": "lyric",
          "speaker": "江氏",
          "mode": "二黄摇板",
          "content": "黑夜里蒙送我重归故道，好一似失群雁又来旧巢。"
        },
        {
          "type": "dialogue",
          "speaker": "江氏",
          "mode": "",
          "content": "来此已是我家门首，请站一时。"
        },
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "",
          "content": "是。"
        },
        {
          "type": "dialogue",
          "speaker": "江氏",
          "mode": "",
          "content": "丈夫开门。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "呀！"
        },
        {
          "type": "lyric",
          "speaker": "吴惠泉",
          "mode": "二黄摇板",
          "content": "猛听得叫丈夫轻言俊俏，想是我梦魂中心神颠倒。"
        },
        {
          "type": "dialogue",
          "speaker": "江氏",
          "mode": "",
          "content": "开门！"
        },
        {
          "type": "lyric",
          "speaker": "吴惠泉",
          "mode": "二黄摇板",
          "content": "这声音似我妻江氏多姣，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "吴惠泉开门。"
        },
        {
          "type": "lyric",
          "speaker": "吴惠泉",
          "mode": "二黄摇板",
          "content": "叫得我寒毛凛胆战魂消。"
        },
        {
          "type": "dialogue",
          "speaker": "江氏",
          "mode": "",
          "content": "官人。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "你怎样回来的？"
        },
        {
          "type": "dialogue",
          "speaker": "江氏",
          "mode": "",
          "content": "多蒙韩老爷查问情由，不忍拆散你我夫妻，将婚书烧化，聘礼不要；又赐银百两，以成奴之贞节，故而差人将奴送回。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "哦，有这等事？何人送你回来的？"
        },
        {
          "type": "dialogue",
          "speaker": "江氏",
          "mode": "",
          "content": "韩管家送我回来的。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "请他进来。"
        },
        {
          "type": "dialogue",
          "speaker": "江氏",
          "mode": "",
          "content": "有请管家。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "家院进。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "啊，韩管家。"
        },
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "",
          "content": "吓，吴相公。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "你家员外怎样言道？"
        },
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "",
          "content": "我家员外言道，命我送大娘子回来，先前聘礼不要，再与银子百两，叫你保养病体。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "世界之上，哪有这样好人？谢天谢地！"
        },
        {
          "type": "dialogue",
          "speaker": "江氏",
          "mode": "",
          "content": "当谢天地！"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "娘子你我夫妻，前去叩谢才是。"
        },
        {
          "type": "dialogue",
          "speaker": "江氏",
          "mode": "",
          "content": "礼当如此。"
        },
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "",
          "content": "吴相公，你那贵恙才好，改日再去吧。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "吓，如今我有银子，病就好了。走吓。"
        },
        {
          "type": "lyric",
          "speaker": "吴惠泉",
          "mode": "二黄摇板",
          "content": "全夫妇正人伦恩当重报，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "家院、吴惠泉同下。"
        },
        {
          "type": "lyric",
          "speaker": "江氏",
          "mode": "二黄摇板",
          "content": "仗大义舍资财送妇归巢。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "江氏下。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "韩廷凤上。"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄摇板",
          "content": "劝世人一个个须要学好，皆因是自有那天里昭昭。我当年为太守何等荣耀，遇兵荒妻和子无有下梢。也是我前世里未曾修道，我若是全不为我自逍自遥。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "家院上，吴惠泉上，江氏上。"
        },
        {
          "type": "lyric",
          "speaker": "吴惠泉",
          "mode": "二黄摇板",
          "content": "我和你到他家双膝跪倒，"
        },
        {
          "type": "lyric",
          "speaker": "江氏",
          "mode": "二黄摇板",
          "content": "我夫妻特地来叩谢恩劳。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "哎呀！"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄摇板",
          "content": "我救人的急，全人的危，遵古训教，此小事何须要理顺和调。尊二位将请起施礼还到，全大节，全忠义，遵古天条。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "大娘子，这是何人？"
        },
        {
          "type": "dialogue",
          "speaker": "江氏",
          "mode": "",
          "content": "这是我丈夫吴惠泉。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "原来是吴相公，请坐请坐。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "大老爷在此，小人不敢坐。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "有话叙谈，哪有不坐之理？"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "告坐。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "大娘子你也坐下。"
        },
        {
          "type": "dialogue",
          "speaker": "江氏",
          "mode": "",
          "content": "谢坐。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "吴相公，听大娘子之言，你有病在床，病体好了，再来不迟。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "老爷有所不知，小人得了银钱，病就好了。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "吓，有了钱，你的病就好了。如此说来，银子是好物件！"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "好物件！"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄垛板",
          "content": "我救你的急，救你的难，救你的贫困，全你的节，全你的义，全你的婚姻。我无子也是我前生造定，我若是错婚姻，到后来留下了骂名。"
        },
        {
          "type": "stage_direction",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "笑"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "哈哈哈……"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "何不再娶一房，产得一子，也未可知。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "子孙之事，前生造定；若是再娶，也就不必了。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "何不买上一个孩童，将来有靠。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "这倒使得，只是本处孩子，有好些不便；或者远乡别处，饥寒贫苦的孩子，买他一个，教他成人。若不听教训，也是一番怄气。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "小人前在四川贸易，有些账目未归，如今恩人所赐资本，目下就要起身。倘有合适小孩，买来一个，送与恩人，以表我夫妻之情。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "那倒不消。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "娘子你我辞别恩人去吧。"
        },
        {
          "type": "dialogue",
          "speaker": "江氏",
          "mode": "",
          "content": "是。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "你二人要去了，我不能远送了。"
        },
        {
          "type": "lyric",
          "speaker": "吴惠泉",
          "mode": "二黄摇板",
          "content": "辞别了大恩人犹如山海，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "吴惠泉下。"
        },
        {
          "type": "lyric",
          "speaker": "江氏",
          "mode": "二黄摇板",
          "content": "到四川买一子报答恩来。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "江氏下。"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄摇板",
          "content": "他夫妻进门来双膝跪倒，口口声叫恩人珠泪双抛。我无子前世里未曾修道，作恶人总有子枉费心劳。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "韩廷凤下。"
        }
      ],
      "stats": {
        "line_count": 72,
        "lyric_ratio": 0.49,
        "stage_direction_count": 8
      }
    },
    {
      "scene_id": 3,
      "title": "",
      "characters_on_stage": [
        "金氏",
        "韩遇运"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "金氏上。"
        },
        {
          "type": "lyric",
          "speaker": "金氏",
          "mode": "念",
          "content": "只说养儿得济，谁知到老养儿。"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "",
          "content": "老身权在经之妻金氏。自从那匪贼作乱，中途拾得一子，取名天赐，抚养他长大。指望他养老，谁知丈夫去世，家业渐渐凋零。此子今年十二岁了，读书之外，哪里辨得一件事情。还是全靠老身养活与他。我今年迈，自身难保，哪里还有余资？倒不如将他卖了，留得几两银子，且作终身之靠。我儿哪里？"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "韩遇运上。"
        },
        {
          "type": "lyric",
          "speaker": "韩遇运",
          "mode": "念",
          "content": "天子重英豪，文章教尔曹。万般皆下品，惟有读书高。"
        },
        {
          "type": "lyric",
          "speaker": "金氏",
          "mode": "念",
          "content": "读书高，读书高，家业一旦抛。米也无钱买，柴也没得烧。喝一口清凉水，还要我自己去挑。"
        },
        {
          "type": "lyric",
          "speaker": "韩遇运",
          "mode": "念",
          "content": "候儿成人大，金榜把名标。"
        },
        {
          "type": "lyric",
          "speaker": "金氏",
          "mode": "念",
          "content": "候你成人大，母子两边飘。"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "母亲放心，等儿长大成人，若作了官，你就是太夫人了。"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "",
          "content": "好大的口气！我对你言讲：看这年年荒旱，母子难度光阴，我有意将你卖在大户人家，你也有安身之处，我也有了活命。"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "嗳，我是不卖的！"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "",
          "content": "我对你讲了吧：你不是我亲生之子，自因那年金兵造反，四月初八日在青州路上拾来的。"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "吓，你不是我的亲娘。哎呀，我的亲娘吓！"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "",
          "content": "哎呀，我说他不是我的亲生儿子，他就要他的亲娘。我如今不卖他，日后长大成人，他还要卖我吓！儿吓，不必啼哭，坐在地下，听为娘道来："
        },
        {
          "type": "lyric",
          "speaker": "金氏",
          "mode": "二黄慢板",
          "content": "农人家总只在耕田种地，全靠着用气力当家穿衣。读诗书千万卷难当柴米，我看你这小娃难以成器。"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "母亲吓，"
        },
        {
          "type": "lyric",
          "speaker": "韩遇运",
          "mode": "二黄原板",
          "content": "休道我在书房不耕不艺，你孩儿志气高满腹经奇。且等到羽毛干鹏程万里，那时节戴乌纱身挂紫衣。"
        },
        {
          "type": "lyric",
          "speaker": "金氏",
          "mode": "二黄原板",
          "content": "说什么羽毛干鹏程万里，看将来只怕是牛马不及。就是我亲生子也难养你，到今朝母子们一样分离。天赐儿随定娘将门紧闭，霎时间母子们各奔东西。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "金氏、韩遇运同下。"
        }
      ],
      "stats": {
        "line_count": 21,
        "lyric_ratio": 0.62,
        "stage_direction_count": 3
      }
    },
    {
      "scene_id": 4,
      "title": "",
      "characters_on_stage": [
        "吴惠泉",
        "金氏",
        "韩遇运"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "吴惠泉上。"
        },
        {
          "type": "lyric",
          "speaker": "吴惠泉",
          "mode": "二黄摇板",
          "content": "行一程又一程往回家奔，买一些送恩人方称我心。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "在下吴惠泉，蒙恩人韩太守，助我银两，才得来到四川，讨取账目。且喜账目收齐，回家便了。"
        },
        {
          "type": "lyric",
          "speaker": "吴惠泉",
          "mode": "二黄摇板",
          "content": "一日离家一日深，犹如孤雁宿寒林。人说在外风光好，还有思家一片心。"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "",
          "content": "走吓！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "金氏、韩遇运同上。"
        },
        {
          "type": "lyric",
          "speaker": "金氏",
          "mode": "二黄摇板",
          "content": "叹冤家和债主休要怄气，如今后两投奔各自分离。"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "",
          "content": "卖儿子，卖儿子！"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "你这妈妈手拿草标，还是人卖草，还是草卖人？"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "",
          "content": "人卖草能值几何？自然是草卖人。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "卖的哪一个？"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "",
          "content": "卖的就是这个孩童。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "这孩童是老妈妈什么人？"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "",
          "content": "乃是我的儿子。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "多大年纪？"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "",
          "content": "一十三岁。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "老妈妈偌大年纪，哪有一十三岁的孩童？"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "",
          "content": "他不是我的亲生儿子。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "哦，如此要卖多少银子？"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "",
          "content": "请问客官，还是为子，还是为仆？"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "自然是为子。"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "",
          "content": "既然是为子，我是要五十两银子。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "如数付给。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "吴惠泉交银。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "妈妈，这是五十两银子，你母子分别分别，我们要赶路了。"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "",
          "content": "是是是。请问客官家中，可有大娘？"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "有大娘。"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "",
          "content": "回去拜上大娘，就说这个孩童，不是我所生，就是我抚养，当打者骂他几句，当骂者说他几句。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "是是。"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "",
          "content": "天赐我儿，你去到那里，不同在为娘膝下。他那里打你，也要受了；他那里骂你，也要受了。为娘一言，你且听道："
        },
        {
          "type": "lyric",
          "speaker": "金氏",
          "mode": "二黄摇板",
          "content": "每日里必须要迟眠早起，切莫要贪玩耍孝顺父母。勤学业图上进休与人戏，莫要学在我处姣性顽皮。"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "",
          "content": "哎，儿吓！"
        },
        {
          "type": "lyric",
          "speaker": "金氏",
          "mode": "二黄摇板",
          "content": "要相逢只除非南柯梦里，"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "母亲请上，容孩儿一拜。"
        },
        {
          "type": "lyric",
          "speaker": "韩遇运",
          "mode": "二黄摇板",
          "content": "好叫人止不住珠泪双滴。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "走了走了。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "吴惠泉拉韩遇运同下。"
        },
        {
          "type": "lyric",
          "speaker": "金氏",
          "mode": "哭板",
          "content": "天赐，我儿，我的儿吓！"
        },
        {
          "type": "lyric",
          "speaker": "金氏",
          "mode": "二黄摇板",
          "content": "我儿一去无踪影，霎时母子两离分。"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "",
          "content": "哎呀，且住。我老糊涂了，我如今将他卖了，哪一个养我的老，送我的终？待我叫他回来。哎，客官请回来，我的儿子是不卖的！银子还了你！吓，客官请回来吓，我的儿子不卖的！银子还了你！哎吓，好银子！哎，好儿子！哦，看在银子份上，将他卖了，哎，儿吓！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "金氏下。"
        }
      ],
      "stats": {
        "line_count": 42,
        "lyric_ratio": 0.38,
        "stage_direction_count": 4
      }
    },
    {
      "scene_id": 5,
      "title": "",
      "characters_on_stage": [
        "韩廷凤",
        "吴惠泉",
        "韩遇运"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "韩廷凤上。"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄摇板",
          "content": "叹光阴去不归无限烦闷，似觉得人已老两鬓如银。清闲时看古书身体发困，"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "哎！"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄摇板",
          "content": "也是我韩门中绝了后根。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "吴惠泉、韩遇运同上。"
        },
        {
          "type": "lyric",
          "speaker": "吴惠泉",
          "mode": "二黄摇板",
          "content": "一路上看青山绿水长流，将此子献与他方遂心头。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "小相公，来此以是，少站片时。"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "是。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "参见大老爷。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "吴相公回来了，请坐请坐。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "谢坐。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "闻你成都收账，可曾收齐？"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "大账已完，小账所欠些微。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "发财了！"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "托老爷的洪福。告便。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "请。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "小相公随我来。"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "是。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "过来见过大老爷。"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "参见大老爷。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "罢了，罢了。一旁坐下。"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "大老爷在此，哪有晚生坐位？"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "叫你坐，只管坐下。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "是吓，大老爷叫你坐，你只管坐下。"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "谢坐。"
        },
        {
          "type": "stage_direction",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "笑"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "哈哈哈……"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "哎，吴相公，看看小小孩童，颇知这大礼仪！"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "这是他父母教训的好。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "是吓，小孩童原要父母教训。这小孩童，是哪里来的？"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "乃是买来的。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "还是为子，还是为仆？"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "乃是送与大老爷的。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "哦，乃是送与我的？"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "正是。"
        },
        {
          "type": "stage_direction",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "笑"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "哈哈哈……"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄平板",
          "content": "吴大哥你真真言而有信，你与我谋后代这样殷勤。多谢你这好心谨慎太胜，"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "吴大哥，"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄平板",
          "content": "改一日我必当另外谢承！"
        },
        {
          "type": "stage_direction",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "笑"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "哈哈哈！"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "我如今有了儿子，我是不发愁的了！"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "是是。有了儿子，还发什么愁？"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "请问大哥，此子是多少银子买的，待我奉价与的。"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "老爷要提价，就不敢了。我夫妻二人，粉身碎骨，也难报洪恩于万分之一也！"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "如此破费了！"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "告辞了！"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "为何去心太急？"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "我离家日久，恐娘子在家悬望。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "是吓，我也不必强留，改日我父子登门叩谢！"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "岂敢岂敢！"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "儿吓，送过你吴大叔！"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "送过吴大叔！"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "这倒不消。你在家中，听你爹爹教训，我要去了！"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "吓，吴大哥转来！改日我父子登门叩谢！一定要来的！"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "这就不敢！"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "一定要来的！"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "这就不敢！吓，大老爷转来！改日我夫妻二人，登门贺喜！"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "这就不敢！"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "一定要来的！"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "这就不敢！吴大哥转来！"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉",
          "mode": "",
          "content": "大老爷何事？"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "这，无有了。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "吴惠泉、韩廷凤同笑"
        },
        {
          "type": "dialogue",
          "speaker": "吴惠泉、韩廷凤",
          "mode": "",
          "content": "哈哈哈！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "吴惠泉下。"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "爹爹！"
        },
        {
          "type": "stage_direction",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "笑"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "喂，哈哈哈……随为父进来，一旁坐下。"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "谢坐。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "待为父细看一回。"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄原板",
          "content": "我的儿礼从容端然坐定，看形容不像个平等之人。细看他各部位五官端正，这两旁发开朗目秀眉清。儿在家可读过圣贤书本，问姣儿对为父细说分明。"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "孩儿在家，也曾读过诗书，只是未遇高明先生指教。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "哦！"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄原板",
          "content": "他说话有方寸志慧聪敏，倒像个宦门后不差毫分。再问你何年月何日降生，快说来好将你八字推评。"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "孩儿八字不知。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "你母亲呢？"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "也不晓得。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "呀！"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄原板",
          "content": "这孩童说此话令人不信，哪有个不知道八字时辰。儿父母年多大在与不在，是何人得参钱卖与他人？"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "我爹爹死了五年，我母亲七十三岁，孩儿今年一十三岁。只因家业凋零，将孩儿卖于他人。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "哦！"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄原板",
          "content": "这其间又盘出种种奇情，哪有个花甲后产育姣生？"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "儿吓！"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄原板",
          "content": "你不是那老娘亲生蒙混，儿必定不是她自己所生。"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "孩儿想起来了。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "想起什么来了？"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "我母亲那日将我出卖之时，孩儿依依不舍，她说我不是她亲生之子。乃是那年金兵造反，四月初八日，在青州路上拾来的。"
        },
        {
          "type": "stage_direction",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "笑"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "哈哈哈……"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄原板",
          "content": "照这样说起来越讲越近，想起了当年事越发是真。龙飞年五十一成都上任，四月里初八日路遇贼兵。亲生子还在那娘怀抱定，恨匪贼来冲散失落埃尘。取菱花两下里照一照相品，"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "儿吓！"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄原板",
          "content": "半像我半像妻不差毫分！"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "我的亲生孩儿，左脚之上，有一硃砂红痣，你可有？"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "孩儿有的。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "脱下来与为父观看！"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "遵命。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "韩遇运脱鞋，韩廷凤看。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "儿吓，"
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "二黄摇板",
          "content": "你是我亲生子名叫遇运，遇兵荒遭失散一十三春。为姣儿只盼得咽喉气哽，为姣儿昼夜里睡卧不宁。为姣儿不做官告归故井，这才是老天爷弄假成真。"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "爹爹，我母亲哪里去了？"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "你母亲命丧东平。"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "哎呀，母亲吓！"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "儿吓，不必啼哭，也曾命人前去搬柩。"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "爹爹明日差人接那老妈妈前来，同享荣华富贵。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "待为父明日差人前去。正是："
        },
        {
          "type": "lyric",
          "speaker": "韩廷凤",
          "mode": "念",
          "content": "北地南来西复东，谁知今日巧相逢。父子重把菱花照，只怕相逢在梦中。"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "爹爹，青天白日，不是做梦。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "不是做梦，当真？"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "当真。"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "果然？"
        },
        {
          "type": "dialogue",
          "speaker": "韩遇运",
          "mode": "",
          "content": "果然。"
        },
        {
          "type": "stage_direction",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "笑"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "哈哈哈！"
        },
        {
          "type": "dialogue",
          "speaker": "韩廷凤",
          "mode": "",
          "content": "儿吓，随为父来吓！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "韩廷凤、韩遇运同下。"
        }
      ],
      "stats": {
        "line_count": 120,
        "lyric_ratio": 0.35,
        "stage_direction_count": 9
      }
    }
  ]
}