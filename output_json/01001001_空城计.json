  "scenes": [
    {
      "scene_id": 1,
      "title": "帐中接报",
      "characters_on_stage": [
        "诸葛亮",
        "童儿",
        "旗牌",
        "报子",
        "老军甲",
        "老军乙"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二童儿同上，诸葛亮上。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "念",
          "content": "兵扎祁山地，要擒司马懿。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "旗牌上。"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "念",
          "content": "手捧地理图，报与丞相知。"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "来此已是。门上哪位在？"
        },
        {
          "type": "dialogue",
          "speaker": "童儿",
          "mode": "白",
          "content": "什么人？"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "烦劳通禀：献图人求见。"
        },
        {
          "type": "dialogue",
          "speaker": "童儿",
          "mode": "白",
          "content": "候着。启禀丞相：献图人求见。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "传。"
        },
        {
          "type": "dialogue",
          "speaker": "童儿",
          "mode": "白",
          "content": "献图人，丞相传进。"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "是，是。参见丞相。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "罢了。"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "谢丞相。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "你奉何人所差？"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "奉王将军所差。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "手捧何物？"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "地理图。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "展开。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮看图。旗牌欲下。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "转来。"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "在。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "快快去到列柳城，调赵老将军回营！快去！"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "遵命。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "旗牌下。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "嗳，好一个胆大的马谡呀。临行之时，山人怎样吩咐与你：叫你靠山近水，安营扎寨。怎么你不听我言，偏偏在山顶扎寨？只恐街亭难保。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "报子上。"
        },
        {
          "type": "dialogue",
          "speaker": "报子",
          "mode": "白",
          "content": "启禀丞相：马谡失守街亭。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "再探！"
        },
        {
          "type": "dialogue",
          "speaker": "报子",
          "mode": "白",
          "content": "得令。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "报子下。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "如何，果然把街亭失守了。虽然马谡失守街亭，乃是我诸葛亮之罪也。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "报子上。"
        },
        {
          "type": "dialogue",
          "speaker": "报子",
          "mode": "白",
          "content": "司马懿带兵复夺西城。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "再探！"
        },
        {
          "type": "dialogue",
          "speaker": "报子",
          "mode": "白",
          "content": "得令。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "报子下。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "果然，司马带兵复夺西城。哎，想先帝在白帝城托孤之时，言道：马谡言过其实，终无大用。悔不听先帝之言，错用马谡，失守街亭，我是悔之晚矣！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "报子上。"
        },
        {
          "type": "dialogue",
          "speaker": "报子",
          "mode": "白",
          "content": "司马懿大兵离西城还有四十余里。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "再探！"
        },
        {
          "type": "dialogue",
          "speaker": "报子",
          "mode": "白",
          "content": "得令。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "报子下。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "嗳，司马懿的大兵，他来得好快呀！哽，他来得好快呀！人道司马用兵如神，今日一见，是令人可服，令人可敬。哎呀，且住。说什么令人可服，令人可敬？想这西城的兵将，俱被山人调遣在外，司马懿大兵到此，难道叫我军束手就擒，这束手就擒！来，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "童儿允。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "传老军们进见。"
        },
        {
          "type": "dialogue",
          "speaker": "童儿",
          "mode": "白",
          "content": "传老军们进见。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二老军同上。"
        },
        {
          "type": "dialogue",
          "speaker": "二老军",
          "mode": "白",
          "content": "哽唬！"
        },
        {
          "type": "dialogue",
          "speaker": "老军甲",
          "mode": "念",
          "content": "司马兵到，"
        },
        {
          "type": "dialogue",
          "speaker": "老军乙",
          "mode": "念",
          "content": "心惊肉跳。"
        },
        {
          "type": "dialogue",
          "speaker": "二老军",
          "mode": "白",
          "content": "参见丞相。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "罢了。"
        },
        {
          "type": "dialogue",
          "speaker": "二老军",
          "mode": "白",
          "content": "唤小人们进帐，有何差遣？"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "你们可是西城的老军？"
        },
        {
          "type": "dialogue",
          "speaker": "二老军",
          "mode": "白",
          "content": "正是。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "你等将西城四门大开，打扫街道。司马懿大兵到此，不要害怕，违令者斩。"
        },
        {
          "type": "dialogue",
          "speaker": "二老军",
          "mode": "白",
          "content": "遵命。"
        },
        {
          "type": "dialogue",
          "speaker": "老军甲",
          "mode": "念",
          "content": "丞相吩咐我，"
        },
        {
          "type": "dialogue",
          "speaker": "老军乙",
          "mode": "念",
          "content": "准死不能活。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二老军下。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "琴童，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "童儿允。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "带定瑶琴美酒，随山人敌楼去者。"
        },
        {
          "type": "dialogue",
          "speaker": "童儿",
          "mode": "白",
          "content": "遵命。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "叫头",
          "content": "天呀，天哪！汉室兴败就在我这空城一计也！"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "我用兵数十年从来谨慎，悔不该差马谡无用之人。设下了空城计我的心中不定，望空中求先帝要大显神灵。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮下。"
        }
      ],
      "stats": {
        "line_count": 65,
        "lyric_ratio": 0.062,
        "stage_direction_count": 16
      }
    },
    {
      "scene_id": 2,
      "title": "兵马云集",
      "characters_on_stage": [
        "司马懿",
        "司马师",
        "司马昭",
        "龙套",
        "赵云"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四白龙套同上，司马懿、司马师、司马昭同上，急急风过场，同下。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四上手引赵云急急风过场，同下。"
        }
      ],
      "stats": {
        "line_count": 2,
        "lyric_ratio": 0.0,
        "stage_direction_count": 2
      }
    },
    {
      "scene_id": 3,
      "title": "空城抚琴",
      "characters_on_stage": [
        "诸葛亮",
        "童儿",
        "老军甲",
        "老军乙",
        "司马懿",
        "司马师",
        "司马昭",
        "龙套"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二老军同上，打扫街道。"
        },
        {
          "type": "dialogue",
          "speaker": "二老军",
          "mode": "白",
          "content": "有请丞相。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二童儿引诸葛亮同上。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "那马谡失街亭令人可恨，这时候倒叫我难以调停。"
        },
        {
          "type": "dialogue",
          "speaker": "老军甲",
          "mode": "白",
          "content": "伙计，司马懿大兵到此，丞相不遣将对敌，反将四门大开，是何原故呢？"
        },
        {
          "type": "dialogue",
          "speaker": "老军乙",
          "mode": "白",
          "content": "我倒明白了。"
        },
        {
          "type": "dialogue",
          "speaker": "老军甲",
          "mode": "白",
          "content": "你明白什么？"
        },
        {
          "type": "dialogue",
          "speaker": "老军乙",
          "mode": "白",
          "content": "丞相有点老糊涂呢。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "哽。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "老军们因何故你们纷纷议论？"
        },
        {
          "type": "dialogue",
          "speaker": "二老军",
          "mode": "白",
          "content": "非是小人们纷纷议论，司马懿大兵到此，不遣将对敌，反将四门大开，是何原故？"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "国家事用不着尔等当心。"
        },
        {
          "type": "dialogue",
          "speaker": "二老军",
          "mode": "白",
          "content": "话虽如此，国家事不用小人们当心。西城到汉中，乃是咽喉路径，司马大兵到来，一拥而进，西城失守，如何是好？"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "从西城到汉中乃是咽喉路径，"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "尔来看，"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "我城内早埋伏有十万神兵。"
        },
        {
          "type": "dialogue",
          "speaker": "老军甲",
          "mode": "白",
          "content": "哦，伙计，怪不得丞相不着急，城里头埋伏好的十万神兵呢！"
        },
        {
          "type": "dialogue",
          "speaker": "老军乙",
          "mode": "白",
          "content": "我倒不信，我去看看。"
        },
        {
          "type": "dialogue",
          "speaker": "老军甲",
          "mode": "白",
          "content": "你去看看。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "老军乙看。"
        },
        {
          "type": "dialogue",
          "speaker": "老军乙",
          "mode": "白",
          "content": "伙计，"
        },
        {
          "type": "dialogue",
          "speaker": "老军甲",
          "mode": "白",
          "content": "你看见没有？"
        },
        {
          "type": "dialogue",
          "speaker": "老军乙",
          "mode": "白",
          "content": "认什么，无有看见。"
        },
        {
          "type": "dialogue",
          "speaker": "老军甲",
          "mode": "白",
          "content": "你肉眼凡胎，看不见的，让我去看。"
        },
        {
          "type": "dialogue",
          "speaker": "老军乙",
          "mode": "白",
          "content": "你去看看。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "老军甲看。"
        },
        {
          "type": "dialogue",
          "speaker": "老军甲",
          "mode": "笑",
          "content": "哈哈哈……"
        },
        {
          "type": "dialogue",
          "speaker": "老军乙",
          "mode": "白",
          "content": "你看见没有？"
        },
        {
          "type": "dialogue",
          "speaker": "老军甲",
          "mode": "白",
          "content": "不要说人，连个鬼影子都没有。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "劝你们放大了胆把街道扫净，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "后场擂鼓。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "退司马保空城全仗此琴。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮上城。"
        },
        {
          "type": "lyric",
          "speaker": "司马懿",
          "mode": "内西皮导板",
          "content": "得了街亭望西城，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四龙套、司马懿、司马师、司马昭同上。"
        },
        {
          "type": "lyric",
          "speaker": "司马懿",
          "mode": "西皮摇板",
          "content": "城门大开为何因？"
        },
        {
          "type": "dialogue",
          "speaker": "司马懿",
          "mode": "白",
          "content": "且住，适才探马报道：西城乃是空城。老夫兴兵到此，为何四门大开。咦，你看诸葛亮又在那里弄鬼，不要中了他人之计，待我先传一令。众将官，听我令下："
        },
        {
          "type": "lyric",
          "speaker": "司马懿",
          "mode": "西皮快板",
          "content": "坐在马上传一令，大小将官听分明：有人若把西城进，定斩首级不容情。"
        },
        {
          "type": "dialogue",
          "speaker": "众人",
          "mode": "白",
          "content": "哦。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮慢板",
          "content": "我本是卧龙岗散淡的人，论阴阳如反掌保定乾坤。先帝爷下南阳御驾三请，算就了汉家业鼎足三分。官封到武乡侯执掌帅印，东西征南北剿博古通今。周文王访姜尚周室大振，诸葛亮怎比得前辈的先生。闲无事在敌楼亮一亮琴音，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮抚琴。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "笑",
          "content": "哈哈哈……"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮慢板",
          "content": "我面前缺少个知音的人。"
        },
        {
          "type": "lyric",
          "speaker": "司马懿",
          "mode": "西皮原板",
          "content": "坐在马上来观定，城楼上坐的是诸葛孔明。左右琴童来捧酒，打扫街道老弱残兵。我本当传将令杀进城，"
        },
        {
          "type": "dialogue",
          "speaker": "众人",
          "mode": "白",
          "content": "喝！"
        },
        {
          "type": "dialogue",
          "speaker": "司马懿",
          "mode": "白",
          "content": "且慢。"
        },
        {
          "type": "lyric",
          "speaker": "司马懿",
          "mode": "西皮摇板",
          "content": "又恐怕中了他巧计行。你的计策休瞒我，棋逢敌手一样人。"
        },
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮二六板",
          "content": "我正在城楼观山景，耳听得城外乱纷纷。旌旗招展空翻影，却原来是司马发来的兵。我也曾命人去打听，打听那司马领兵往西行。一来是马谡无谋少学问，二来是将帅不和，失守我的街亭。连得我三城多侥幸，贪而无厌又夺我的西城。诸葛亮在城楼把驾等，等候你司马到此，咱们谈、谈、谈谈心。进得城来无别敬，我只有羊羔美酒，美酒羊羔，犒赏你的三军。左右琴童人两个，又无有埋伏又无有兵。你休要胡思乱想心不定，你就来、来、来，请上城楼，司马你听我扶琴。"
        },
        {
          "type": "lyric",
          "speaker": "司马懿",
          "mode": "西皮摇板",
          "content": "左思右想心不定，城内必有埋伏兵。"
        },
        {
          "type": "dialogue",
          "speaker": "司马昭",
          "mode": "白",
          "content": "听他琴内慌迫，一定是空城。乘此机会，杀进城去……"
        },
        {
          "type": "dialogue",
          "speaker": "司马懿",
          "mode": "白",
          "content": "哽。那孔明平生谨慎，从不弄险，不要中了他人之计。将前队改为后队，人马倒退四十余里。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "龙套欲下。"
        },
        {
          "type": "dialogue",
          "speaker": "司马懿",
          "mode": "白",
          "content": "待我说破于他。诸葛亮呀，诸葛孔明，你实城也罢，空城也罢，你司马老爷是不进城了。请呀请呀！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "龙套、司马懿同下。"
        },
        {
          "type": "dialogue",
          "speaker": "二老军",
          "mode": "白",
          "content": "启禀丞相：司马懿人马倒退四十余里。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "笑",
          "content": "哈哈哈……"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二老军同下，诸葛亮下城。"
        }
      ],
      "stats": {
        "line_count": 120,
        "lyric_ratio": 0.458,
        "stage_direction_count": 20
      }
    },
    {
      "scene_id": 4,
      "title": "遣将迎敌",
      "characters_on_stage": [
        "诸葛亮",
        "赵云",
        "龙套"
      ],
      "segments": [
        {
          "type": "lyric",
          "speaker": "诸葛亮",
          "mode": "西皮摇板",
          "content": "人言司马有才能，带兵不敢进西城。看起来我主爷还有天分，等马谡回营来以正军情。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四上手、赵云同上。"
        },
        {
          "type": "dialogue",
          "speaker": "赵云",
          "mode": "白",
          "content": "参见丞相。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "哎呀，老将军呀。今有司马带兵夺取西城，被山人略施小计，他兵退四十里。恐他复夺西城，老将军快快抵挡一阵。"
        },
        {
          "type": "dialogue",
          "speaker": "赵云",
          "mode": "白",
          "content": "得令。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "赵云引四上手下。"
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "白",
          "content": "正是："
        },
        {
          "type": "dialogue",
          "speaker": "诸葛亮",
          "mode": "念",
          "content": "虎豹归山禽兽远，蛟龙得水快如沧。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "诸葛亮下。"
        }
      ],
      "stats": {
        "line_count": 15,
        "lyric_ratio": 0.267,
        "stage_direction_count": 3
      }
    },
    {
      "scene_id": 5,
      "title": "司马败走",
      "characters_on_stage": [
        "司马懿",
        "司马师",
        "司马昭",
        "龙套",
        "赵云",
        "报子"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四龙套、司马懿、司马师、司马昭同上。报子上。"
        },
        {
          "type": "dialogue",
          "speaker": "报子",
          "mode": "白",
          "content": "西城乃是空城。"
        },
        {
          "type": "dialogue",
          "speaker": "司马懿",
          "mode": "白",
          "content": "再探！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "报子下。"
        },
        {
          "type": "dialogue",
          "speaker": "司马师、司马昭",
          "mode": "白",
          "content": "如何？"
        },
        {
          "type": "dialogue",
          "speaker": "司马懿",
          "mode": "白",
          "content": "众将官复夺西城！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "众人同允。四上手引赵云同上，两下会阵。"
        },
        {
          "type": "dialogue",
          "speaker": "司马懿",
          "mode": "白",
          "content": "来将通名。"
        },
        {
          "type": "dialogue",
          "speaker": "赵云",
          "mode": "白",
          "content": "常山赵云。"
        },
        {
          "type": "dialogue",
          "speaker": "司马懿",
          "mode": "白",
          "content": "收兵，收兵！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四龙套、司马懿、司马师、司马昭同下。四上手、赵云同下。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四龙套、司马懿、司马师、司马昭同上。"
        },
        {
          "type": "dialogue",
          "speaker": "司马懿",
          "mode": "白",
          "content": "呸呸！我说是实城，你们说是空城。那赵云从天上掉下来的不成？"
        },
        {
          "type": "dialogue",
          "speaker": "司马昭",
          "mode": "白",
          "content": "我等哪里知道。"
        },
        {
          "type": "dialogue",
          "speaker": "司马懿",
          "mode": "白",
          "content": "诸葛亮呀，你的胆也太大了！司马懿呀，你的胆也就太小了！看将起来，司马不如亮也。众将官，悄悄地收兵。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "同下。"
        }
      ],
      "stats": {
        "line_count": 25,
        "lyric_ratio": 0.0,
        "stage_direction_count": 8
      }
    }
