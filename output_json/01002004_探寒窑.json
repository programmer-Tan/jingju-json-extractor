  "scenes": [
    {
      "scene_id": 1,
      "title": "相府",
      "characters_on_stage": [
        "陈氏",
        "丫鬟",
        "家院"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "丫鬟引陈氏同上。"
        },
        {
          "type": "lyric",
          "speaker": "陈氏",
          "mode": "引子",
          "content": "鹤发皓首，两鬓如霜。"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "念",
          "content": "夫为相国伴皇家，妻沾雨露享荣华。终朝只把娇儿叹，哪得周全喜生花。"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "老身陈氏，配夫王允。膝下无儿，所生三女：长女金钏，许配苏龙；次女银钏，许配魏虎；三女宝钏，配夫平贵。可恨三女性情高傲，居住城南，老身百般相劝，执意不肯回府。今早也曾命家院去往城南，探望三女度日光景如何。这时候怎么还不见回来？丫鬟伺候了！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "家院上。"
        },
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "念",
          "content": "有事即来报，无事不乱言。"
        },
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "白",
          "content": "参见老夫人。"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "罢了，起来。命你打听三姑娘，光景如何？"
        },
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "白",
          "content": "三姑娘在窑中身染重病。"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "你待怎讲？"
        },
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "白",
          "content": "三姑娘身染重病！"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "哎呀，儿吓！"
        },
        {
          "type": "lyric",
          "speaker": "陈氏",
          "mode": "西皮摇板",
          "content": "听得家院一声禀，烈性的三女病缠身。"
        },
        {
          "type": "lyric",
          "speaker": "陈氏",
          "mode": "哭板",
          "content": "眼望城南高声叫，我的儿吓……"
        },
        {
          "type": "lyric",
          "speaker": "陈氏",
          "mode": "西皮摇板",
          "content": "怎能够到寒窑探望儿身。"
        },
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "白",
          "content": "老夫人不必啼哭，何不多带银米衣裳，去往寒窑探望三姑娘。"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "言之有理。家院、丫鬟，多带银米衣裳与你三姑娘。家院，吩咐外面车辆伺候。"
        },
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "白",
          "content": "车辆走上。"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "儿吓！"
        },
        {
          "type": "lyric",
          "speaker": "陈氏",
          "mode": "西皮慢板",
          "content": "叫家院你与我前把路引，想从前大不该彩楼结亲。为宝钏把我的精神用尽，为女儿与相国吵闹相争；为宝钏常忧闷神昏不定，为女儿哭得我头闷眼昏。实可叹薛平郎西凉丧命，宝钏儿受凄凉一十七春。"
        }
      ],
      "stats": {
        "line_count": 32,
        "lyric_ratio": 0.375,
        "stage_direction_count": 2
      }
    },
    {
      "scene_id": 2,
      "title": "寒窑",
      "characters_on_stage": [
        "陈氏",
        "丫鬟",
        "家院",
        "王宝钏"
      ],
      "segments": [
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "白",
          "content": "老夫人，此地已是寒窑。"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "前去叫门。"
        },
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "白",
          "content": "三姑娘开门来。"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "内白",
          "content": "来了。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "王宝钏上。"
        },
        {
          "type": "lyric",
          "speaker": "王宝钏",
          "mode": "西皮摇板",
          "content": "忽听窑外有人声，想必是四邻探奴身。薛郎一去无音信，寒窑内哭坏女钗裙。"
        },
        {
          "type": "dialogue",
          "speaker": "家院",
          "mode": "白",
          "content": "三姑娘开门来，老夫人来了。"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "白",
          "content": "哎呀！"
        },
        {
          "type": "lyric",
          "speaker": "王宝钏",
          "mode": "西皮流水板",
          "content": "老娘来到城南郡，好一似钢刀刺在心。儿夫西凉丧了命，这回怎见老娘亲？"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "王宝钏开窑，出窑。"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "叫头",
          "content": "母亲！"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "叫头",
          "content": "宝钏！"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "叫头",
          "content": "老娘！"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "叫头",
          "content": "我儿！"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "哭",
          "content": "老娘亲吓！"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "哭",
          "content": "哎呀，儿吓！"
        },
        {
          "type": "lyric",
          "speaker": "陈氏",
          "mode": "西皮导板",
          "content": "一见娇儿珠泪滚，"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "哭",
          "content": "三女，宝钏儿吓！"
        },
        {
          "type": "lyric",
          "speaker": "陈氏",
          "mode": "西皮流水板",
          "content": "手搀三女说分明：儿在相府多侥幸，乖巧伶俐甚聪明。闲来绣阁挑花朵，闷来花园散精神。多少侍女来陪伴，许多丫鬟随后跟。自从我儿出相府，母女分别十七春。从前娇容如嫩笋，今朝我儿变了形。面黄肌瘦容颜改，忍饥受饱不回心。日见无人来谈论，晚来好似一孤灯。寒风冷凉儿受尽，破窑怎藏儿的身？你本是宰相千金女，叫娘心疼不心疼！"
        },
        {
          "type": "lyric",
          "speaker": "王宝钏",
          "mode": "西皮二六板",
          "content": "老娘不必两泪淋，女儿言来听分明：大姐、二姐有福分，许配为官做宦人。惟有女儿命内苦，彩球单打花郎身。好的好来歹的歹，富的富来贫的贫。若人多想为官宦，谁做耕田种地人？"
        },
        {
          "type": "lyric",
          "speaker": "陈氏",
          "mode": "西皮流水板",
          "content": "背地里只把相国恨，三个女儿两看承。大女、二女我不爱，唯有冤家我心疼。老身今年六十九，瓦上霜来风前灯。今日见了娇儿面，好似枯木又逢春。"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "白",
          "content": "母亲请上，待女儿拜见。"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "儿不要拜了。"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "白",
          "content": "儿久离膝下，少奉甘旨，望母亲恕罪！"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "我儿起来。家院、丫鬟，见过你三姑娘。"
        },
        {
          "type": "dialogue",
          "speaker": "家院、丫鬟",
          "mode": "同白",
          "content": "参见三姑娘！"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "白",
          "content": "罢了！"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "白",
          "content": "母亲不在相府，来至寒窑则甚？"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "家院回府：报道吾儿身染重病。此病从何而起？"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "白",
          "content": "多因魏虎打从寒窑经过，言道儿丈夫命丧西凉，爹爹又差人前来劝奴改嫁，儿闻此言，因此身体十分病重。今日母亲到此，该是儿的病，好了一半了。"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "哦，我把你这老天杀的，常常逼我儿改嫁，此番回去，又要与他吵闹一场！"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "白",
          "content": "吓，母亲，为了女儿，不要伤了你二老的和气。"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "儿吓，为娘看在我儿分上，不与你父吵闹就是。"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "白",
          "content": "多谢母亲。"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "儿吓，为娘要进窑内看看，我儿的度日光景如何？"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "白",
          "content": "寒窑窄小，不看也罢了。"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "咳，我儿住了一十七载，难道为娘就进去不得么？"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "白",
          "content": "如此待女儿打扫打扫。"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "不用打扫，与为娘带路进窑，儿吓！"
        },
        {
          "type": "lyric",
          "speaker": "陈氏",
          "mode": "西皮摇板",
          "content": "雕梁画阁儿不住，寒窑怎存我儿身？"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "白",
          "content": "哎，母亲请用。"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "哎呀！"
        },
        {
          "type": "lyric",
          "speaker": "陈氏",
          "mode": "西皮摇板",
          "content": "珍馐海味儿不用，罐内稀饭怎度光阴？"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏、陈氏",
          "mode": "同三叫头",
          "content": "（母亲）（宝钏）！（老娘）（我儿）！哎吓，（老娘亲）（儿吓）！"
        },
        {
          "type": "lyric",
          "speaker": "陈氏",
          "mode": "西皮摇板",
          "content": "哭一声王宝钏！"
        },
        {
          "type": "lyric",
          "speaker": "王宝钏",
          "mode": "西皮摇板",
          "content": "叫一声老娘亲！"
        },
        {
          "type": "lyric",
          "speaker": "陈氏",
          "mode": "西皮摇板",
          "content": "想当年在相府何等侥幸，到如今住寒窑娘好心痛。"
        },
        {
          "type": "lyric",
          "speaker": "王宝钏",
          "mode": "西皮摇板",
          "content": "只当孩儿伤了命，何劳娘亲挂在心？"
        },
        {
          "type": "lyric",
          "speaker": "陈氏",
          "mode": "西皮摇板",
          "content": "儿随为娘回相府，只享荣华不愁贫。"
        },
        {
          "type": "lyric",
          "speaker": "王宝钏",
          "mode": "西皮摇板",
          "content": "儿与爹爹三击掌，饿死寒窑不进相府门。"
        },
        {
          "type": "lyric",
          "speaker": "陈氏",
          "mode": "哭板",
          "content": "王宝钏……"
        },
        {
          "type": "lyric",
          "speaker": "王宝钏",
          "mode": "哭板",
          "content": "老娘亲……"
        },
        {
          "type": "lyric",
          "speaker": "陈氏、王宝钏",
          "mode": "同哭板",
          "content": "呀吓呀吓！"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "哭",
          "content": "我的儿吓……"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "哭",
          "content": "老娘亲吓……"
        },
        {
          "type": "lyric",
          "speaker": "王宝钏",
          "mode": "西皮导板",
          "content": "老娘亲请上容儿拜禀，"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "我儿不必拜了，一旁坐了。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "家院、丫鬟同暗下。"
        },
        {
          "type": "lyric",
          "speaker": "王宝钏",
          "mode": "西皮慢板",
          "content": "母女们在寒窑叙一叙苦情：都只为老娘亲身染重病，女儿在后花园把香来焚。许愿降香三年整，后宫娘娘得知情。恩赐五彩花绒线，绣成了彩球定终身。实指望打中宦门后，谁知单打在花郎身。夫妻二人相府进，老爹爹一见怒气升。前门赶出薛平贵，后门赶出女儿身。夫妻二人无投奔，破瓦寒窑把身存。渠江河内妖魔显，红鬃烈马乱伤人。平贵擒了红鬃马，唐王驾前去讨封。西凉贼子造了反，平贵倒做马先行。一去不觉十七载，儿比孤雁失了群。老娘回府对父论，休把孩儿挂在心。"
        },
        {
          "type": "lyric",
          "speaker": "陈氏",
          "mode": "西皮摇板",
          "content": "我儿不必心烦闷，不要啼哭费精神。不要听你父的话，不要牵挂平郎身。儿随为娘回相府，跟娘坐来随娘行。倘若你父有谈论，舍生忘死拼他人。若是为娘归泉路，儿就是披麻戴孝人。"
        },
        {
          "type": "lyric",
          "speaker": "王宝钏",
          "mode": "西皮摇板",
          "content": "老娘亲不必两泪淋，女儿言来听分明：倘若老娘身亡故，儿是披麻戴孝人；倘若爹爹身亡故，女儿不去哭半声。宝钏烧香把佛敬，儿要修修来世身。"
        },
        {
          "type": "lyric",
          "speaker": "陈氏",
          "mode": "西皮摇板",
          "content": "立志守节拿得稳，皇天不负你这苦心人。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "家院、丫鬟同暗上。"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "家院、丫鬟，将银米衣裳，交与你三姑娘。"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "白",
          "content": "且慢，相府之物，一概不要。"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "儿吓，你不收下，岂不辜负为娘一片好心？儿吓，收下罢！"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "白",
          "content": "多谢母亲！"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "这便才是。家院、丫鬟，你们暂且回去，老身在此陪伴你三姑娘一宵，明日回府。"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "白",
          "content": "吓，母亲，寒窑肮脏得紧，母亲焉能得住？"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "我儿住得，难道为娘就住不得么？"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "白",
          "content": "且住，母亲不回相府，这便如何是好？我自有道理。吓，母亲，女儿情愿回转相府去了。"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "好，我儿情愿回得相府了！家院吩咐车辆搭上。我儿开了窑门。"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "白",
          "content": "是。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "陈氏、家院、丫鬟同出窑，王宝钏关窑门。"
        },
        {
          "type": "dialogue",
          "speaker": "陈氏",
          "mode": "白",
          "content": "儿吓，为何将窑门紧闭？"
        },
        {
          "type": "dialogue",
          "speaker": "王宝钏",
          "mode": "白",
          "content": "啊吓，母亲哪！儿与爹爹三击掌，饿在寒窑……也是不回去的了！"
        },
        {
          "type": "lyric",
          "speaker": "陈氏",
          "mode": "哭板",
          "content": "儿吓，狠心的儿，不把娘来送！"
        },
        {
          "type": "lyric",
          "speaker": "王宝钏",
          "mode": "哭板",
          "content": "娘吓，儿跪寒窑送娘亲。"
        },
        {
          "type": "lyric",
          "speaker": "陈氏",
          "mode": "哭板",
          "content": "娘哭儿来天地震！"
        },
        {
          "type": "lyric",
          "speaker": "王宝钏",
          "mode": "哭板",
          "content": "儿哭娘来泪成冰！"
        },
        {
          "type": "lyric",
          "speaker": "陈氏",
          "mode": "哭板",
          "content": "我那狠心的王三姐！"
        },
        {
          "type": "lyric",
          "speaker": "王宝钏",
          "mode": "哭板",
          "content": "我那疼儿的老娘亲……吓……"
        },
        {
          "type": "lyric",
          "speaker": "陈氏",
          "mode": "哭板",
          "content": "啊……啊……啊……啊……我的儿吓……"
        },
        {
          "type": "lyric",
          "speaker": "王宝钏",
          "mode": "哭板",
          "content": "啊吓……儿的老娘亲吓……吓……吓……吓……"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "众人同下。"
        }
      ],
