  "scenes": [
    {
      "scene_id": 1,
      "title": "",
      "characters_on_stage": [
        "祢衡"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "祢衡上"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "引子",
          "content": "天宽地阔海无边，成败兴亡梦里眠"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "念",
          "content": "口若悬河语似流，舌上风云用计谋。男儿须当擎天手，自幼谈笑觅封侯"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "卑人姓祢名衡，字正平，乃山西平原郡，幼义村人氏。自幼勤习经史，深知策略，虽怀王佐之才，惜乎未遇其主。身在孔大夫府中作幕，昨日将我荐与曹府效用。想那曹操，名为汉相，实为汉贼，焉能敬贤礼士？我此次去至曹府，需要见机而行。正是："
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "念",
          "content": "未遇真命主，辜负栋梁才"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮慢板",
          "content": "平生志气运未通，似蛟龙困在浅水中。有朝一日春雷动，际会风云上九重"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮二六板",
          "content": "自幼儿窗前习孔孟，壮游北海遇孔融。他将我荐与曹府用，要学孙膑下云梦"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "祢衡下"
        }
      ],
      "stats": {
        "line_count": 22,
        "lyric_ratio": 0.36,
        "stage_direction_count": 2
      }
    },
    {
      "scene_id": 2,
      "title": "",
      "characters_on_stage": [
        "曹操",
        "四文堂",
        "张辽",
        "孔融",
        "祢衡"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四文堂引曹操同上"
        },
        {
          "type": "lyric",
          "speaker": "曹操",
          "mode": "西皮摇板",
          "content": "三国纷纷刀兵扰，每日思想计千条。但愿狼烟一起扫，四海升平乐唐尧"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "张辽上"
        },
        {
          "type": "lyric",
          "speaker": "张辽",
          "mode": "西皮摇板",
          "content": "一封书信忙修起，见了丞相说端的"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "参见丞相"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "将军少礼，请坐"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "谢坐"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "命你修书，你可曾修起？"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "已经修好。命何人送去？"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "孔融荐举祢衡，还未见到来"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "想必来也"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "孔融上"
        },
        {
          "type": "lyric",
          "speaker": "孔融",
          "mode": "西皮摇板",
          "content": "祢衡先生我请到，见了丞相说根苗"
        },
        {
          "type": "dialogue",
          "speaker": "孔融",
          "mode": "白",
          "content": "参见丞相"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "少礼请坐"
        },
        {
          "type": "dialogue",
          "speaker": "孔融",
          "mode": "白",
          "content": "谢坐"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "祢衡可曾唤到？"
        },
        {
          "type": "dialogue",
          "speaker": "孔融",
          "mode": "白",
          "content": "现在府外"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "唤他进来"
        },
        {
          "type": "dialogue",
          "speaker": "孔融",
          "mode": "白",
          "content": "有请祢衡先生"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "内白",
          "content": "来也！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "祢衡上"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮快板",
          "content": "相府门前杀气高，密密层层摆枪刀。画阁雕梁双凤绕，赛似天子九龙朝"
        },
        {
          "type": "dialogue",
          "speaker": "孔融",
          "mode": "白",
          "content": "祢衡先生参见丞相"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "祢衡参见丞相"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "下站何人？"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "姓祢名衡，乃山西平原郡人氏"
        },
        {
          "type": "dialogue",
          "speaker": "孔融",
          "mode": "白",
          "content": "这就是祢先生"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "怕老夫不知他叫祢衡？见了老夫，这等大模大样，只行常礼，其实可恼！"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "哦呵呀！我道曹操敬贤礼士，却原来不识好人。吾进得相府，与他深施一礼，他坐在上面，昂然不动，倒也罢了，反说我礼貌不周。我乃天下奇士，岂肯与奸贼低首吓。孔文举你将我荐错了"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮快板",
          "content": "人言曹操多奸狡，果然好比秦赵高。欺郡罔上非正道，全凭势力压当朝。站立在廊下微微笑，哪怕虎穴与笼牢"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "笑",
          "content": "哈哈哈……"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "为何发笑？"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "我笑这天地虽阔，却无一人也"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "老夫帐下，文能安邦，武能定国，何言无人？"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "你道你帐下，文能安邦，武能定国，俱是英雄豪杰，但不知文有谁高，武有谁能？祢某愿闻一二"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "你且听来：文有荀彧、荀攸、郭嘉、程昱，机深智远，虽萧何、陈平，不可及也。武有张辽、许褚、李典、乐进，不让当年岑彭、马武。我儿曹子孝，人称天下奇才；夏侯惇可称无敌将军。老夫兴兵以来，攻无不取，战无不克。顺我者生，逆我者死，何言无人？"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "笑",
          "content": "呀，哈哈哈……"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "你且听道：你帐下尽都是英雄上将，以我看来，尽是无用之辈！"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "怎见得？"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "你且听道：荀彧、荀攸，可使吊丧问奠；郭嘉、程昱，只好看墓守坟；李典、乐进，只好牧羊放马；许褚、张辽……"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "唔……"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "只好击鼓鸣更。曹子孝呼为要钱太守；夏侯惇称为完体将军。余下诸人，尽都是衣架饭囊，酒桶肉袋，碌碌之辈，何足道哉？"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "你有此狂言，有何德能？"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "祢某无才，天文地理之书，无一不知；三教九流，无一不晓。上可以致君为尧舜，下可以配德于孔颜。吾乃天下名士，岂肯与奸贼同党。孔文举你不要装痴了"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮快板",
          "content": "自幼窗前习管鲍，兵书战策日夜瞧。我本堂堂一秀表，岂与犬马共同槽"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "唗！"
        },
        {
          "type": "lyric",
          "speaker": "张辽",
          "mode": "西皮摇板",
          "content": "听罢言来心烦恼，误骂豪杰为哪条？三尺青锋出了鞘"
        },
        {
          "type": "lyric",
          "speaker": "孔融",
          "mode": "西皮摇板",
          "content": "将军息怒慢开刀"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "张将军休要污秽老夫的宝剑。祢衡，明日老夫大宴群臣，命你当一鼓吏，你可愿当？"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "这个……"
        },
        {
          "type": "dialogue",
          "speaker": "孔融",
          "mode": "白",
          "content": "祢先生应允了吧！"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "愿当鼓吏"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "好，明日来早便罢，倘若来迟，按军令施行。张将军将他赶出帐去！"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "呀！"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮二六板",
          "content": "丞相委用恩非小，屈为鼓吏怎敢辞劳？出得帐来微微笑，孔大夫做事也不高。明知曹操眼孔小，沙滩无水怎能壳藏蛟"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮快板",
          "content": "满腹经纶空怀抱，有志不能上九霄。越思越想心头恼，施一个巧计骂奸曹。安排打虎牢龙套，大虫窝内宿一宵。罢罢罢，暂且忍下了，明日自有我的巧妙高！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "祢衡下"
        },
        {
          "type": "lyric",
          "speaker": "孔融",
          "mode": "西皮摇板",
          "content": "祢衡先生性太傲，险些儿项上吃一刀"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "孔融下"
        },
        {
          "type": "lyric",
          "speaker": "张辽",
          "mode": "西皮摇板",
          "content": "辞别丞相下舆道，相请列位走一遭"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "张辽下"
        },
        {
          "type": "lyric",
          "speaker": "曹操",
          "mode": "西皮摇板",
          "content": "大宴群臣文武到，杀鸡何用宰牛刀"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "曹操下"
        }
      ],
      "stats": {
        "line_count": 128,
        "lyric_ratio": 0.42,
        "stage_direction_count": 7
      }
    },
    {
      "scene_id": 3,
      "title": "",
      "characters_on_stage": [
        "祢衡"
      ],
      "segments": [
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "内白",
          "content": "走吓！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "祢衡上"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮导板",
          "content": "适才与贼来叙话"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮摇板",
          "content": "气得某家泪如麻"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "咳！正是："
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "念",
          "content": "酒逢知己千杯少，语不投机半句多。适才进得相府，与贼深施一礼，他坐在上面，安然不动，倒也罢了，反道俺的礼貌不周。又将我辱为鼓吏。明日元旦佳节，必然当着满朝文武羞辱与我。吾乃天下名士，焉肯为那贼羞辱！明日进得相府，是要赤身露体，百般叫骂于他，纵然将我斩首，也落的一个青史名标！正是："
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "念",
          "content": "明知山有虎，偏向虎山行"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮快板",
          "content": "明日进账将贼骂，拼着一死染黄沙。纵然将我头割下，落一个骂贼名儿扬天下"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "祢衡下"
        }
      ],
      "stats": {
        "line_count": 26,
        "lyric_ratio": 0.31,
        "stage_direction_count": 2
      }
    },
    {
      "scene_id": 4,
      "title": "",
      "characters_on_stage": [
        "朝官甲",
        "朝官乙",
        "朝官丙",
        "朝官丁",
        "张辽",
        "曹操",
        "旗牌",
        "祢衡"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四朝官同上"
        },
        {
          "type": "dialogue",
          "speaker": "朝官甲",
          "mode": "念",
          "content": "日观三千策"
        },
        {
          "type": "dialogue",
          "speaker": "朝官乙",
          "mode": "念",
          "content": "夜读七篇诗"
        },
        {
          "type": "dialogue",
          "speaker": "朝官丙",
          "mode": "念",
          "content": "要知今古事"
        },
        {
          "type": "dialogue",
          "speaker": "朝官丁",
          "mode": "念",
          "content": "还读五车书"
        },
        {
          "type": "dialogue",
          "speaker": "朝官甲",
          "mode": "白",
          "content": "请了"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "请了"
        },
        {
          "type": "dialogue",
          "speaker": "朝官甲",
          "mode": "白",
          "content": "丞相有帖相邀，不知为了何事？我等一同去到相府"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "请。正是："
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同念",
          "content": "五凤楼前朝金阙，相府门前拜元戎"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "门上哪为在？"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "张辽上"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "吓，列位大人"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "张将军，烦劳通禀丞相，就说我等要见"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "少站一时。有请丞相"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "曹操自下场门上"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "何事？"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "众位大人要见"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "有请"
        },
        {
          "type": "dialogue",
          "speaker": "张辽",
          "mode": "白",
          "content": "有请"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "〖吹打〗。四朝官同进"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "丞相在上，我等大礼参拜"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "老夫也有一拜"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "丞相宣诏我等，有何见？"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "今日老夫大宴群臣，请列位到此畅饮几杯"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "到此就要叨扰"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "待老夫把盏"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "摆下就是"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "〖吹打〗。二旗牌自两边分上，同摆宴"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "请"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "〖牌子〗"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "列位大人，老夫帐下，新收一名鼓吏，命他在底下擂鼓，你我畅饮三杯"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "既有此事，我等瞻仰"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "来"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "有"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "传鼓吏进帐"
        },
        {
          "type": "dialogue",
          "speaker": "旗牌",
          "mode": "白",
          "content": "传鼓吏进帐"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "内白",
          "content": "来也！"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "内西皮导板",
          "content": "谗臣当道谋汉朝"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "祢衡上"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮慢板",
          "content": "楚汉相争动枪刀。项羽无谋落圈套，九里山前韩信高。数尽失志乌江道，盖世英雄无下稍。高祖咸阳登大宝，一统山河乐唐尧。四百年来国运消，献帝皇爷坐九朝。后来出了奸曹操，上欺天子下压群僚。有心替主把贼扫，手中缺少杀人刀"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "请"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "请"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "旗牌斟酒"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮快板",
          "content": "下席坐了奸曹操，上席文武众群僚。狗奸贼传令如山倒，舍死忘生在今朝。元旦节与贼个不详兆，假装疯迷耍耍奸曹操。我把青衣来脱掉"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "请"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "请"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "旗牌斟酒"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮快板",
          "content": "破鞋褴衫摆摆摇。怒气不息往上跑"
        },
        {
          "type": "dialogue",
          "speaker": "二旗牌",
          "mode": "同白",
          "content": "呔！你这鼓吏，丞相大宴群臣，这样破衣褴衫，成何体统？"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮快板",
          "content": "帐下儿郎闹吵吵"
        },
        {
          "type": "dialogue",
          "speaker": "二旗牌",
          "mode": "同白",
          "content": "倒说我等吵闹，好笑吓，哈哈哈……"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮快板",
          "content": "列位不必哈哈笑，有一辈古人听根苗："
        },
        {
          "type": "dialogue",
          "speaker": "二旗牌",
          "mode": "同白",
          "content": "你且讲来"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮快板",
          "content": "昔日太公曾垂钓，张良拾履在荒郊。为人受得苦中苦，脱却褴衫换紫袍"
        },
        {
          "type": "dialogue",
          "speaker": "二旗牌",
          "mode": "同白",
          "content": "你焉能比得前朝的古人？"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮快板",
          "content": "你二人把话讲错了，休把猛虎当狸猫。有朝一日时运到，拔剑要斩海底蛟！"
        },
        {
          "type": "dialogue",
          "speaker": "二旗牌",
          "mode": "同白",
          "content": "青天白日，你在此做梦！"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "呀呸！"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮快板",
          "content": "休道我白日梦颠倒，登时就要上青霄。我把破衣齐脱掉"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "请"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "请"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "旗牌斟酒。祢衡脱衣"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮快板",
          "content": "赤身露体往上跑"
        },
        {
          "type": "dialogue",
          "speaker": "二旗牌",
          "mode": "同白",
          "content": "呔！丞相大宴群臣，你倒赤身露体，丞相降罪，何人承当？"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮快板",
          "content": "你丞相降罪我承招。抽身来在东廊道，看这奸贼把我怎开销？"
        },
        {
          "type": "dialogue",
          "speaker": "二旗牌",
          "mode": "同白",
          "content": "鼓吏到"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "命他擂鼓三通"
        },
        {
          "type": "dialogue",
          "speaker": "二旗牌",
          "mode": "同白",
          "content": "丞相命你擂鼓三通"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "祢衡打鼓"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "列位大人，听这鼓吏擂鼓，好似金声玉振，我等畅饮几杯，庆贺丞相，请吓！"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "请吓！"
        },
        {
          "type": "lyric",
          "speaker": "曹操",
          "mode": "西皮原板",
          "content": "擂鼓三通响如雷，文武百官饮三杯。张辽一旁牙咬碎，孔融带愧转回归。站立廊下观鼓吏"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "祢衡打鼓"
        },
        {
          "type": "lyric",
          "speaker": "曹操",
          "mode": "西皮快板",
          "content": "赤身露体廊下立。老夫暂忍心头气，再与祢衡说端的"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "祢衡"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "曹操"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "你为何叫老夫曹操？"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "你叫得我祢衡，我就叫得你曹操！"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "这也不计较于你。今日老夫大宴群臣，你赤身露体，成何体统？"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "我露父母清白之体，显得我是清洁的君子，不必你是混浊的小人！"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "老夫身居相位，何言混浊？"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "你且听道：你虽居相位，不识贤愚，贼的眼浊也；不纳忠言，贼的耳浊也；不读诗书，贼的口浊也；常怀篡逆，贼的心浊也！我乃是天下名士，你将我屈为鼓吏，羞辱与我，犹如阳货害仲尼，臧仓毁孟子。轻慢贤士，曹操吓，曹操！你真匹夫之辈也！"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮快板",
          "content": "昔日文王访吕望，亲临渭水求栋梁。臣坐君乘执辔往，为国求贤礼所当。你只望在朝中为首相，全然不知臭和香"
        },
        {
          "type": "lyric",
          "speaker": "曹操",
          "mode": "西皮快板",
          "content": "老夫兴兵谁敢挡，赫赫威名天下扬。论机谋赛过姜吕望，岂容无知小儿郎"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮摇板",
          "content": "曹操把话错来讲，无水怎把蛟龙藏？马槽怎养狮和象，犬穴焉能住凤凰？鼓打一通天地响，鼓打二通振朝纲。鼓打三通扫奸党，鼓打四通国泰康。鼓发一阵连声响"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "祢衡打鼓"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮摇板",
          "content": "管教你奸贼死无下场"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "哦"
        },
        {
          "type": "lyric",
          "speaker": "四朝官",
          "mode": "同西皮摇板",
          "content": "众人停杯望下廊，丞相为何怒一旁？"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "我与鼓吏交谈几句，故而闷坐在此"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "丞相息怒，我等上前问来"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "有劳列位大人！"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "你这鼓吏，家住哪里，姓甚名谁，一一讲的来"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "列位，"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮二六板",
          "content": "未曾开言心头恨，尊声列位听分明："
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "家住哪里？"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮二六板",
          "content": "家住山西平原郡"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "姓甚名谁？"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮二六板",
          "content": "姓祢名衡字正平"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "呀，祢先生！"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮二六板",
          "content": "腹中颇有安邦论，曾与孔融当过幕宾。他将我荐与曹奸佞，肉眼不识俺的宝和珍。我宁做忠良门下客，岂作他奸贼的帐下人！"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "你真是舌辩之徒！"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮快板",
          "content": "你道我正平是舌辩之徒，舌辩之徒有张苏。苏秦六国为首相，全凭舌尖压四座。有朝一日展昆仑手，要把奸贼一笔勾！"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "把你比作井底之蛙，能起多风多浪？"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "呀呸！"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮快板",
          "content": "贼把我比作井底蛙，井底之蛙也不差。有朝一日云雾下，要把你奸贼一把抓！"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "列位大人，他道老夫奸，我奸在何处？"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "是吓，丞相奸在何处？"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "列位，"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "张辽上"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮摇板",
          "content": "狗奸贼出巧言故意问道，尊一声众公卿细听根苗。自幼儿入学廉官卑职小，他本是夏侯子过继姓曹。到如今作高官忘了宗考"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "贼吓贼吓，"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "哽"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮摇板",
          "content": "全不怕臭名儿万古留标"
        },
        {
          "type": "lyric",
          "speaker": "张辽",
          "mode": "西皮快板",
          "content": "听他言来心头恼，辱骂丞相为哪条？三尺青锋出了鞘"
        },
        {
          "type": "lyric",
          "speaker": "四朝官",
          "mode": "同西皮摇板",
          "content": "张将军息怒慢开刀"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "张将军，休要污秽老夫的宝剑"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "狗仗人势，谅你也不敢！"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "祢衡，老夫有书信一封，命你去往荆州，顺说刘表来降。倘若刘表来降，保你官职在朝"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "呀呀呸！"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮摇板",
          "content": "要往荆州怎能够，岂肯与你作马牛？"
        },
        {
          "type": "lyric",
          "speaker": "四朝官",
          "mode": "同西皮摇板",
          "content": "丞相息怒且听候，顺说祢衡往荆州"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "有劳列位大人"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "吓，祢先生，丞相有书信一封，命你去往荆州，顺说刘表来降。你若不去，恼了丞相，将你斩首，你家中还有妻儿老小，所靠何人？必须要再思再想吓！"
        },
        {
          "type": "dialogue",
          "speaker": "祢衡",
          "mode": "白",
          "content": "哦……"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮二六板",
          "content": "列位宫卿齐来劝我，酒醒方知梦南柯。自古道责人先责己过，手摸胸膛自己揣摩。罢罢罢，暂忍我的心头火"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "祢衡穿衣"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "丞相，祢衡愿往荆州去了"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "吓，祢衡愿往荆州去了？列位大人"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "丞相"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "祢衡说老夫是奸臣，奸在何处？"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "丞相是大大的忠臣"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "笑",
          "content": "哈哈哈，老夫是大大的忠臣"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四朝官同笑"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮快板",
          "content": "事到头来没奈何。走上前来忙告错，尊声丞相听我说：你把书信交与我，顺说刘表作定夺"
        },
        {
          "type": "lyric",
          "speaker": "曹操",
          "mode": "西皮快板",
          "content": "千错万错先生错，话不投机半句多。倘若刘表归顺我，保你官职在朝阁"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮摇板",
          "content": "丞相息怒且请坐，披星戴月奔江河。顺说刘表若不妥"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "早去早回"
        },
        {
          "type": "lyric",
          "speaker": "祢衡",
          "mode": "西皮摇板",
          "content": "愿死他乡作鬼魔"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "祢衡下"
        },
        {
          "type": "dialogue",
          "speaker": "四朝官",
          "mode": "同白",
          "content": "吾等告退"
        },
        {
          "type": "dialogue",
          "speaker": "曹操",
          "mode": "白",
          "content": "老夫少送"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "众人同下"
        }
      ],
      "stats": {
        "line_count": 312,
