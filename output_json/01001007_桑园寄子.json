          "mode": "",
          "content": "邓伯道、金氏、邓元、邓方同上。"
        },
        {
          "type": "lyric",
          "speaker": "邓伯道",
          "mode": "二黄摇板",
          "content": "走青山望白云，"
        },
        {
          "type": "lyric",
          "speaker": "邓方",
          "mode": "二黄摇板",
          "content": "家乡何在？"
        },
        {
          "type": "lyric",
          "speaker": "金氏",
