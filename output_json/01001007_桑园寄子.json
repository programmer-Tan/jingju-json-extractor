  "scenes": [
    {
      "scene_id": 1,
      "title": "坟前祭奠",
      "characters_on_stage": [
        "邓伯道",
        "二家院",
        "邓元",
        "邓方",
        "四青袍"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "邓伯道上。"
        },
        {
          "type": "lyric",
          "speaker": "邓伯道",
          "mode": "引子",
          "content": "兄弟丧了命，倒叫我，好不伤心。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "念",
          "content": "人生在世几度秋，好似杨花水上浮。有朝一日狂风起，大限来时一笔勾。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二家院自两边分上。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "老汉邓伯道。兄弟伯俭，中年丧命，撇下邓方孩儿，无人教训。今当周年之期，备定祭礼，带领两个孩儿，去到坟前一祭，以表手足之情。来，"
        },
        {
          "type": "dialogue",
          "speaker": "二家院",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "有请二位少爷。"
        },
        {
          "type": "dialogue",
          "speaker": "二家院",
          "mode": "白",
          "content": "有请二位少爷。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "邓元、邓方同上。"
        },
        {
          "type": "dialogue",
          "speaker": "邓元",
          "mode": "白",
          "content": "来了。"
        },
        {
          "type": "dialogue",
          "speaker": "邓元",
          "mode": "念",
          "content": "学中习孔孟，"
        },
        {
          "type": "dialogue",
          "speaker": "邓方",
          "mode": "念",
          "content": "何日得成名。"
        },
        {
          "type": "dialogue",
          "speaker": "邓元、邓方",
          "mode": "白",
          "content": "参见（爹爹）（伯父）。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "罢了。"
        },
        {
          "type": "dialogue",
          "speaker": "邓元、邓方",
          "mode": "白",
          "content": "唤儿出来，有何训教？"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "今当你爹爹，周年之期，备定祭礼，带领你弟兄二人，去到坟前一祭。"
        },
        {
          "type": "dialogue",
          "speaker": "邓元、邓方",
          "mode": "白",
          "content": "遵命。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "来，"
        },
        {
          "type": "dialogue",
          "speaker": "二家院",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "吩咐祭礼抬上。"
        },
        {
          "type": "dialogue",
          "speaker": "二家院",
          "mode": "白",
          "content": "祭礼抬上。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四青袍抬祭礼自两边分上。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "嗳，兄弟吓！"
        },
        {
          "type": "lyric",
          "speaker": "邓伯道",
          "mode": "二黄慢板",
          "content": "叹兄弟遭不幸中年丧命，撇下了年幼儿好不伤情。眼望着孤坟台心痛难忍，见坎台不见弟刀刺我心。"
        },
        {
          "type": "dialogue",
          "speaker": "二家院",
          "mode": "白",
          "content": "来此坟台。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "祭礼摆下。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "二家院同摆祭礼，同下，四青袍同下。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "叫头",
          "content": "兄弟吓，伯俭！"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "今当你周年之期，备定祭礼，带领两个孩儿，前来祭奠与你，以表你我手足之情。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "三叫头",
          "content": "兄弟！伯俭！兄弟吓！"
        },
        {
          "type": "lyric",
          "speaker": "邓伯道",
          "mode": "二黄导板",
          "content": "见坟台不由人珠泪滚滚，"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "三叫头",
          "content": "兄弟，伯俭，兄弟吓！"
        },
        {
          "type": "lyric",
          "speaker": "邓伯道",
          "mode": "回龙",
          "content": "到叫我年迈兄好不伤情！"
        },
        {
          "type": "lyric",
          "speaker": "邓伯道",
          "mode": "二黄原板",
          "content": "你在世弟兄们一家欢庆，共商量做计较家业同兴。好端端得疾病一旦丧命，一旦丧命，兄弟吓！似黄土埋却了无价的宝珍。"
        },
        {
          "type": "dialogue",
          "speaker": "邓元",
          "mode": "白",
          "content": "叔父！"
        },
        {
          "type": "lyric",
          "speaker": "邓元",
          "mode": "二黄原板",
          "content": "见爹爹只哭得昏迷不醒，叫一声我叔父细听分明：你死在九泉下好不安静，撇下了我兄弟依靠何人？"
        },
        {
          "type": "dialogue",
          "speaker": "邓方",
          "mode": "三叫头",
          "content": "爹爹，我父，爹爹吓！"
        },
        {
          "type": "lyric",
          "speaker": "邓方",
          "mode": "二黄导板",
          "content": "在坟前不由我珠泪难忍，"
        },
        {
          "type": "dialogue",
          "speaker": "邓方",
          "mode": "三叫头",
          "content": "爹爹，我父，爹爹吓！"
        },
        {
          "type": "lyric",
          "speaker": "邓方",
          "mode": "二黄原板",
          "content": "见坟台不见儿疼儿爹尊。你死在九泉下好不安静，撇下了我母子依靠何人？"
        },
        {
          "type": "dialogue",
          "speaker": "邓元",
          "mode": "白",
          "content": "咳，爹爹，我要我的叔父。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "哦，儿要儿的叔父么？"
        },
        {
          "type": "dialogue",
          "speaker": "邓元",
          "mode": "白",
          "content": "正是。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "那里面就是儿的叔父，你去叫吓！"
        },
        {
          "type": "dialogue",
          "speaker": "邓元",
          "mode": "白",
          "content": "叔父吓，叔父，侄儿在此叫你！你是怎的不言，怎的不语？"
        },
        {
          "type": "dialogue",
          "speaker": "邓方",
          "mode": "白",
          "content": "嗳，伯父，我要我的爹爹。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "哦，儿要儿的爹爹么？"
        },
        {
          "type": "dialogue",
          "speaker": "邓方",
          "mode": "白",
          "content": "正是。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "那里面就是儿的爹爹，你去叫他出来吓！"
        },
        {
          "type": "dialogue",
          "speaker": "邓方",
          "mode": "白",
          "content": "爹爹吓，爹爹，孩儿在此叫你！你是怎的不言，怎的不语？"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "兄弟吓，伯俭，这两个孩儿，在此叫你，你是怎的不言，怎的不语？莫非你聋了，你哑了，你你你睡死了？"
        },
        {
          "type": "lyric",
          "speaker": "邓伯道",
          "mode": "二黄摇板",
          "content": "这一个要叔父心痛难忍，那一个要爹爹刀刺我心。望贤弟在阴曹慢慢相等，等候了你的兄一路同行。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四青袍、二家院同上。"
        },
        {
          "type": "dialogue",
          "speaker": "二家院",
          "mode": "白",
          "content": "启禀员外：大事不好了！"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "何事惊慌？"
        },
        {
          "type": "dialogue",
          "speaker": "二家院",
          "mode": "白",
          "content": "今有黑水国造反，逢州夺州，遇县抢县，看看杀到我庄来了！"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "哎呀，这才是福不双降，祸不单行！儿吓，犹恐你母亲在家悬望，我们快快回去吧！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "众人同下。"
        }
      ],
      "stats": {
        "line_count": 68,
        "lyric_ratio": 0.32,
        "stage_direction_count": 6
      }
    },
    {
      "scene_id": 2,
      "title": "议逃潼关",
      "characters_on_stage": [
        "金氏",
        "邓伯道",
        "邓元",
        "邓方",
        "二家院",
        "四青袍",
        "众家丁"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "金氏上。"
        },
        {
          "type": "lyric",
          "speaker": "金氏",
          "mode": "二黄摇板",
          "content": "遭不幸我官人一旦丧命，撇下奴每日里独守孤灯。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四青袍、二家院、邓元、邓方、邓伯道同上。"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "白",
          "content": "大伯伯回来了。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "弟妇，大事不好了！"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "白",
          "content": "何事惊慌？"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "今有黑水国造反，逢州夺州，遇县抢县，看看杀到我庄来了！"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "白",
          "content": "不好了！"
        },
        {
          "type": "lyric",
          "speaker": "金氏",
          "mode": "二黄摇板",
          "content": "听说是黑水国兴兵犯境，眼见得一家人四下离分。"
        },
        {
          "type": "dialogue",
          "speaker": "金氏",
          "mode": "白",
          "content": "大伯伯，何不收拾收拾，逃往潼关我兄弟那里，安身才是。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "好，后面收拾收拾。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "金氏、邓元、邓方同下。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "叫头",
          "content": "众家丁！"
        },
        {
          "type": "dialogue",
          "speaker": "二家院",
          "mode": "白",
          "content": "有。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "今有黑水国造反，看看杀到我庄。我带领二东人，前去逃命。将这万贯家财，付与你等掌管。倘若贼兵不到此地，我回来将这家财，与你等平分一半；倘若贼兵到此，你们各自逃命去罢。"
        },
        {
          "type": "dialogue",
          "speaker": "二家院",
          "mode": "白",
          "content": "哦呵，员外，将这万贯家财，交与我等执掌，料然无事。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "好，真乃忠义之士。改扮起来。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "邓伯道换衣衾。金氏、邓元、邓方同上。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "众家丁，你等请上，受我全家一拜！"
        },
        {
          "type": "lyric",
          "speaker": "邓伯道",
          "mode": "二黄摇板",
          "content": "一家人跪草堂珠泪滚滚，尊一声众家丁细听分明：都只为黑水国兴兵犯境，我带着二东人前去逃生。但愿得他贼兵不到此境，我回来将家财与尔等平分。急忙忙说不尽衷肠话论，"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "三叫头",
          "content": "家丁！义仆！哎吓！"
        },
        {
          "type": "dialogue",
          "speaker": "众家丁",
          "mode": "白",
          "content": "员外吓！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "邓伯道、金氏、邓元、邓方同下。"
        },
        {
          "type": "dialogue",
          "speaker": "二家院",
          "mode": "白",
          "content": "嗳，列位，员外东人他们俱已去了，倘若贼兵到此，你我如何是好？"
        },
        {
          "type": "dialogue",
          "speaker": "众家丁",
          "mode": "白",
          "content": "你我吃的饱饱的，关上了门，尽等窍辫子。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "众人同下。"
        }
      ],
      "stats": {
        "line_count": 32,
        "lyric_ratio": 0.28,
        "stage_direction_count": 5
      }
    },
    {
      "scene_id": 3,
      "title": "番兵犯境",
      "characters_on_stage": [
        "石勒",
        "四龙套",
        "番兵"
      ],
      "segments": [
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "四龙套引番王同上。"
        },
        {
          "type": "dialogue",
          "speaker": "石勒",
          "mode": "白",
          "content": "某，石勒。某家一路而来，斩关夺寨。前面已是文水县。巴都鲁！"
        },
        {
          "type": "dialogue",
          "speaker": "众人",
          "mode": "白",
          "content": "（同允）"
        },
        {
          "type": "dialogue",
          "speaker": "石勒",
          "mode": "白",
          "content": "杀！"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "众人同下。"
        }
      ],
      "stats": {
        "line_count": 4,
        "lyric_ratio": 0,
        "stage_direction_count": 2
      }
    },
    {
      "scene_id": 4,
      "title": "逃难遇兵",
      "characters_on_stage": [
        "邓伯道",
        "金氏",
        "邓元",
        "邓方",
        "众百姓",
        "番兵"
      ],
      "segments": [
        {
          "type": "dialogue",
          "speaker": "邓元、邓方",
          "mode": "内白",
          "content": "走吓！"
