        {
          "type": "lyric",
          "speaker": "邓伯道",
          "mode": "二黄快三眼",
          "content": "山又高水又深无计何奈，"
        },
        {
          "type": "lyric",
          "speaker": "金氏",
          "mode": "二黄慢板",
          "content": "道有草石有苔寸步难挨。"
        },
        {
          "type": "lyric",
          "speaker": "邓伯道",
          "mode": "二黄原板",
