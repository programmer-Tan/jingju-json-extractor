        {
          "type": "dialogue",
          "speaker": "邓元、邓方",
          "mode": "白",
          "content": "正是，腹中饥饿。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "你来看，那个上去，采些桑棘下来，也好充饥。"
        },
        {
          "type": "dialogue",
          "speaker": "邓元、邓方",
          "mode": "白",
          "content": "我去，我去。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "你年小。"
        },
        {
          "type": "dialogue",
          "speaker": "邓元",
          "mode": "白",
          "content": "待孩儿上去。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
          "content": "是吓，原要你上去。"
        },
        {
          "type": "stage_direction",
          "speaker": null,
          "mode": "",
          "content": "邓元上树。"
        },
        {
          "type": "dialogue",
          "speaker": "邓伯道",
          "mode": "白",
